{% comment %}
  QuickBee — KapadaWash Collection Template v2
  Text-focused, Categorized, Mobile-First
{% endcomment %}

<style>
/* ═══════════════════════════════════════════════
   LAUNDRY BOOKING v2 — Categorized & Text Focused
   QuickBee × KapadaWash
═══════════════════════════════════════════════ */
:root {
  --lb-gold:          #F4B400;
  --lb-gold-dim:      rgba(244,180,0,0.1);
  --lb-bg:            #f8f9fa;
  --lb-card:          #ffffff;
  --lb-border:        #eef0f2;
  --lb-text:          #1a1a1a;
  --lb-muted:         #6c757d;
  --lb-radius:        12px;
  --lb-success:       #28a745;
}
[data-theme="dark"] {
  --lb-bg:            #0f0f0f;
  --lb-card:          #1a1a1a;
  --lb-border:        #2a2a2a;
  --lb-text:          #f8f9fa;
  --lb-muted:         #adb5bd;
}

.lb-wrap {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--lb-bg);
  min-height: 100vh;
  padding-bottom: calc(160px + env(safe-area-inset-bottom));
  color: var(--lb-text);
}
.lb-wrap * { box-sizing: border-box; margin: 0; padding: 0; }

/* ── HERO ── */
.lb-hero {
  background: #111;
  padding: 40px 20px;
  text-align: left;
  border-bottom: 1px solid var(--lb-border);
}
.lb-hero-badge {
  color: var(--lb-gold); font-size: 10px; font-weight: 800;
  letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;
  display: block;
}
.lb-hero-title {
  font-size: 28px; font-weight: 900; color: #fff;
  line-height: 1.1; margin-bottom: 8px;
}
.lb-hero-sub {
  font-size: 14px; color: rgba(255,255,255,0.6);
  line-height: 1.4;
}

/* ── CATEGORY HEADINGS ── */
.lb-cat-header {
  padding: 24px 16px 12px;
  font-size: 16px; font-weight: 800; color: var(--lb-text);
  display: flex; align-items: center; gap: 10px;
  background: var(--lb-bg);
  position: sticky; top: 0; z-index: 10;
}
.lb-cat-header::after {
  content: ''; flex: 1; height: 1px; background: var(--lb-border);
}

/* ── TEXT FOCUSED CARDS ── */
.lb-services-list {
  padding: 0 12px;
  display: flex; flex-direction: column; gap: 8px;
}
.lb-service-card {
  display: flex; align-items: flex-start; gap: 12px;
  background: var(--lb-card);
  border: 1px solid var(--lb-border);
  border-radius: var(--lb-radius);
  padding: 14px;
  cursor: pointer; transition: all 0.2s ease;
  user-select: none; -webkit-tap-highlight-color: transparent;
}
.lb-service-card.selected {
  border-color: var(--lb-gold);
  background: var(--lb-gold-dim);
}

.lb-svc-main { flex: 1; min-width: 0; }
.lb-svc-name {
  font-size: 15px; font-weight: 700; color: var(--lb-text);
  margin-bottom: 2px;
}
.lb-svc-desc {
  font-size: 12px; color: var(--lb-muted);
  line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.lb-svc-price-row {
  display: flex; align-items: center; gap: 6px; margin-top: 6px;
}
.lb-svc-price {
  font-size: 14px; font-weight: 800; color: var(--lb-gold);
}
.lb-svc-unit {
  font-size: 11px; color: var(--lb-muted); font-weight: 500;
}

/* ── QTY CONTROLS ── */
.lb-svc-actions {
  display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
  min-width: 90px;
}
.lb-add-icon-btn {
  width: 32px; height: 32px; border-radius: 8px;
  background: var(--lb-gold); color: #000;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; font-weight: 300; border: none;
}
.lb-card-qty {
  display: none; align-items: center;
  background: var(--lb-card); border: 1.5px solid var(--lb-gold);
  border-radius: 8px; overflow: hidden;
}
.lb-service-card.selected .lb-card-qty { display: flex; }
.lb-service-card.selected .lb-add-icon-btn { display: none; }

.lb-qty-btn {
  width: 30px; height: 32px; background: transparent; border: none;
  font-size: 18px; color: var(--lb-gold); cursor: pointer;
}
.lb-qty-val {
  min-width: 24px; text-align: center; font-size: 14px; font-weight: 800;
}

/* ── LIVE SUMMARY (Simplified) ── */
.lb-summary-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--lb-card); border-top: 1px solid var(--lb-border);
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
}
.lb-summary-info {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
}
.lb-summary-total {
  display: flex; flex-direction: column;
}
.lb-summary-label { font-size: 11px; color: var(--lb-muted); text-transform: uppercase; font-weight: 700; }
.lb-summary-val { font-size: 20px; font-weight: 900; color: var(--lb-text); }

.lb-confirm-btn {
  width: 100%; height: 50px;
  background: var(--lb-gold); color: #000;
  border: none; border-radius: 10px;
  font-size: 16px; font-weight: 800;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.lb-confirm-btn:disabled { background: var(--lb-border); color: var(--lb-muted); }

/* ── CATEGORY NAV (Mobile Scrolling) ── */
.lb-cat-nav {
  display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px;
  background: var(--lb-card); border-bottom: 1px solid var(--lb-border);
  scrollbar-width: none;
}
.lb-cat-nav::-webkit-scrollbar { display: none; }
.lb-cat-pill {
  flex-shrink: 0; padding: 6px 14px; border-radius: 20px;
  background: var(--lb-bg); border: 1px solid var(--lb-border);
  font-size: 12px; font-weight: 700; color: var(--lb-muted);
}
.lb-cat-pill.active { background: var(--lb-gold); color: #000; border-color: var(--lb-gold); }

/* ── SUCCESS OVERLAY ── */
.lb-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.8);
  display: none; align-items: center; justify-content: center; z-index: 1000;
  backdrop-filter: blur(4px);
}
.lb-overlay.show { display: flex; }
.lb-overlay-card {
  background: var(--lb-card); padding: 32px; border-radius: 20px; text-align: center;
  max-width: 80%;
}
.lb-overlay-icon { font-size: 48px; margin-bottom: 12px; display: block; }
</style>

<div class="lb-wrap">
  <!-- HERO -->
  <header class="lb-hero">
    <span class="lb-hero-badge">KapadaWash Premium</span>
    <h1 class="lb-hero-title">{{ collection.title }}</h1>
    <p class="lb-hero-sub">{{ collection.description | strip_html | default: 'Select laundry services below to build your order.' }}</p>
  </header>

  <!-- CATEGORY NAV -->
  {%- assign types = collection.products | map: 'type' | uniq -%}
  <div class="lb-cat-nav">
    {% for type in types %}
      {% if type != blank %}
        <a href="#cat-{{ type | handle }}" class="lb-cat-pill">{{ type }}</a>
      {% endif %}
    {% endfor %}
  </div>

  <!-- PRODUCTS BY CATEGORY -->
  <div class="lb-content">
    {% for type in types %}
      {% if type != blank %}
        <section id="cat-{{ type | handle }}">
          <h2 class="lb-cat-header">{{ type }}</h2>
          <div class="lb-services-list">
            {% for product in collection.products %}
              {% if product.type == type %}
                {%- assign unit = 'pcs' -%}
                {%- for tag in product.tags -%}
                  {%- if tag contains 'unit:' -%}{%- assign unit = tag | split: ':' | last -%}{%- endif -%}
                {%- endfor -%}

                <div class="lb-service-card" 
                     data-id="{{ product.first_available_variant.id }}"
                     data-title="{{ product.title | escape }}"
                     data-price="{{ product.price | divided_by: 100 }}"
                     data-unit="{{ unit }}">
                  <div class="lb-svc-main">
                    <h3 class="lb-svc-name">{{ product.title }}</h3>
                    <p class="lb-svc-desc">{{ product.description | strip_html | truncate: 100 }}</p>
                    <div class="lb-svc-price-row">
                      <span class="lb-svc-price">Rs {{ product.price | divided_by: 100 }}</span>
                      <span class="lb-svc-unit">/ {{ unit }}</span>
                    </div>
                  </div>
                  <div class="lb-svc-actions">
                    <button class="lb-add-icon-btn">+</button>
                    <div class="lb-card-qty">
                      <button class="lb-qty-btn minus">−</button>
                      <span class="lb-qty-val">1</span>
                      <button class="lb-qty-btn plus">+</button>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>

  <!-- SUMMARY BAR -->
  <div class="lb-summary-bar">
    <div class="lb-summary-info">
      <div class="lb-summary-total">
        <span class="lb-summary-label">Estimated Total</span>
        <span class="lb-summary-val" id="lb-total-display">Rs 0</span>
      </div>
      <div class="lb-summary-count" id="lb-count-display" style="font-size: 12px; font-weight: 700;">0 Services</div>
    </div>
    <button class="lb-confirm-btn" id="lb-confirm" disabled>
      <span>🐝</span> Confirm Order
    </button>
  </div>
</div>

<div class="lb-overlay" id="lb-success">
  <div class="lb-overlay-card">
    <span class="lb-overlay-icon">✅</span>
    <h2 style="margin-bottom:8px;">Order Building...</h2>
    <p style="font-size:14px; color:var(--lb-muted);">Sending items to checkout</p>
  </div>
</div>

<script>
(function() {
  const selections = {};
  const confirmBtn = document.getElementById('lb-confirm');
  const totalDisplay = document.getElementById('lb-total-display');
  const countDisplay = document.getElementById('lb-count-display');

  function updateGlobalUI() {
    let total = 0;
    let count = 0;
    Object.keys(selections).forEach(id => {
      total += selections[id].price * selections[id].qty;
      count++;
    });

    totalDisplay.textContent = 'Rs ' + total;
    countDisplay.textContent = count + (count === 1 ? ' Service' : ' Services');
    confirmBtn.disabled = count === 0;
  }

  document.querySelectorAll('.lb-service-card').forEach(card => {
    const id = card.dataset.id;
    const price = parseInt(card.dataset.price);
    const title = card.dataset.title;
    const unit = card.dataset.unit;
    const qtyVal = card.querySelector('.lb-qty-val');

    card.addEventListener('click', (e) => {
      if (e.target.closest('.lb-card-qty')) return;
      if (!selections[id]) {
        selections[id] = { id, title, price, unit, qty: 1 };
        card.classList.add('selected');
        updateGlobalUI();
      }
    });

    card.querySelector('.plus').addEventListener('click', (e) => {
      e.stopPropagation();
      selections[id].qty++;
      qtyVal.textContent = selections[id].qty;
      updateGlobalUI();
    });

    card.querySelector('.minus').addEventListener('click', (e) => {
      e.stopPropagation();
      if (selections[id].qty > 1) {
        selections[id].qty--;
        qtyVal.textContent = selections[id].qty;
      } else {
        delete selections[id];
        card.classList.remove('selected');
      }
      updateGlobalUI();
    });
  });

  confirmBtn.addEventListener('click', () => {
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Processing...';
    document.getElementById('lb-success').classList.add('show');

    const items = Object.values(selections).map(s => ({
      id: s.id,
      quantity: s.qty,
      properties: { 'Service': s.title, 'Unit': s.unit }
    }));

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items })
    })
    .then(res => res.json())
    .then(() => {
      window.location.href = '/pages/payment';
    })
    .catch(err => {
      alert('Error adding to cart. Please try again.');
      confirmBtn.disabled = false;
      document.getElementById('lb-success').classList.remove('show');
    });
  });

  // Smooth scroll for cat nav
  document.querySelectorAll('.lb-cat-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = pill.getAttribute('href').substring(1);
      const target = document.getElementById(targetId);
      if (target) {
        window.scrollTo({
          top: target.offsetTop - 60,
          behavior: 'smooth'
        });
      }
      document.querySelectorAll('.lb-cat-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "KapadaWash Categorized",
  "settings": []
}
{% endschema %}

