{% comment %}
  QuickBee — KapadaWash Collection Template v1
  Derived from product-laundry.liquid
{% endcomment %}

<style>
/* ═══════════════════════════════════════════════
   LAUNDRY BOOKING v2 — Multi-Select + Live Summary
   QuickBee × KapadaWash (Collection Version)
═══════════════════════════════════════════════ */
:root {
  --lb-red:           #C41E3A;
  --lb-red-dark:      #9b1226;
  --lb-gold:          #F4B400;
  --lb-gold-dim:      rgba(244,180,0,0.12);
  --lb-bg:            #f4f4f4;
  --lb-card:          #ffffff;
  --lb-border:        #e8e8e8;
  --lb-text:          #0d0d0d;
  --lb-muted:         #777;
  --lb-radius:        16px;
  --lb-inp-bg:        #ffffff;
  --lb-inp-border:    #d0d0d0;
  --lb-inp-focus-bg:  #ffffff;
  --lb-placeholder:   #aaaaaa;
}
[data-theme="dark"] {
  --lb-bg:            #0a0a0a;
  --lb-card:          #141414;
  --lb-border:        #222;
  --lb-text:          #f0f0f0;
  --lb-muted:         #555;
  --lb-inp-bg:        #1c1c1c;
  --lb-inp-border:    #333;
  --lb-inp-focus-bg:  #222;
  --lb-placeholder:   #555;
}

.lb-wrap {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--lb-bg);
  min-height: 100vh;
  padding-bottom: calc(145px + env(safe-area-inset-bottom));
  -webkit-tap-highlight-color: transparent;
  color: var(--lb-text);
}
.lb-wrap *, .lb-wrap *::before, .lb-wrap *::after {
  box-sizing: border-box; margin: 0; padding: 0;
}

/* ── HERO ── */
.lb-hero {
  background: linear-gradient(145deg, #0d0d0d 0%, #141414 55%, #1a1000 100%);
  padding: 36px 20px 52px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.lb-hero::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 90% 70% at 50% 120%, rgba(244,180,0,0.22) 0%, transparent 65%);
  pointer-events: none;
}
.lb-hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--lb-gold-dim); border: 1px solid rgba(244,180,0,0.3);
  color: var(--lb-gold); font-size: 11px; font-weight: 700;
  letter-spacing: 0.8px; text-transform: uppercase;
  padding: 5px 14px; border-radius: 20px; margin-bottom: 16px;
  position: relative; z-index: 1;
}
.lb-hero-icon {
  font-size: 58px; display: block; margin-bottom: 12px;
  position: relative; z-index: 1;
  animation: lb-float 3.5s ease-in-out infinite;
}
@keyframes lb-float {
  0%,100% { transform: translateY(0) rotate(-4deg); }
  50%      { transform: translateY(-8px) rotate(4deg); }
}
.lb-hero-title {
  font-size: 26px; font-weight: 900; color: #fff;
  line-height: 1.15; letter-spacing: -0.5px;
  position: relative; z-index: 1; margin-bottom: 8px;
}
.lb-hero-title span { color: var(--lb-gold); }
.lb-hero-sub {
  font-size: 13px; color: rgba(255,255,255,0.55);
  position: relative; z-index: 1; line-height: 1.5;
}

/* ── TRUST PILLS ── */
.lb-trust-row {
  display: flex; gap: 8px; overflow-x: auto;
  padding: 14px 16px; scrollbar-width: none;
}
.lb-trust-row::-webkit-scrollbar { display: none; }
.lb-trust-pill {
  flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px;
  background: var(--lb-card); border: 1px solid var(--lb-border);
  border-radius: 20px; padding: 6px 12px; font-size: 11px;
  font-weight: 600; color: var(--lb-text); white-space: nowrap;
}

/* ── SECTION LABEL ── */
.lb-section { padding: 0 16px; margin-bottom: 16px; }
.lb-section-title {
  font-size: 13px; font-weight: 800; color: var(--lb-muted);
  text-transform: uppercase; letter-spacing: 0.7px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 6px;
}
.lb-section-title::after {
  content: ''; flex: 1; height: 1px; background: var(--lb-border);
}

/* ── SERVICE CARDS ── */
.lb-services-grid {
  display: flex; flex-direction: column; gap: 10px;
}
.lb-service-card {
  display: flex; align-items: center; gap: 12px;
  background: var(--lb-card); border: 2px solid var(--lb-border);
  border-radius: var(--lb-radius); padding: 12px 14px;
  cursor: pointer; transition: border-color 0.18s ease, transform 0.15s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.18s ease;
  -webkit-tap-highlight-color: transparent; user-select: none;
  position: relative; overflow: hidden;
}
.lb-service-card::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(244,180,0,0) 0%, rgba(244,180,0,0.04) 100%);
  opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
}
.lb-service-card:active { transform: scale(0.97); }
.lb-service-card.selected {
  border-color: var(--lb-gold);
  box-shadow: 0 0 0 3px rgba(244,180,0,0.15), 0 4px 16px rgba(0,0,0,0.1);
}
.lb-service-card.selected::before { opacity: 1; }
[data-theme="dark"] .lb-service-card.selected {
  box-shadow: 0 0 0 3px rgba(244,180,0,0.2), 0 4px 20px rgba(0,0,0,0.5);
}
.lb-service-card.selected .lb-svc-icon-wrap {
  background: var(--lb-gold); color: #000;
}
.lb-service-card.error-flash {
  animation: lb-error-flash 0.5s ease;
}
@keyframes lb-error-flash {
  0%,100% { border-color: var(--lb-border); }
  25%,75%  { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.2); }
}

.lb-svc-icon-wrap {
  width: 46px; height: 46px; background: var(--lb-gold-dim);
  border-radius: 13px; display: flex; align-items: center;
  justify-content: center; font-size: 22px; flex-shrink: 0;
  transition: background 0.2s, color 0.2s;
}
.lb-svc-info { flex: 1; min-width: 0; }
.lb-svc-name {
  font-size: 14px; font-weight: 800; color: var(--lb-text);
  margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lb-svc-meta {
  font-size: 11px; color: var(--lb-muted);
  display: flex; align-items: center; gap: 6px;
}
.lb-svc-unit {
  background: var(--lb-gold-dim); color: var(--lb-gold);
  padding: 2px 7px; border-radius: 8px;
  font-weight: 700; font-size: 10px;
}

/* ── Right side of card (price + add/qty) ── */
.lb-svc-right {
  display: flex; flex-direction: column;
  align-items: flex-end; gap: 6px; flex-shrink: 0;
}
.lb-svc-price-line {
  font-size: 15px; font-weight: 900; color: var(--lb-text);
  line-height: 1; text-align: right;
}
.lb-svc-price-unit {
  font-size: 10px; color: var(--lb-muted); font-weight: 500;
}

/* ── ADD button (shown when unselected) ── */
.lb-svc-add-btn {
  width: 34px; height: 34px;
  background: var(--lb-gold); color: #000;
  border: none; border-radius: 50%;
  font-size: 22px; font-weight: 300; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), background 0.15s;
  flex-shrink: 0;
}
.lb-svc-add-btn:active { transform: scale(0.9); }
.lb-service-card.selected .lb-svc-add-btn { display: none; }

/* ── Inline qty stepper (shown when selected) ── */
.lb-card-qty {
  display: none; /* hidden by default */
  align-items: center;
  background: rgba(244,180,0,0.1);
  border: 1.5px solid rgba(244,180,0,0.35);
  border-radius: 12px;
  overflow: hidden;
}
.lb-service-card.selected .lb-card-qty { display: flex; }

.lb-card-qty-btn {
  width: 34px; height: 34px; background: transparent; border: none;
  font-size: 20px; font-weight: 400; color: #c68a00;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: background 0.15s;
  touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  flex-shrink: 0;
}
[data-theme="dark"] .lb-card-qty-btn { color: var(--lb-gold); }
.lb-card-qty-btn:active { background: rgba(244,180,0,0.2); }
.lb-card-qty-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.lb-card-qty-val {
  min-width: 28px; text-align: center;
  font-size: 15px; font-weight: 900; color: var(--lb-text);
  line-height: 34px; user-select: none;
  border-left: 1px solid rgba(244,180,0,0.3);
  border-right: 1px solid rgba(244,180,0,0.3);
}

/* Selected price shows line total */
.lb-service-card.selected .lb-svc-price-line {
  color: var(--lb-gold);
}

/* ── LIVE ORDER SUMMARY ── */
.lb-live-summary {
  margin: 0 16px 4px;
  border-radius: var(--lb-radius);
  overflow: hidden;
  border: 1.5px solid rgba(34,197,94,0.35);
  background: var(--lb-card);
  animation: lb-co-in 0.35s cubic-bezier(0.4,0,0.2,1) both;
  transition: all 0.25s ease;
}
@keyframes lb-co-in {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Header row */
.lb-ls-header {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px;
  background: rgba(34,197,94,0.07);
  border-bottom: 1px solid rgba(34,197,94,0.2);
}
.lb-ls-dot {
  width: 8px; height: 8px; background: #22c55e; border-radius: 50%;
  flex-shrink: 0; animation: lb-co-pulse 2s ease-in-out infinite;
}
@keyframes lb-co-pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
  50%      { box-shadow: 0 0 0 5px rgba(34,197,94,0); }
}
.lb-ls-title {
  font-size: 12px; font-weight: 800; color: #16a34a;
  text-transform: uppercase; letter-spacing: 0.5px; flex: 1;
}
[data-theme="dark"] .lb-ls-title { color: #4ade80; }
.lb-ls-count {
  font-size: 11px; font-weight: 700;
  background: rgba(34,197,94,0.15); color: #16a34a;
  padding: 2px 8px; border-radius: 10px;
}
[data-theme="dark"] .lb-ls-count { color: #4ade80; background: rgba(34,197,94,0.1); }

/* Empty state */
.lb-ls-empty {
  padding: 16px 14px;
  font-size: 13px; color: var(--lb-muted);
  text-align: center; line-height: 1.5;
}

/* Item rows */
.lb-ls-items { padding: 2px 0; }
.lb-ls-item {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 14px;
  border-bottom: 1px solid var(--lb-border);
  animation: lb-item-in 0.25s cubic-bezier(0.4,0,0.2,1) both;
  transition: opacity 0.2s, transform 0.2s;
}
@keyframes lb-item-in {
  from { opacity: 0; transform: translateX(-8px); }
  to   { opacity: 1; transform: translateX(0); }
}
.lb-ls-item:last-child { border-bottom: none; }
.lb-ls-item-icon { font-size: 18px; flex-shrink: 0; }
.lb-ls-item-name {
  flex: 1; font-size: 13px; font-weight: 700; color: var(--lb-text);
}
.lb-ls-item-qty {
  font-size: 11px; color: var(--lb-muted); font-weight: 500;
}
.lb-ls-item-price {
  font-size: 14px; font-weight: 900; color: var(--lb-text); text-align: right;
}
.lb-ls-item-remove {
  background: none; border: none; cursor: pointer;
  color: #ef4444; font-size: 14px; padding: 2px 4px;
  opacity: 0.6; transition: opacity 0.15s;
  flex-shrink: 0;
}
.lb-ls-item-remove:hover { opacity: 1; }

/* Express + Total rows */
.lb-ls-express-row {
  display: none; padding: 8px 14px;
  border-top: 1px solid var(--lb-border);
}
.lb-ls-express-row.show {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 12px; color: #f97316; font-weight: 600;
}
.lb-ls-total-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 14px;
  background: var(--lb-gold-dim);
  border-top: 1.5px solid rgba(244,180,0,0.25);
}
.lb-ls-total-label {
  font-size: 13px; font-weight: 800; color: var(--lb-text);
}
.lb-ls-total-price {
  font-size: 22px; font-weight: 900; color: var(--lb-text);
  letter-spacing: -0.5px;
}

/* ── BUTTON RIPPLE ── */
.lb-ripple {
  position: absolute;
  width: 12px; height: 12px;
  background: rgba(255,255,255,0.45);
  border-radius: 50%;
  transform: translate(-50%, -50%) scale(0);
  animation: lb-ripple-expand 0.55s ease-out forwards;
  pointer-events: none;
}
@keyframes lb-ripple-expand {
  to { transform: translate(-50%, -50%) scale(22); opacity: 0; }
}

/* ── CONFIRM SUCCESS OVERLAY ── */
.lb-success-overlay {
  position: fixed; inset: 0; z-index: 99999;
  background: rgba(0,0,0,0);
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
  transition: background 0.38s ease, backdrop-filter 0.38s ease;
}
.lb-success-overlay.show {
  background: rgba(0,0,0,0.6);
  pointer-events: all;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.lb-success-card {
  background: #fff;
  border-radius: 28px;
  padding: 40px 28px 32px;
  text-align: center;
  max-width: 292px; width: 88%;
  transform: scale(0.72) translateY(28px);
  opacity: 0;
  transition: transform 0.48s cubic-bezier(0.34,1.56,0.64,1) 0.08s,
              opacity 0.3s ease 0.08s;
  box-shadow: 0 28px 72px rgba(0,0,0,0.35);
}
[data-theme="dark"] .lb-success-card {
  background: #141414;
  border: 1px solid #2a2a2a;
}
.lb-success-overlay.show .lb-success-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}
.lb-success-bee {
  font-size: 70px; display: block; line-height: 1;
  transform: scale(0) rotate(-15deg);
  transition: transform 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.25s;
}
.lb-success-overlay.show .lb-success-bee {
  transform: scale(1) rotate(0deg);
}
.lb-success-rings {
  position: relative; display: inline-block;
  margin-bottom: 4px;
}
.lb-success-rings::before, .lb-success-rings::after {
  content: '';
  position: absolute; inset: -8px;
  border-radius: 50%; border: 2px solid rgba(34,197,94,0.3);
  animation: none;
}
.lb-success-overlay.show .lb-success-rings::before {
  animation: lb-ring-expand 1.4s ease-out 0.5s infinite;
}
.lb-success-overlay.show .lb-success-rings::after {
  animation: lb-ring-expand 1.4s ease-out 0.8s infinite;
}
@keyframes lb-ring-expand {
  0%   { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(2.2); opacity: 0; }
}
.lb-success-title {
  font-size: 22px; font-weight: 900;
  color: #0d0d0d; margin: 16px 0 6px; letter-spacing: -0.4px;
  opacity: 0; transform: translateY(8px);
  transition: opacity 0.35s ease 0.42s, transform 0.4s ease 0.42s;
}
[data-theme="dark"] .lb-success-title { color: #f0f0f0; }
.lb-success-overlay.show .lb-success-title {
  opacity: 1; transform: translateY(0);
}
.lb-success-sub {
  font-size: 13px; color: #777; margin-bottom: 22px;
  font-weight: 500;
  opacity: 0;
  transition: opacity 0.35s ease 0.52s;
}
.lb-success-overlay.show .lb-success-sub { opacity: 1; }
.lb-success-bar-wrap {
  height: 5px; background: #f0f0f0; border-radius: 3px; overflow: hidden;
}
[data-theme="dark"] .lb-success-bar-wrap { background: #222; }
.lb-success-bar {
  height: 100%; width: 0%;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  border-radius: 3px;
  transition: width 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.45s;
}

/* ── EXPRESS TOGGLE ── */
.lb-express-box {
  background: var(--lb-card); border: 1.5px solid var(--lb-border);
  border-radius: var(--lb-radius); padding: 14px 16px;
  display: flex; align-items: center; gap: 14px;
  cursor: pointer; transition: border-color 0.2s ease;
  -webkit-tap-highlight-color: transparent; user-select: none;
}
.lb-express-box.active {
  border-color: #f97316; background: rgba(249,115,22,0.04);
}
[data-theme="dark"] .lb-express-box.active { background: rgba(249,115,22,0.06); }
.lb-express-icon {
  width: 44px; height: 44px; background: rgba(249,115,22,0.1);
  border-radius: 12px; display: flex; align-items: center;
  justify-content: center; font-size: 22px; flex-shrink: 0; transition: background 0.2s;
}
.lb-express-box.active .lb-express-icon { background: #f97316; }
.lb-express-text { flex: 1; }
.lb-express-name {
  font-size: 14px; font-weight: 800; color: var(--lb-text);
  display: flex; align-items: center; gap: 6px; margin-bottom: 2px;
}
.lb-express-badge {
  font-size: 10px; font-weight: 700; background: #f97316;
  color: #fff; padding: 2px 7px; border-radius: 8px; letter-spacing: 0.3px;
}
.lb-express-sub { font-size: 11px; color: var(--lb-muted); }
.lb-toggle {
  width: 48px; height: 26px; background: #ddd; border-radius: 13px;
  position: relative; flex-shrink: 0; transition: background 0.2s ease; pointer-events: none;
}
[data-theme="dark"] .lb-toggle { background: #333; }
.lb-express-box.active .lb-toggle { background: #f97316; }
.lb-toggle::after {
  content: ''; position: absolute; top: 3px; left: 3px;
  width: 20px; height: 20px; background: #fff; border-radius: 50%;
  transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}
.lb-express-box.active .lb-toggle::after { transform: translateX(22px); }

/* ── NOTES ── */
.lb-notes-box {
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}
.lb-notes-top {
  display: flex; align-items: center; gap: 10px;
  padding: 0 0 10px 0;
  border-bottom: none;
}
.lb-notes-icon { font-size: 18px; flex-shrink: 0; }
.lb-notes-label { font-size: 13px; font-weight: 700; color: var(--lb-text); }
.lb-notes-label span { font-size: 11px; font-weight: 500; color: var(--lb-muted); margin-left: 4px; }
.lb-notes-textarea {
  width: 100%;
  padding: 14px 16px;
  background: var(--lb-inp-bg, rgba(255,255,255,0.06));
  border: 1.5px solid var(--lb-inp-border, rgba(255,255,255,0.12));
  border-radius: 14px;
  font-size: 14px;
  color: var(--lb-text);
  line-height: 1.6;
  resize: none;
  min-height: 96px;
  font-family: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.lb-notes-textarea:focus {
  outline: none;
  border-color: var(--lb-gold);
  box-shadow: 0 0 0 3px rgba(244,180,0,0.12);
  background: var(--lb-inp-focus-bg, rgba(255,255,255,0.09));
}
.lb-notes-textarea::placeholder { color: var(--lb-placeholder, rgba(160,160,160,0.6)); }

/* ── FEEDBACK ── */
.lb-feedback {
  border-radius: 12px; padding: 12px 14px; font-size: 13px;
  font-weight: 600; display: none; align-items: center; gap: 8px;
}
.lb-feedback.show { display: flex; }
.lb-feedback.error {
  background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444;
}
.lb-feedback.success {
  background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #22c55e;
}

/* ── INLINE CONFIRM BAR ── */
.lb-sticky {
  margin: 20px 0 8px;
  padding: 0;
  background: none;
  border: none;
  box-shadow: none;
}
.lb-sticky-inner {
  display: flex; align-items: center; gap: 14px;
}
.lb-sticky-price { flex-shrink: 0; min-width: 90px; }
.lb-sticky-price-main {
  font-size: 21px; font-weight: 900; color: var(--lb-text);
  letter-spacing: -0.5px; line-height: 1;
}
.lb-sticky-price-sub {
  font-size: 10.5px; color: var(--lb-muted); margin-top: 3px; font-weight: 500;
}
.lb-add-btn {
  flex: 1; height: 54px;
  background: linear-gradient(135deg, #ff1f35 0%, #C41E3A 55%, #9b1226 100%);
  color: #fff; border: none; border-radius: 16px; font-size: 15px;
  font-weight: 900; letter-spacing: 0.6px; text-transform: uppercase;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  gap: 8px; position: relative; overflow: hidden;
  box-shadow: 0 6px 20px rgba(196,30,58,0.4), inset 0 1px 0 rgba(255,255,255,0.15);
  transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}
.lb-add-btn::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 45%;
  background: linear-gradient(to bottom, rgba(255,255,255,0.18), transparent);
  border-radius: 16px 16px 0 0; pointer-events: none;
}
.lb-add-btn::after {
  content: ''; position: absolute; top: 0; left: -80%; width: 55%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: lb-btn-shine 3s ease 0.6s infinite; pointer-events: none;
}
@keyframes lb-btn-shine { 0% { left: -60%; } 55%,100% { left: 120%; } }
.lb-add-btn:not(:disabled) { animation: lb-btn-ready 2.5s ease-in-out infinite; }
@keyframes lb-btn-ready {
  0%,100% { box-shadow: 0 6px 20px rgba(196,30,58,0.4), inset 0 1px 0 rgba(255,255,255,0.15); }
  50%      { box-shadow: 0 8px 28px rgba(196,30,58,0.6), inset 0 1px 0 rgba(255,255,255,0.15); }
}
.lb-add-btn:active:not(:disabled) { transform: scale(0.97); animation: none; }
.lb-add-btn:disabled {
  background: #d0d0d0; box-shadow: none; cursor: not-allowed; animation: none; opacity: 1;
}
[data-theme="dark"] .lb-add-btn:disabled { background: #2a2a2a; color: #555; }
.lb-add-btn.loading { pointer-events: none; animation: none; opacity: 0.9; }
.lb-spinner {
  width: 18px; height: 18px;
  border: 2.5px solid rgba(255,255,255,0.35); border-top-color: #fff;
  border-radius: 50%; animation: lb-spin 0.7s linear infinite;
}
@keyframes lb-spin { to { transform: rotate(360deg); } }

/* ── DISCLAIMER ── */
.lb-disclaimer {
  padding: 0 16px 16px; font-size: 11px; color: var(--lb-muted);
  text-align: center; line-height: 1.5;
}

/* ── DESKTOP ── */
@media (min-width: 640px) {
  .lb-hero { padding: 56px 24px 72px; }
  .lb-hero-title { font-size: 32px; }
  .lb-content { max-width: 560px; margin: 0 auto; }
  .lb-section { padding: 0 24px; }
  .lb-trust-row { padding: 14px 24px; }
  .lb-add-btn { font-size: 16px; }
}
</style>

<div class="lb-wrap" id="lb-wrap">

  <!-- HERO -->
  <div class="lb-hero">
    <div class="lb-hero-badge">🐝 QuickBee × KapadaWash</div>
    <span class="lb-hero-icon">👕</span>
    <h1 class="lb-hero-title">{{ collection.title }}</h1>
    <p class="lb-hero-sub">{{ collection.description | strip_html | default: 'Pick multiple services · Set quantity inline · Checkout fast' }}</p>
  </div>

  <!-- TRUST PILLS -->
  <div class="lb-trust-row">
    <div class="lb-trust-pill">⚡ Same-day pickup</div>
    <div class="lb-trust-pill">🔒 Insured clothes</div>
    <div class="lb-trust-pill">✅ Quality guarantee</div>
    <div class="lb-trust-pill">📍 Live tracking</div>
    <div class="lb-trust-pill">💧 Eco-friendly</div>
  </div>

  <div class="lb-content">

    <!-- LIVE ORDER SUMMARY -->
    <div class="lb-live-summary" id="lb-live-summary" style="display:none;">
      <div class="lb-ls-header">
        <span class="lb-ls-dot"></span>
        <span class="lb-ls-title">Your Order</span>
        <span class="lb-ls-count" id="lb-ls-count">0 items</span>
      </div>
      <div class="lb-ls-empty" id="lb-ls-empty" style="display:none;">
        Tap a service below to start your order 👇
      </div>
      <div class="lb-ls-items" id="lb-ls-items"></div>
      <div class="lb-ls-express-row" id="lb-ls-express-row">
        <span>⚡ Express surcharge</span>
        <span id="lb-ls-express-amt"></span>
      </div>
      <div class="lb-ls-total-row">
        <span class="lb-ls-total-label">Total</span>
        <span class="lb-ls-total-price" id="lb-ls-total">Rs 0</span>
      </div>
    </div>

    <!-- FEEDBACK -->
    <div class="lb-section" style="margin-top:4px;">
      <div class="lb-feedback" id="lb-feedback" role="alert"></div>
    </div>

    <!-- SELECT SERVICE -->
    <div class="lb-section" style="margin-top:20px;">
      <div class="lb-section-title">① Choose Services</div>
      <div class="lb-services-grid" id="lb-services" role="group" aria-label="Laundry services">

        {% for product in collection.products %}
          {%- assign unit = 'pcs' -%}
          {%- assign icon = '👕' -%}
          {%- assign desc = product.description | strip_html | truncate: 80 -%}
          
          {%- for tag in product.tags -%}
            {%- if tag contains 'unit:' -%}{%- assign unit = tag | split: ':' | last -%}{%- endif -%}
            {%- if tag contains 'icon:' -%}{%- assign icon = tag | split: ':' | last -%}{%- endif -%}
          {%- endfor -%}

          <div class="lb-service-card" 
               data-variant-id="{{ product.first_available_variant.id }}" 
               data-variant-title="{{ product.title | escape }}" 
               data-unit="{{ unit }}" 
               data-icon="{{ icon }}" 
               tabindex="0">
            <div class="lb-svc-icon-wrap">{{ icon }}</div>
            <div class="lb-svc-info">
              <div class="lb-svc-name">{{ product.title }}</div>
              <div class="lb-svc-meta">
                <span class="lb-svc-unit">per {{ unit }}</span>
                <span>{{ desc }}</span>
              </div>
            </div>
            <div class="lb-svc-right">
              <div class="lb-svc-price-line" data-price>Rs {{ product.price | divided_by: 100 }}<span class="lb-svc-price-unit">/{{ unit }}</span></div>
              <button class="lb-svc-add-btn" aria-label="Add" type="button">+</button>
              <div class="lb-card-qty">
                <button class="lb-card-qty-btn lb-cq-minus" type="button" aria-label="Decrease">−</button>
                <span class="lb-card-qty-val">1</span>
                <button class="lb-card-qty-btn lb-cq-plus" type="button" aria-label="Increase">+</button>
              </div>
            </div>
          </div>
        {% endfor %}

      </div>
    </div>

    <!-- EXPRESS DELIVERY -->
    <div class="lb-section" style="margin-top:20px;">
      <div class="lb-section-title">② Express Delivery</div>
      <div class="lb-express-box" id="lb-express" role="switch" aria-checked="false" tabindex="0">
        <div class="lb-express-icon">⚡</div>
        <div class="lb-express-text">
          <div class="lb-express-name">
            Express 6-Hour
            <span class="lb-express-badge" id="lb-express-badge">+Rs 80/item</span>
          </div>
          <div class="lb-express-sub">Priority processing · Done in 6 hours</div>
        </div>
        <div class="lb-toggle"></div>
      </div>
    </div>

    <!-- SPECIAL INSTRUCTIONS -->
    <div class="lb-section" style="margin-top:20px;">
      <div class="lb-section-title">③ Special Instructions <span style="text-transform:none;letter-spacing:0;font-size:11px;color:var(--lb-muted);font-weight:500;">(optional)</span></div>
      <div class="lb-notes-box">
        <div class="lb-notes-top">
          <span class="lb-notes-icon">📝</span>
          <div class="lb-notes-label">Add a note <span>e.g. "Handle delicately"</span></div>
        </div>
        <textarea class="lb-notes-textarea" id="lb-notes" placeholder="Stain details, fabric types, special requests..." rows="3" maxlength="250"></textarea>
      </div>

      <!-- CONFIRM BUTTON -->
      <div class="lb-sticky">
        <div class="lb-sticky-inner">
          <div class="lb-sticky-price">
            <div class="lb-sticky-price-main" id="lb-sticky-price">Rs 0</div>
            <div class="lb-sticky-price-sub" id="lb-sticky-price-sub">Select services</div>
          </div>
          <button class="lb-add-btn" id="lb-add-btn" disabled aria-label="Confirm order">
            <span class="lb-add-btn-content">
              <span>✅</span>
              <span id="lb-btn-text">Confirm Order</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- DISCLAIMER -->
    <div class="lb-disclaimer">
      📦 Our team will pick up from your address. Final weight / piece count confirmed at pickup.<br>
      Payment collected after service is complete.
    </div>

  </div>
</div>

<!-- CONFIRM SUCCESS OVERLAY -->
<div class="lb-success-overlay" id="lb-success-overlay" role="dialog" aria-modal="true" aria-label="Order confirmed">
  <div class="lb-success-card">
    <div class="lb-success-rings">
      <span class="lb-success-bee">🛵</span>
    </div>
    <div class="lb-success-title">Order Confirmed! 🎉</div>
    <div class="lb-success-sub">Taking you to checkout…</div>
    <div class="lb-success-bar-wrap">
      <div class="lb-success-bar" id="lb-success-bar"></div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var EXPRESS_PER_UNIT = 80;
  var MAX_QTY = 50;
  var MIN_QTY = 1;
  var LS_KEY  = 'qb_laundry_order';

  /* ── State: { variantId → { variantId, title, unit, icon, qty, priceRs } } ── */
  var selections = {};
  var expressOn  = false;

  /* ── Helpers ── */
  function cleanStr(s) {
    return String(s).replace(/&amp;/g,'&').replace(/&nbsp;/g,' ').replace(/\s+/g,' ').trim().toLowerCase();
  }
  function displayTitle(raw) {
    return raw.replace(/&amp;/g,'&').replace(/\s*\((kg|pcs|set)\)\s*$/i,'').trim();
  }

  /* ── localStorage ── */
  function saveOrder(data) {
    try { localStorage.setItem(LS_KEY, JSON.stringify(data)); } catch(_) {}
  }
  function loadOrder() {
    try { return JSON.parse(localStorage.getItem(LS_KEY)||'null'); } catch(_) { return null; }
  }
  function clearOrder() {
    try { localStorage.removeItem(LS_KEY); } catch(_) {}
  }

  /* ── Init ── */
  document.querySelectorAll('.lb-service-card').forEach(function(card) {
    var vId   = card.getAttribute('data-variant-id');
    var title = card.getAttribute('data-variant-title');
    var unit  = card.getAttribute('data-unit');
    var priceText = card.querySelector('.lb-svc-price-line').textContent;
    var priceRs   = parseInt(priceText.replace(/[^\d]/g, '')) || 0;

    /* Tap on card body */
    card.addEventListener('click', function(e) {
      if (e.target.closest('.lb-card-qty') || e.target.classList.contains('lb-svc-add-btn')) return;
      if (!card.classList.contains('selected')) {
        addService(card, vId, title, unit, priceRs);
      }
    });

    /* "+" add button click */
    var addBtn = card.querySelector('.lb-svc-add-btn');
    if (addBtn) {
      addBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        addService(card, vId, title, unit, priceRs);
      });
    }

    /* Stepper minus */
    var minusBtn = card.querySelector('.lb-cq-minus');
    if (minusBtn) {
      minusBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!selections[vId]) return;
        var newQty = selections[vId].qty - 1;
        if (newQty < MIN_QTY) {
          removeService(card, vId);
        } else {
          selections[vId].qty = newQty;
          card.querySelector('.lb-card-qty-val').textContent = newQty;
          minusBtn.disabled = newQty <= MIN_QTY;
          updateLinePriceOnCard(card, selections[vId]);
          updateSummary();
        }
      });
    }

    /* Stepper plus */
    var plusBtn = card.querySelector('.lb-cq-plus');
    if (plusBtn) {
      plusBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!selections[vId]) return;
        if (selections[vId].qty >= MAX_QTY) return;
        selections[vId].qty++;
        card.querySelector('.lb-card-qty-val').textContent = selections[vId].qty;
        card.querySelector('.lb-cq-minus').disabled = false;
        updateLinePriceOnCard(card, selections[vId]);
        updateSummary();
      });
    }

    /* keyboard */
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!card.classList.contains('selected')) addService(card, vId, title, unit, priceRs);
      }
    });
  });

  function addService(card, vId, title, unit, priceRs) {
    if (selections[vId]) return;
    selections[vId] = {
      card:         card,
      variantId:    vId,
      unit:         unit,
      icon:         card.getAttribute('data-icon') || '👕',
      displayTitle: displayTitle(title),
      qty:          1,
      priceRs:      priceRs
    };
    card.classList.add('selected');
    var qv = card.querySelector('.lb-card-qty-val');
    if (qv) qv.textContent = '1';
    var mb = card.querySelector('.lb-cq-minus');
    if (mb) mb.disabled = true;
    updateLinePriceOnCard(card, selections[vId]);
    hideFeedback();
    updateSummary();
    document.getElementById('lb-live-summary').style.display = 'block';
  }

  function removeService(card, vId) {
    delete selections[vId];
    card.classList.remove('selected');
    var qv = card.querySelector('.lb-card-qty-val');
    if (qv) qv.textContent = '1';
    var mb = card.querySelector('.lb-cq-minus');
    if (mb) mb.disabled = false;
    
    // Reset price display
    var unit    = card.getAttribute('data-unit');
    var priceEl = card.querySelector('[data-price]');
    var vId_orig = card.getAttribute('data-variant-id');
    
    // We can't easily get original price without storing it or parsing it again
    // But we already have priceRs from the init phase.
    updateSummary();
  }

  function updateLinePriceOnCard(card, sel) {
    var lineTotal = sel.qty * sel.priceRs;
    var priceEl = card.querySelector('[data-price]');
    if (priceEl) {
      priceEl.innerHTML = '<span style="font-size:11px;font-weight:500;color:var(--lb-muted);">' + sel.qty + ' × Rs ' + sel.priceRs + '</span><br>Rs ' + lineTotal;
    }
  }

  /* ── Express ── */
  var expressBox = document.getElementById('lb-express');
  if (expressBox) {
    expressBox.addEventListener('click', function() {
      expressOn = !expressOn;
      expressBox.classList.toggle('active', expressOn);
      expressBox.setAttribute('aria-checked', String(expressOn));
      updateSummary();
    });
  }

  /* ── Live Summary update ── */
  function calcTotals() {
    var subtotal = 0;
    Object.keys(selections).forEach(function(key) {
      var s = selections[key];
      subtotal += s.qty * s.priceRs;
    });
    var expressSurcharge = expressOn ? Object.values(selections).reduce(function(acc, s) {
      return acc + s.qty * EXPRESS_PER_UNIT;
    }, 0) : 0;
    return { subtotal: subtotal, express: expressSurcharge, total: subtotal + expressSurcharge };
  }

  function updateSummary() {
    var keys   = Object.keys(selections);
    var totals = calcTotals();
    var count  = keys.length;

    var summaryEl   = document.getElementById('lb-live-summary');
    var itemsEl     = document.getElementById('lb-ls-items');
    var countEl     = document.getElementById('lb-ls-count');
    var expressRow  = document.getElementById('lb-ls-express-row');
    var expressAmt  = document.getElementById('lb-ls-express-amt');
    var totalEl     = document.getElementById('lb-ls-total');
    var stickyPrice = document.getElementById('lb-sticky-price');
    var stickySub   = document.getElementById('lb-sticky-price-sub');
    var addBtn      = document.getElementById('lb-add-btn');

    if (count === 0) {
      summaryEl.style.display = 'none';
    } else {
      summaryEl.style.display = 'block';
    }

    if (countEl) countEl.textContent = count + (count === 1 ? ' item' : ' items');

    itemsEl.innerHTML = '';
    keys.forEach(function(key) {
      var s   = selections[key];
      var row = document.createElement('div');
      row.className = 'lb-ls-item';
      row.innerHTML =
        '<span class="lb-ls-item-icon">' + s.icon + '</span>' +
        '<span class="lb-ls-item-name">' + s.displayTitle + '</span>' +
        '<span class="lb-ls-item-qty">' + s.qty + ' ' + s.unit + '</span>' +
        '<span class="lb-ls-item-price">Rs ' + (s.qty * s.priceRs) + '</span>' +
        '<button class="lb-ls-item-remove" data-key="' + key + '" type="button" aria-label="Remove">✕</button>';
      itemsEl.appendChild(row);
    });

    itemsEl.querySelectorAll('.lb-ls-item-remove').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var k = btn.getAttribute('data-key');
        if (selections[k]) removeService(selections[k].card, k);
      });
    });

    if (expressRow) {
      if (expressOn && totals.express > 0) {
        expressRow.classList.add('show');
        expressAmt.textContent = '+Rs ' + totals.express;
      } else {
        expressRow.classList.remove('show');
      }
    }

    if (totalEl) totalEl.textContent = 'Rs ' + totals.total;

    if (stickyPrice) {
      if (count === 0) {
        stickyPrice.textContent = 'Rs 0';
        stickySub.textContent   = 'Select services';
        addBtn.disabled = true;
      } else {
        stickyPrice.textContent = 'Rs ' + totals.total;
        stickySub.textContent   = count + (count===1?' service':' services') + (expressOn ? ' · Express' : '');
        addBtn.disabled = false;
      }
    }
  }

  /* ── Feedback ── */
  function showFeedback(type, msg) {
    var el = document.getElementById('lb-feedback');
    if (!el) return;
    el.className = 'lb-feedback show ' + type;
    el.innerHTML = (type==='error'?'⚠️ ':'✅ ') + msg;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function hideFeedback() {
    var el = document.getElementById('lb-feedback');
    if (!el) return;
    el.className = 'lb-feedback';
    el.textContent = '';
  }

  function setLoading(on) {
    var btn = document.getElementById('lb-add-btn');
    if (!btn) return;
    if (on) {
      btn.classList.add('loading');
      btn.innerHTML = '<span class="lb-spinner"></span><span style="font-size:13px;font-weight:700;letter-spacing:0.3px;">Processing…</span>';
    } else {
      btn.classList.remove('loading');
      btn.innerHTML = '<span class="lb-add-btn-content"><span>✅</span><span id="lb-btn-text">Confirm Order</span></span>';
    }
  }

  function doCartAdd() {
    var keys = Object.keys(selections);
    var notes = (document.getElementById('lb-notes').value || '').trim();
    var totals = calcTotals();

    var items = keys.map(function(key) {
      var s = selections[key];
      return {
        id:         s.variantId,
        quantity:   s.qty,
        properties: {
          'Service':      s.displayTitle,
          'Quantity':     s.qty + ' ' + s.unit,
          'Express':      expressOn ? 'Yes (+Rs ' + (s.qty * EXPRESS_PER_UNIT) + ')' : 'No',
          'Pickup Notes': notes || 'None'
        }
      };
    });

    fetch('/cart/add.js', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body:    JSON.stringify({ items: items })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Server error');
      return res.json();
    })
    .then(function(data) {
      saveOrder({
        version:   2,
        items:     keys.map(function(k) { return selections[k]; }),
        express:   expressOn,
        total:     totals.total,
        addedAt:   new Date().toISOString()
      });

      if (typeof window.qbSyncCartNote === 'function') window.qbSyncCartNote();
      showSuccessOverlay(function() { window.location.href = '/pages/payment'; });
    })
    .catch(function(err) {
      setLoading(false);
      showFeedback('error', 'Something went wrong. Please try again.');
    });
  }

  var mainAddBtn = document.getElementById('lb-add-btn');
  if (mainAddBtn) {
    mainAddBtn.addEventListener('click', function(e) {
      if (Object.keys(selections).length === 0) {
        showFeedback('error', 'Please select at least one service first.');
        return;
      }
      setLoading(true);
      doCartAdd();
    });
  }

  function showSuccessOverlay(cb) {
    var overlay = document.getElementById('lb-success-overlay');
    var bar     = document.getElementById('lb-success-bar');
    if (!overlay) { setTimeout(cb, 400); return; }
    overlay.classList.add('show');
    setTimeout(function() { if (bar) bar.style.width = '100%'; }, 200);
    setTimeout(cb, 2100);
  }

  updateSummary();

})();
</script>

{% schema %}
{
  "name": "KapadaWash Collection",
  "settings": [],
  "presets": [{ "name": "KapadaWash Collection" }]
}
{% endschema %}
