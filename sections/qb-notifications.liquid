<div class="qb-np">

  <!-- ── Header ─────────────────────────────────────── -->
  <div class="qb-np__header">
    <div class="qb-np__header-inner">
      <div class="qb-np__header-top">
        <div class="qb-np__logo">🐝</div>
        <div>
          <h1 class="qb-np__title">Notifications</h1>
          <p class="qb-np__tagline">QuickBee AI · Deals, drops &amp; updates</p>
        </div>
      </div>

      <!-- Subscribe toggle card -->
      <div class="qb-np__sub-card" id="qb-np-sub-card">
        <div class="qb-np__sub-status">
          <span class="qb-np__sub-dot" id="qb-np-dot"></span>
          <span class="qb-np__sub-label" id="qb-np-label">Checking…</span>
        </div>
        <button class="qb-np__sub-btn" id="qb-np-btn" type="button">Enable</button>
      </div>
    </div>
  </div>

  <!-- ── Body ───────────────────────────────────────── -->
  <div class="qb-np__body">

    <!-- Notification list -->
    <div id="qb-np-list" class="qb-np__list"></div>

    <!-- Empty state -->
    <div id="qb-np-empty" class="qb-np__empty" style="display:none;">
      <div class="qb-np__empty-icon">🍯</div>
      <p class="qb-np__empty-title">Nothing yet</p>
      <p class="qb-np__empty-sub">Enable notifications and be the first to hear about QuickBee deals.</p>
    </div>

  </div>

</div>

<style>
  /* ─────────────────────────────────────────────────
     Notification Page — qb-np
  ───────────────────────────────────────────────── */
  .qb-np {
    min-height: 60vh;
    font-family: var(--font-body--family, sans-serif);
  }

  /* Header */
  .qb-np__header {
    background: linear-gradient(135deg, rgba(255,184,0,0.08) 0%, rgba(255,107,0,0.04) 100%);
    border-bottom: 1px solid rgba(255,184,0,0.12);
    position: relative;
    overflow: hidden;
  }

  .qb-np__header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #FFB800, #FF6B00);
  }

  .qb-np__header-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 28px 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .qb-np__header-top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .qb-np__logo {
    font-size: 38px;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(255,184,0,0.3));
  }

  .qb-np__title {
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 800;
    color: var(--color-foreground, #111);
    margin: 0 0 3px;
    letter-spacing: -0.5px;
  }

  .qb-np__tagline {
    font-size: 12px;
    color: #FFB800;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.3px;
  }

  /* Subscribe card inside header */
  .qb-np__sub-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--color-background, #fff);
    border: 1px solid rgba(255,184,0,0.2);
    border-radius: 14px;
    padding: 14px 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .qb-np__sub-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .qb-np__sub-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d1d5db;
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .qb-np__sub-dot--on  { background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.18); }
  .qb-np__sub-dot--off { background: #f59e0b; }
  .qb-np__sub-dot--blocked { background: #ef4444; }

  .qb-np__sub-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground, #333);
  }

  .qb-np__sub-btn {
    flex-shrink: 0;
    padding: 9px 20px;
    background: linear-gradient(135deg, #FFB800, #FF6B00);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 0 3px 12px rgba(255,140,0,0.3);
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }

  .qb-np__sub-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 18px rgba(255,140,0,0.4);
  }

  .qb-np__sub-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .qb-np__sub-btn--off {
    background: transparent;
    border: 1.5px solid rgba(255,184,0,0.35);
    color: var(--color-foreground, #333);
    box-shadow: none;
  }

  /* Body */
  .qb-np__body {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  /* Notification list */
  .qb-np__list {
    display: flex;
    flex-direction: column;
  }

  /* Each notification row */
  .qb-np__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border, rgba(0,0,0,0.07));
    position: relative;
  }

  [data-theme="dark"] .qb-np__item {
    border-bottom-color: rgba(255,255,255,0.07);
  }

  .qb-np__item--unread::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, #FFB800, #FF6B00);
    border-radius: 0 3px 3px 0;
  }

  .qb-np__item-icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(255,184,0,0.15), rgba(255,107,0,0.08));
    border: 1px solid rgba(255,184,0,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .qb-np__item-body {
    flex: 1;
    min-width: 0;
  }

  .qb-np__item-text {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground, #111);
    margin: 0 0 5px;
    line-height: 1.5;
  }

  .qb-np__item--unread .qb-np__item-text {
    font-weight: 700;
  }

  .qb-np__item-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .qb-np__item-time {
    font-size: 11px;
    color: var(--color-foreground, #999);
    opacity: 0.5;
  }

  .qb-np__item-new {
    font-size: 10px;
    font-weight: 700;
    color: #FFB800;
    background: rgba(255,184,0,0.12);
    border-radius: 20px;
    padding: 2px 8px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  /* Empty state */
  .qb-np__empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-foreground, #999);
  }

  .qb-np__empty-icon {
    font-size: 48px;
    margin-bottom: 14px;
    opacity: 0.5;
  }

  .qb-np__empty-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--color-foreground, #333);
    opacity: 0.7;
  }

  .qb-np__empty-sub {
    font-size: 13px;
    margin: 0;
    opacity: 0.45;
    line-height: 1.5;
    max-width: 260px;
    margin: 0 auto;
  }

  @media (max-width: 480px) {
    .qb-np__header-inner { padding: 20px 16px 18px; }
    .qb-np__body { padding: 0 16px 60px; }
  }
</style>

<script>
(function () {
  var STORAGE_KEY = 'qb_notifications';

  function getHistory() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch(e) { return []; }
  }

  function timeAgo(ts) {
    var d = Math.floor((Date.now() - ts) / 1000);
    if (d < 60)    return 'Just now';
    if (d < 3600)  return Math.floor(d/60) + ' min ago';
    if (d < 86400) return Math.floor(d/3600) + ' hr ago';
    var days = Math.floor(d/86400);
    return days === 1 ? 'Yesterday' : days + ' days ago';
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Render notification list ───────────────────── */
  function render() {
    var list    = getHistory();
    var listEl  = document.getElementById('qb-np-list');
    var emptyEl = document.getElementById('qb-np-empty');
    if (!listEl) return;

    if (list.length === 0) {
      listEl.innerHTML = '';
      if (emptyEl) emptyEl.style.display = 'block';
      return;
    }
    if (emptyEl) emptyEl.style.display = 'none';

    listEl.innerHTML = list.map(function(n, i) {
      var isNew = !n.read || (Date.now() - n.timestamp < 3600000);
      return (
        '<div class="qb-np__item' + (n.read ? '' : ' qb-np__item--unread') + '">' +
          '<div class="qb-np__item-icon-wrap">🐝</div>' +
          '<div class="qb-np__item-body">' +
            '<p class="qb-np__item-text">' + esc(n.body || n.title) + '</p>' +
            '<div class="qb-np__item-meta">' +
              '<span class="qb-np__item-time">' + timeAgo(n.timestamp) + '</span>' +
              (isNew && !n.read ? '<span class="qb-np__item-new">New</span>' : '') +
            '</div>' +
          '</div>' +
        '</div>'
      );
    }).join('');

    /* Mark all as read */
    try {
      var updated = list.map(function(n) { n.read = true; return n; });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
    } catch(e) {}
  }

  /* ── Subscription status ────────────────────────── */
  function updateStatus() {
    var dot   = document.getElementById('qb-np-dot');
    var label = document.getElementById('qb-np-label');
    var btn   = document.getElementById('qb-np-btn');
    if (!dot || !label || !btn) return;

    if (!('Notification' in window)) {
      dot.className = 'qb-np__sub-dot qb-np__sub-dot--blocked';
      label.textContent = 'Not supported in this browser';
      btn.disabled = true;
      return;
    }

    if (Notification.permission === 'denied') {
      dot.className = 'qb-np__sub-dot qb-np__sub-dot--blocked';
      label.textContent = 'Blocked — enable in browser settings';
      btn.textContent = 'Blocked';
      btn.disabled = true;
      return;
    }

    var subscribed = false;
    try {
      subscribed = !!(window.OneSignal &&
        window.OneSignal.User &&
        window.OneSignal.User.PushSubscription &&
        window.OneSignal.User.PushSubscription.optedIn);
    } catch(e) {}

    if (subscribed) {
      dot.className = 'qb-np__sub-dot qb-np__sub-dot--on';
      label.textContent = 'Notifications enabled';
      btn.textContent = 'Turn off';
      btn.classList.add('qb-np__sub-btn--off');
      btn.dataset.on = '1';
    } else {
      dot.className = 'qb-np__sub-dot qb-np__sub-dot--off';
      label.textContent = Notification.permission === 'granted'
        ? 'Tap Enable to subscribe'
        : 'Notifications off';
      btn.textContent = 'Enable';
      btn.classList.remove('qb-np__sub-btn--off');
      btn.dataset.on = '0';
    }
  }

  /* ── Button click ───────────────────────────────── */
  function wireBtn() {
    var btn = document.getElementById('qb-np-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      window.OneSignalDeferred.push(function (OS) {
        var isOn = btn.dataset.on === '1';
        if (isOn) {
          OS.User.PushSubscription.optOut();
        } else {
          OS.User.PushSubscription.optIn();
        }
        setTimeout(updateStatus, 1500);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    render();
    updateStatus();
    wireBtn();
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    window.OneSignalDeferred.push(function () { setTimeout(updateStatus, 800); });
  });
})();
</script>

{% schema %}
{
  "name": "QB Notifications",
  "tag": "section",
  "class": "qb-notifications-section",
  "settings": [],
  "presets": [{ "name": "QB Notifications" }]
}
{% endschema %}
