  "name": "Nuad Thai Spa Collection",
  "settings": [
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp Number", "default": "+977 9801234567" },
    { "type": "checkbox", "id": "show_why_section", "label": "Show Why Choose Us", "default": true }
  ]
}
