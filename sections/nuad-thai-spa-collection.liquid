<style>
:root{--nt-bg:#0e1a0f;--nt-gold:#C9A84C;--nt-cream:#FBF8F2;--nt-card:#152016;--nt-border:#2a3d2b;--nt-text:#FBF8F2;--nt-muted:#a8b8a9;--nt-radius:12px;--nt-shadow:0 4px 24px rgba(0,0,0,.4)}
[data-theme="light"]{--nt-bg:#FBF8F2;--nt-gold:#A07830;--nt-cream:#0e1a0f;--nt-card:#fff;--nt-border:#d6cfc0;--nt-text:#0e1a0f;--nt-muted:#6b6050;--nt-shadow:0 4px 24px rgba(0,0,0,.12)}
[data-theme="dark"]{--nt-bg:#0e1a0f;--nt-gold:#C9A84C;--nt-cream:#FBF8F2;--nt-card:#152016;--nt-border:#2a3d2b;--nt-text:#FBF8F2;--nt-muted:#a8b8a9}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
.nt-wrap{background:var(--nt-bg);color:var(--nt-text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;min-width:0;overflow-x:hidden}
.nt-hero{background:var(--nt-bg);padding:56px 20px 48px;text-align:center;border-bottom:1px solid var(--nt-border)}
.nt-hero__eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--nt-gold);margin-bottom:12px}
.nt-hero__title{font-size:clamp(28px,6vw,52px);font-weight:700;line-height:1.15;color:var(--nt-cream);margin-bottom:10px}
.nt-hero__title span{color:var(--nt-gold)}
.nt-hero__loc{font-size:13px;color:var(--nt-muted);margin-bottom:28px;display:flex;align-items:center;justify-content:center;gap:6px}
.nt-hero__loc svg{flex-shrink:0}
.nt-hero__ctas{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.nt-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;border:none;transition:opacity .2s,transform .15s}
.nt-btn:active{transform:scale(.97)}
.nt-btn--gold{background:var(--nt-gold);color:#0e1a0f}
.nt-btn--outline{background:transparent;color:var(--nt-gold);border:1.5px solid var(--nt-gold)}
.nt-btn:hover{opacity:.88}
.nt-btn:disabled{opacity:.5;cursor:not-allowed}
.nt-marquee-wrap{overflow:hidden;background:var(--nt-gold);padding:10px 0}
.nt-marquee{display:flex;animation:ntScroll 28s linear infinite;width:max-content}
.nt-marquee:hover{animation-play-state:paused}
.nt-marquee__item{white-space:nowrap;font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#0e1a0f;padding:0 32px}
.nt-marquee__item::after{content:'✦';margin-left:32px}
@keyframes ntScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.nt-tabs-wrap{position:sticky;top:0;z-index:50;background:var(--nt-bg);border-bottom:1px solid var(--nt-border);padding:0 20px}
.nt-tabs{display:flex;gap:6px;overflow-x:auto;padding:12px 0;scrollbar-width:none;-ms-overflow-style:none}
.nt-tabs::-webkit-scrollbar{display:none}
.nt-tab{flex-shrink:0;padding:7px 16px;border-radius:20px;font-size:13px;font-weight:500;cursor:pointer;border:1.5px solid var(--nt-border);background:transparent;color:var(--nt-muted);transition:all .2s;white-space:nowrap}
.nt-tab.active,.nt-tab:hover{background:var(--nt-gold);border-color:var(--nt-gold);color:#0e1a0f}
.nt-catalog{padding:32px 20px 48px;max-width:1200px;margin:0 auto}
.nt-catalog__heading{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--nt-gold);margin-bottom:24px}
.nt-grid{display:grid;grid-template-columns:1fr;gap:20px}
@media(min-width:640px){.nt-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.nt-grid{grid-template-columns:repeat(3,1fr)}}
.nt-card{background:var(--nt-card);border:1px solid var(--nt-border);border-radius:var(--nt-radius);overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;opacity:0;transform:translateY(16px)}
.nt-card.visible{opacity:1;transform:translateY(0);transition:opacity .4s ease,transform .4s ease}
.nt-card:hover{transform:translateY(-3px);box-shadow:var(--nt-shadow)}
.nt-card[hidden]{display:none!important}
.nt-card__img-wrap{aspect-ratio:4/3;overflow:hidden;background:#0a130b}
.nt-card__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.nt-card:hover .nt-card__img{transform:scale(1.04)}
.nt-card__img-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:40px;background:linear-gradient(135deg,#152016,#0e1a0f)}
.nt-card__body{padding:18px 16px 16px;display:flex;flex-direction:column;flex:1;gap:8px}
.nt-card__type{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--nt-gold)}
.nt-card__name{font-size:16px;font-weight:600;color:var(--nt-text);line-height:1.3}
.nt-card__desc{font-size:13px;color:var(--nt-muted);line-height:1.5;flex:1}
.nt-pills{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
.nt-pill{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:500;cursor:pointer;border:1px solid var(--nt-border);background:transparent;color:var(--nt-muted);transition:all .15s}
.nt-pill.active,.nt-pill:hover{background:var(--nt-gold);border-color:var(--nt-gold);color:#0e1a0f}
.nt-card__footer{display:flex;align-items:center;justify-content:space-between;margin-top:4px;gap:8px}
.nt-card__price{font-size:17px;font-weight:700;color:var(--nt-gold)}
.nt-card__price span{font-size:11px;font-weight:400;color:var(--nt-muted);margin-right:2px}
.nt-book-btn{padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;background:var(--nt-gold);color:#0e1a0f;border:none;cursor:pointer;transition:opacity .2s,transform .15s;flex-shrink:0}
.nt-book-btn:hover{opacity:.85}
.nt-book-btn:active{transform:scale(.96)}
.nt-empty{text-align:center;padding:60px 20px;color:var(--nt-muted);grid-column:1/-1}
.nt-why{padding:48px 20px;background:var(--nt-card);border-top:1px solid var(--nt-border);border-bottom:1px solid var(--nt-border)}
.nt-why__inner{max-width:1200px;margin:0 auto}
.nt-why__heading{text-align:center;margin-bottom:32px}
.nt-why__heading h2{font-size:clamp(22px,4vw,36px);font-weight:700;color:var(--nt-text)}
.nt-why__heading p{color:var(--nt-muted);margin-top:8px;font-size:14px}
.nt-why__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(min-width:768px){.nt-why__grid{grid-template-columns:repeat(4,1fr)}}
.nt-why__card{background:var(--nt-bg);border:1px solid var(--nt-border);border-radius:var(--nt-radius);padding:24px 18px;text-align:center}
.nt-why__icon{font-size:32px;margin-bottom:12px}
.nt-why__card h3{font-size:14px;font-weight:600;color:var(--nt-text);margin-bottom:6px}
.nt-why__card p{font-size:12px;color:var(--nt-muted);line-height:1.5}
.nt-drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;opacity:0;pointer-events:none;transition:opacity .3s}
.nt-drawer-overlay.open{opacity:1;pointer-events:all}
.nt-drawer{position:fixed;bottom:0;left:0;right:0;z-index:201;background:var(--nt-bg);border-top:1px solid var(--nt-border);border-radius:20px 20px 0 0;padding:24px 20px 32px;max-height:92vh;overflow-y:auto;transform:translateY(100%);transition:transform .35s cubic-bezier(.32,.72,0,1);max-width:540px;margin:0 auto}
.nt-drawer.open{transform:translateY(0)}
.nt-drawer__handle{width:40px;height:4px;background:var(--nt-border);border-radius:2px;margin:0 auto 20px}
.nt-drawer__title{font-size:18px;font-weight:700;color:var(--nt-text);margin-bottom:4px}
.nt-drawer__subtitle{font-size:13px;color:var(--nt-muted);margin-bottom:20px}
.nt-drawer__service{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:var(--nt-card);border:1px solid var(--nt-border);border-radius:8px;margin-bottom:20px;gap:12px}
.nt-drawer__service-name{font-size:14px;font-weight:600;color:var(--nt-text);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nt-drawer__service-price{font-size:14px;font-weight:700;color:var(--nt-gold);flex-shrink:0}
.nt-step{display:none}
.nt-step.active{display:block}
.nt-step-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--nt-gold);margin-bottom:14px}
.nt-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
.nt-chip{padding:8px 14px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;border:1.5px solid var(--nt-border);background:transparent;color:var(--nt-muted);transition:all .15s;white-space:nowrap}
.nt-chip.selected,.nt-chip:hover{background:var(--nt-gold);border-color:var(--nt-gold);color:#0e1a0f}
.nt-time-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:20px}
.nt-time-chip{padding:10px 6px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;border:1.5px solid var(--nt-border);background:transparent;color:var(--nt-muted);text-align:center;transition:all .15s}
.nt-time-chip.selected,.nt-time-chip:hover{background:var(--nt-gold);border-color:var(--nt-gold);color:#0e1a0f}
.nt-form-group{margin-bottom:14px}
.nt-form-group label{display:block;font-size:12px;font-weight:500;color:var(--nt-muted);margin-bottom:5px;letter-spacing:.5px}
.nt-form-group input,.nt-form-group textarea{width:100%;background:var(--nt-card);border:1.5px solid var(--nt-border);border-radius:8px;padding:11px 13px;color:var(--nt-text);font-size:14px;outline:none;transition:border-color .2s;resize:vertical;font-family:inherit}
.nt-form-group input:focus,.nt-form-group textarea:focus{border-color:var(--nt-gold)}
.nt-form-group input::placeholder,.nt-form-group textarea::placeholder{color:var(--nt-muted);opacity:.7}
.nt-drawer__actions{display:flex;gap:10px;margin-top:4px}
.nt-drawer__actions .nt-btn{flex:1;justify-content:center}
.nt-drawer__close{position:absolute;top:18px;right:18px;background:none;border:none;color:var(--nt-muted);font-size:22px;cursor:pointer;line-height:1;padding:4px;display:flex;align-items:center;justify-content:center}
.nt-error{color:#e55;font-size:13px;margin-top:8px;display:none}
.nt-error.show{display:block}
.nt-steps-indicator{display:flex;gap:6px;justify-content:center;margin-bottom:20px}
.nt-step-dot{width:8px;height:8px;border-radius:50%;background:var(--nt-border);transition:background .2s}
.nt-step-dot.active{background:var(--nt-gold)}
</style>

<div class="nt-wrap" id="nt-spa">
  <section class="nt-hero">
    <p class="nt-hero__eyebrow">Traditional &amp; Modern Wellness</p>
    <h1 class="nt-hero__title">Nuad Thai<br><span>Spa &amp; Wellness</span></h1>
    <p class="nt-hero__loc">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      Thamel, Kathmandu, Nepal
    </p>
    <div class="nt-hero__ctas">
      <a href="#nt-catalog" class="nt-btn nt-btn--gold">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        View Services
      </a>
      <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" class="nt-btn nt-btn--outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.532 5.847L0 24l6.335-1.521A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.891 0-3.659-.5-5.192-1.375l-.371-.22-3.862.927.978-3.768-.242-.387A9.944 9.944 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        WhatsApp
      </a>
    </div>
  </section>

  <div class="nt-marquee-wrap" aria-hidden="true">
    <div class="nt-marquee">
      <span class="nt-marquee__item">Traditional Thai Massage</span>
      <span class="nt-marquee__item">Hot Stone Therapy</span>
      <span class="nt-marquee__item">Aromatherapy</span>
      <span class="nt-marquee__item">Deep Tissue Massage</span>
      <span class="nt-marquee__item">Couple Spa</span>
      <span class="nt-marquee__item">Foot Reflexology</span>
      <span class="nt-marquee__item">Herbal Compress</span>
      <span class="nt-marquee__item">Facial Treatment</span>
      <span class="nt-marquee__item">Body Scrub</span>
      <span class="nt-marquee__item">Traditional Thai Massage</span>
      <span class="nt-marquee__item">Hot Stone Therapy</span>
      <span class="nt-marquee__item">Aromatherapy</span>
      <span class="nt-marquee__item">Deep Tissue Massage</span>
      <span class="nt-marquee__item">Couple Spa</span>
      <span class="nt-marquee__item">Foot Reflexology</span>
      <span class="nt-marquee__item">Herbal Compress</span>
      <span class="nt-marquee__item">Facial Treatment</span>
      <span class="nt-marquee__item">Body Scrub</span>
    </div>
  </div>

  {%- assign nt_types = "" -%}
  {%- for product in collection.products -%}
    {%- unless nt_types contains product.type -%}
      {%- if product.type != blank -%}
        {%- assign nt_types = nt_types | append: product.type | append: "||" -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign nt_type_list = nt_types | split: "||" -%}

  <div class="nt-tabs-wrap">
    <div class="nt-tabs" role="tablist" aria-label="Service categories" id="nt-tabs">
      <button class="nt-tab active" role="tab" data-filter="all" aria-selected="true">All Services</button>
      {%- for ptype in nt_type_list -%}
        {%- if ptype != blank -%}
          {%- assign ptype_key = ptype | downcase | replace: ' ', '-' -%}
          <button class="nt-tab" role="tab" data-filter="{{ ptype_key }}" aria-selected="false">{{ ptype }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <section class="nt-catalog" id="nt-catalog">
    <p class="nt-catalog__heading">Our Services</p>
    <div class="nt-grid" id="nt-grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {%- assign ptype_key = product.type | downcase | replace: ' ', '-' -%}
          {%- assign short_desc = product.description | strip_html | truncate: 80 -%}
          <div class="nt-card" data-type="{{ ptype_key }}" role="article">
            <div class="nt-card__img-wrap">
              {%- if product.featured_image -%}
                <img class="nt-card__img" src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="640" height="480">
              {%- else -%}
                <div class="nt-card__img-placeholder">🌿</div>
              {%- endif -%}
            </div>
            <div class="nt-card__body">
              {%- if product.type != blank -%}
                <p class="nt-card__type">{{ product.type }}</p>
              {%- endif -%}
              <h3 class="nt-card__name">{{ product.title | escape }}</h3>
              {%- if short_desc != blank -%}
                <p class="nt-card__desc">{{ short_desc }}</p>
              {%- endif -%}
              {%- if product.variants.size > 1 -%}
                <div class="nt-pills" data-card-pills>
                  {%- for variant in product.variants -%}
                    <button class="nt-pill{% if forloop.first %} active{% endif %}"
                      data-vid="{{ variant.id }}"
                      data-price="{{ variant.price | money_without_currency }}"
                      data-duration="{{ variant.title | escape }}"
                      aria-label="Select {{ variant.title | escape }}">{{ variant.title | escape }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <div class="nt-card__footer">
                <div class="nt-card__price"><span>NPR</span><span class="nt-price-val">{{ product.price_min | money_without_currency }}</span></div>
                <button class="nt-book-btn nt-book-trigger"
                  data-variant="{{ product.selected_or_first_available_variant.id }}"
                  data-name="{{ product.title | escape }}"
                  data-price="{{ product.price_min | money_without_currency }}"
                  data-currency="NPR"
                  data-duration="{{ product.selected_or_first_available_variant.title | escape }}"
                  data-pid="{{ product.id }}"
                  aria-label="Book {{ product.title | escape }}">Book Now</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="nt-empty">
          <p style="font-size:32px;margin-bottom:12px">🌿</p>
          <p style="font-size:16px;font-weight:600;color:var(--nt-text)">No services available</p>
          <p style="font-size:13px;margin-top:6px">Check back soon for our full menu.</p>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if section.settings.show_why_section -%}
  <section class="nt-why">
    <div class="nt-why__inner">
      <div class="nt-why__heading">
        <h2>Why Choose Us</h2>
        <p>Experience authentic wellness in the heart of Kathmandu</p>
      </div>
      <div class="nt-why__grid">
        <div class="nt-why__card">
          <div class="nt-why__icon">🌿</div>
          <h3>Authentic Techniques</h3>
          <p>Certified therapists trained in traditional Thai healing arts with years of expertise.</p>
        </div>
        <div class="nt-why__card">
          <div class="nt-why__icon">✨</div>
          <h3>Premium Ingredients</h3>
          <p>Organic herbal blends and therapeutic-grade essential oils sourced sustainably.</p>
        </div>
        <div class="nt-why__card">
          <div class="nt-why__icon">🏡</div>
          <h3>Serene Environment</h3>
          <p>A tranquil sanctuary designed to restore balance of mind, body, and spirit.</p>
        </div>
        <div class="nt-why__card">
          <div class="nt-why__icon">💚</div>
          <h3>Personalised Care</h3>
          <p>Every session tailored to your unique needs, stress points, and wellness goals.</p>
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

<div class="nt-drawer-overlay" id="nt-overlay" aria-hidden="true"></div>
<div class="nt-drawer" id="nt-drawer" role="dialog" aria-modal="true" aria-label="Book a treatment">
  <div class="nt-drawer__handle"></div>
  <button class="nt-drawer__close" id="nt-drawer-close" aria-label="Close booking">&times;</button>
  <h2 class="nt-drawer__title">Book Your Treatment</h2>
  <p class="nt-drawer__subtitle">Complete your booking in 3 easy steps</p>
  <div class="nt-steps-indicator">
    <div class="nt-step-dot active" id="dot-1"></div>
    <div class="nt-step-dot" id="dot-2"></div>
    <div class="nt-step-dot" id="dot-3"></div>
  </div>
  <div class="nt-drawer__service">
    <span class="nt-drawer__service-name" id="nt-svc-name">—</span>
    <span class="nt-drawer__service-price" id="nt-svc-price">—</span>
  </div>
  <div class="nt-step active" id="nt-step-1">
    <p class="nt-step-label">Step 1 of 3 — Select Date</p>
    <div class="nt-chips" id="nt-date-chips"></div>
    <div class="nt-drawer__actions">
      <button class="nt-btn nt-btn--gold" id="nt-next-1">Next &rarr;</button>
    </div>
    <p class="nt-error" id="nt-err-1">Please select a date.</p>
  </div>
  <div class="nt-step" id="nt-step-2">
    <p class="nt-step-label">Step 2 of 3 — Select Time</p>
    <div class="nt-time-grid" id="nt-time-chips"></div>
    <div class="nt-drawer__actions">
      <button class="nt-btn nt-btn--outline" id="nt-back-2">&larr; Back</button>
      <button class="nt-btn nt-btn--gold" id="nt-next-2">Next &rarr;</button>
    </div>
    <p class="nt-error" id="nt-err-2">Please select a time slot.</p>
  </div>
  <div class="nt-step" id="nt-step-3">
    <p class="nt-step-label">Step 3 of 3 — Your Details</p>
    <div class="nt-form-group">
      <label for="nt-name">Full Name *</label>
      <input type="text" id="nt-name" placeholder="Your full name" autocomplete="name">
    </div>
    <div class="nt-form-group">
      <label for="nt-phone">Phone / WhatsApp *</label>
      <input type="tel" id="nt-phone" placeholder="+977 98XXXXXXXX" autocomplete="tel">
    </div>
    <div class="nt-form-group">
      <label for="nt-notes">Special Requests</label>
      <textarea id="nt-notes" rows="3" placeholder="Any preferences, health conditions, or requests…"></textarea>
    </div>
    <div class="nt-drawer__actions">
      <button class="nt-btn nt-btn--outline" id="nt-back-3">&larr; Back</button>
      <button class="nt-btn nt-btn--gold" id="nt-confirm">Proceed to Payment</button>
    </div>
    <p class="nt-error" id="nt-err-3"></p>
  </div>
</div>

<script>
(function(){
  var state={variantId:null,productName:'',price:'',currency:'NPR',duration:'',selectedDate:'',selectedTime:''};
  var overlay=document.getElementById('nt-overlay');
  var drawer=document.getElementById('nt-drawer');
  var currentStep=1;

  function openDrawer(){
    overlay.classList.add('open');
    drawer.classList.add('open');
    overlay.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';
  }
  function closeDrawer(){
    overlay.classList.remove('open');
    drawer.classList.remove('open');
    overlay.setAttribute('aria-hidden','true');
    document.body.style.overflow='';
  }
  function showStep(n){
    document.querySelectorAll('.nt-step').forEach(function(s){s.classList.remove('active');});
    document.querySelectorAll('.nt-step-dot').forEach(function(d,i){d.classList.toggle('active',i<n);});
    var el=document.getElementById('nt-step-'+n);
    if(el)el.classList.add('active');
    currentStep=n;
  }
  function hideError(id){var e=document.getElementById(id);if(e)e.classList.remove('show');}
  function showError(id,msg){var e=document.getElementById(id);if(e){e.textContent=msg;e.classList.add('show');}}

  function buildDates(){
    var wrap=document.getElementById('nt-date-chips');
    if(!wrap)return;
    wrap.innerHTML='';
    var today=new Date();
    var days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    for(var i=0;i<14;i++){
      var d=new Date(today);
      d.setDate(today.getDate()+i);
      var prefix=i===0?'Today ':i===1?'Tomorrow ':'';
      var label=prefix+days[d.getDay()]+' '+d.getDate()+' '+months[d.getMonth()];
      var val=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
      (function(v,l){
        var btn=document.createElement('button');
        btn.className='nt-chip';
        btn.textContent=l;
        btn.dataset.val=v;
        btn.addEventListener('click',function(){
          document.querySelectorAll('#nt-date-chips .nt-chip').forEach(function(c){c.classList.remove('selected');});
          this.classList.add('selected');
          state.selectedDate=this.dataset.val;
          hideError('nt-err-1');
        });
        wrap.appendChild(btn);
      })(val,label);
    }
  }

  function buildTimes(){
    var wrap=document.getElementById('nt-time-chips');
    if(!wrap)return;
    wrap.innerHTML='';
    var slots=['10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00','20:00'];
    slots.forEach(function(t){
      var btn=document.createElement('button');
      btn.className='nt-time-chip';
      btn.textContent=t;
      btn.dataset.val=t;
      btn.addEventListener('click',function(){
        document.querySelectorAll('#nt-time-chips .nt-time-chip').forEach(function(c){c.classList.remove('selected');});
        this.classList.add('selected');
        state.selectedTime=this.dataset.val;
        hideError('nt-err-2');
      });
      wrap.appendChild(btn);
    });
  }

  window.ntOpenBooking=function(variantId,name,price,currency,duration){
    state.variantId=variantId;
    state.productName=name;
    state.price=price;
    state.currency=currency||'NPR';
    state.duration=duration;
    state.selectedDate='';
    state.selectedTime='';
    var sn=document.getElementById('nt-svc-name');
    var sp=document.getElementById('nt-svc-price');
    if(sn)sn.textContent=name+(duration?' — '+duration:'');
    if(sp)sp.textContent=(currency||'NPR')+' '+price;
    var nameEl=document.getElementById('nt-name');
    var phoneEl=document.getElementById('nt-phone');
    var notesEl=document.getElementById('nt-notes');
    if(nameEl)nameEl.value='';
    if(phoneEl)phoneEl.value='';
    if(notesEl)notesEl.value='';
    ['nt-err-1','nt-err-2','nt-err-3'].forEach(hideError);
    document.querySelectorAll('#nt-date-chips .nt-chip.selected,#nt-time-chips .nt-time-chip.selected').forEach(function(c){c.classList.remove('selected');});
    showStep(1);
    openDrawer();
  };

  buildDates();
  buildTimes();

  var n1=document.getElementById('nt-next-1');
  if(n1)n1.addEventListener('click',function(){
    if(!state.selectedDate){showError('nt-err-1','Please select a date.');return;}
    hideError('nt-err-1');showStep(2);
  });
  var b2=document.getElementById('nt-back-2');
  if(b2)b2.addEventListener('click',function(){showStep(1);});
  var n2=document.getElementById('nt-next-2');
  if(n2)n2.addEventListener('click',function(){
    if(!state.selectedTime){showError('nt-err-2','Please select a time slot.');return;}
    hideError('nt-err-2');showStep(3);
  });
  var b3=document.getElementById('nt-back-3');
  if(b3)b3.addEventListener('click',function(){showStep(2);});

  function doCheckout(){
    var nameEl=document.getElementById('nt-name');
    var phoneEl=document.getElementById('nt-phone');
    var notesEl=document.getElementById('nt-notes');
    var name=nameEl?nameEl.value.trim():'';
    var phone=phoneEl?phoneEl.value.trim():'';
    var notes=notesEl?notesEl.value.trim():'';
    if(!name){showError('nt-err-3','Please enter your name.');return;}
    if(!phone){showError('nt-err-3','Please enter your phone number.');return;}
    hideError('nt-err-3');
    var confirmBtn=document.getElementById('nt-confirm');
    if(confirmBtn){confirmBtn.disabled=true;confirmBtn.textContent='Adding to cart\u2026';}
    var payload={items:[{quantity:1,id:parseInt(state.variantId,10),properties:{'Booking Date':state.selectedDate,'Time Slot':state.selectedTime,'Guest Name':name,'Phone/WhatsApp':phone,'Treatment':state.productName,'Duration':state.duration,'Special Requests':notes||'None'}}]};
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)})
      .then(function(r){
        if(!r.ok)return r.json().then(function(d){throw new Error(d.description||'Could not add to cart.');});
        return r.json();
      })
      .then(function(){
        window.location.href='/cart';
      })
      .catch(function(err){
        showError('nt-err-3',err.message||'Something went wrong. Please try again.');
        if(confirmBtn){confirmBtn.disabled=false;confirmBtn.textContent='Proceed to Payment';}
      });
  }

  var confirmBtn=document.getElementById('nt-confirm');
  if(confirmBtn)confirmBtn.addEventListener('click',doCheckout);

  var closeBtn=document.getElementById('nt-drawer-close');
  if(closeBtn)closeBtn.addEventListener('click',closeDrawer);
  if(overlay)overlay.addEventListener('click',closeDrawer);

  document.querySelectorAll('.nt-book-trigger').forEach(function(btn){
    btn.addEventListener('click',function(){
      ntOpenBooking(this.dataset.variant,this.dataset.name,this.dataset.price,this.dataset.currency,this.dataset.duration);
    });
  });

  document.querySelectorAll('[data-card-pills]').forEach(function(pillWrap){
    var card=pillWrap.closest('.nt-card');
    if(!card)return;
    var bookBtn=card.querySelector('.nt-book-trigger');
    var priceVal=card.querySelector('.nt-price-val');
    pillWrap.querySelectorAll('.nt-pill').forEach(function(pill){
      pill.addEventListener('click',function(){
        pillWrap.querySelectorAll('.nt-pill').forEach(function(p){p.classList.remove('active');});
        this.classList.add('active');
        if(bookBtn){
          bookBtn.dataset.variant=this.dataset.vid;
          bookBtn.dataset.price=this.dataset.price;
          bookBtn.dataset.duration=this.dataset.duration;
        }
        if(priceVal)priceVal.textContent=this.dataset.price;
      });
    });
  });

  var tabs=document.getElementById('nt-tabs');
  if(tabs){
    tabs.addEventListener('click',function(e){
      var tab=e.target.closest('.nt-tab');
      if(!tab)return;
      document.querySelectorAll('.nt-tab').forEach(function(t){t.classList.remove('active');t.setAttribute('aria-selected','false');});
      tab.classList.add('active');
      tab.setAttribute('aria-selected','true');
      var filter=tab.dataset.filter;
      document.querySelectorAll('#nt-grid .nt-card').forEach(function(card){
        if(filter==='all'||card.dataset.type===filter){card.removeAttribute('hidden');}
        else{card.setAttribute('hidden','');}
      });
    });
  }

  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target);}
      });
    },{threshold:0.08});
    document.querySelectorAll('.nt-card').forEach(function(c){io.observe(c);});
  } else {
    document.querySelectorAll('.nt-card').forEach(function(c){c.classList.add('visible');});
  }

  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&drawer.classList.contains('open'))closeDrawer();
  });
})();
</script>

