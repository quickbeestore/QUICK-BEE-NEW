{% comment %}
  ============================================================
  MISS PRETTY × Maybelline — Collection Section
  Assign this to any collection via:
    templates/collection.misspretty.json
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  /* ── RESET & SCOPE ─────────────────────────────────────── */
  .mp-wrap *, .mp-wrap *::before, .mp-wrap *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── CUSTOM PROPERTIES ─────────────────────────────────── */
  .mp-wrap {
    --mp-bg:          #0a0a0f;
    --mp-bg2:         #0f0f18;
    --mp-gold:        #d4a843;
    --mp-gold-lt:     #f0c76a;
    --mp-gold-dk:     #a8832e;
    --mp-pink:        #e8507a;
    --mp-pink-lt:     #f472a0;
    --mp-text:        #f0e8d5;
    --mp-muted:       #8a8090;
    --mp-card-bg:     rgba(255,255,255,0.04);
    --mp-card-br:     rgba(212,168,67,0.18);
    --mp-card-br-h:   rgba(212,168,67,0.55);
    --mp-radius:      16px;
    --mp-radius-sm:   8px;
    --mp-blur:        14px;

    font-family: 'Poppins', sans-serif;
    background: var(--mp-bg);
    color: var(--mp-text);
    position: relative;
    overflow: hidden;
  }

  /* ── BACKGROUND GLOW ───────────────────────────────────── */
  .mp-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 50% at 15% 0%,   rgba(232,80,122,0.08)  0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 100%, rgba(212,168,67,0.09)  0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 50% 50%,  rgba(255,140,80,0.04)  0%, transparent 70%);
    z-index: 0;
  }

  /* ── FLOATING PARTICLES ─────────────────────────────────── */
  .mp-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .mp-particles span {
    position: absolute;
    display: block;
    border-radius: 50%;
    animation: mp-float linear infinite;
    opacity: 0;
  }

  .mp-particles span:nth-child(1)  { width:4px; height:4px; left:8%;  background:var(--mp-gold);    animation-duration:13s; animation-delay:0s; }
  .mp-particles span:nth-child(2)  { width:3px; height:3px; left:20%; background:var(--mp-pink);    animation-duration:16s; animation-delay:2s; }
  .mp-particles span:nth-child(3)  { width:5px; height:5px; left:35%; background:var(--mp-gold-lt); animation-duration:11s; animation-delay:4s; }
  .mp-particles span:nth-child(4)  { width:2px; height:2px; left:50%; background:var(--mp-pink-lt); animation-duration:19s; animation-delay:1s; }
  .mp-particles span:nth-child(5)  { width:4px; height:4px; left:62%; background:var(--mp-gold);    animation-duration:14s; animation-delay:6s; }
  .mp-particles span:nth-child(6)  { width:3px; height:3px; left:75%; background:var(--mp-pink);    animation-duration:12s; animation-delay:3s; }
  .mp-particles span:nth-child(7)  { width:5px; height:5px; left:88%; background:var(--mp-gold-lt); animation-duration:17s; animation-delay:8s; }
  .mp-particles span:nth-child(8)  { width:2px; height:2px; left:14%; background:rgba(240,199,106,.6); animation-duration:21s; animation-delay:5s; }
  .mp-particles span:nth-child(9)  { width:4px; height:4px; left:55%; background:rgba(232,80,122,.6);  animation-duration:15s; animation-delay:7s; }
  .mp-particles span:nth-child(10) { width:3px; height:3px; left:42%; background:var(--mp-gold);    animation-duration:18s; animation-delay:9s; }

  @keyframes mp-float {
    0%   { transform: translateY(105%) scale(0); opacity: 0; }
    8%   { opacity: .8; }
    92%  { opacity: .3; }
    100% { transform: translateY(-5%) scale(1.2); opacity: 0; }
  }

  /* ── HERO ───────────────────────────────────────────────── */
  .mp-hero {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 64px 20px 48px;
  }

  .mp-hero-eyebrow {
    display: inline-block;
    font-size: .65rem;
    letter-spacing: .4em;
    text-transform: uppercase;
    color: var(--mp-pink);
    border: 1px solid rgba(232,80,122,.3);
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 18px;
    background: rgba(232,80,122,.05);
  }

  .mp-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.9rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .mp-brand-col {
    background: linear-gradient(135deg, var(--mp-gold), var(--mp-gold-lt), var(--mp-gold-dk));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .mp-brand-white {
    background: linear-gradient(135deg, #fff, #e0d4c0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .mp-x {
    color: var(--mp-pink);
    font-style: italic;
    margin: 0 6px;
    -webkit-text-fill-color: var(--mp-pink);
  }

  .mp-hero-sub {
    color: var(--mp-muted);
    font-size: .88rem;
    margin-bottom: 30px;
  }

  .mp-divider {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 320px;
    margin: 0 auto 28px;
  }

  .mp-divider::before,
  .mp-divider::after {
    content: '';
    flex: 1;
    height: 1px;
  }

  .mp-divider::before { background: linear-gradient(90deg, transparent, var(--mp-gold-dk)); }
  .mp-divider::after  { background: linear-gradient(90deg, var(--mp-gold-dk), transparent); }

  .mp-divider span { color: var(--mp-gold); font-size: 1.1rem; }

  .mp-stats {
    display: flex;
    justify-content: center;
    gap: 36px;
    flex-wrap: wrap;
  }

  .mp-stat-num {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--mp-gold);
  }

  .mp-stat-lbl {
    font-size: .62rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--mp-muted);
  }

  /* ── COLLECTION COUNT ───────────────────────────────────── */
  .mp-count-bar {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 20px 32px;
  }

  .mp-count-bar h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    background: linear-gradient(135deg, var(--mp-gold), var(--mp-gold-lt));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 6px;
  }

  .mp-count-bar p {
    color: var(--mp-muted);
    font-size: .8rem;
    letter-spacing: .06em;
  }

  /* ── SORT BAR ───────────────────────────────────────────── */
  .mp-sort-bar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px 18px;
  }

  .mp-sort-label {
    font-size: .72rem;
    color: var(--mp-muted);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .mp-sort-select {
    background: var(--mp-card-bg);
    border: 1px solid var(--mp-card-br);
    color: var(--mp-text);
    font-family: 'Poppins', sans-serif;
    font-size: .75rem;
    padding: 6px 12px;
    border-radius: var(--mp-radius-sm);
    cursor: pointer;
    backdrop-filter: blur(var(--mp-blur));
    -webkit-backdrop-filter: blur(var(--mp-blur));
    appearance: none;
    -webkit-appearance: none;
    outline: none;
    transition: border-color .2s;
  }

  .mp-sort-select:focus { border-color: var(--mp-gold); }

  /* ── PRODUCT GRID ───────────────────────────────────────── */
  .mp-grid-wrap {
    position: relative;
    z-index: 2;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px 72px;
  }

  .mp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1100px) { .mp-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px)  { .mp-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  @media (max-width: 420px)  { .mp-grid { grid-template-columns: 1fr; } }

  /* ── PRODUCT CARD ───────────────────────────────────────── */
  .mp-card {
    background: var(--mp-card-bg);
    border: 1px solid var(--mp-card-br);
    border-radius: var(--mp-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(var(--mp-blur));
    -webkit-backdrop-filter: blur(var(--mp-blur));
    transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s, border-color .3s;
    animation: mp-card-in .5s ease both;
    text-decoration: none;
    color: inherit;
  }

  .mp-card:hover {
    transform: scale(1.025) translateY(-3px);
    box-shadow: 0 12px 48px rgba(212,168,67,.22), 0 4px 20px rgba(0,0,0,.4);
    border-color: var(--mp-card-br-h);
  }

  @keyframes mp-card-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── CARD IMAGE ─────────────────────────────────────────── */
  .mp-card-img {
    position: relative;
    height: 200px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .mp-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform .4s ease;
  }

  .mp-card:hover .mp-card-img img { transform: scale(1.06); }

  .mp-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(10,10,15,.85) 100%);
    pointer-events: none;
  }

  /* placeholder when no image */
  .mp-card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
  }

  .mp-placeholder-icon { font-size: 2.2rem; }

  .mp-placeholder-name {
    font-family: 'Playfair Display', serif;
    font-size: .7rem;
    font-weight: 600;
    color: rgba(255,255,255,.8);
    line-height: 1.35;
    text-shadow: 0 1px 4px rgba(0,0,0,.5);
  }

  /* category tints */
  .mp-cat-foundation  { background: linear-gradient(145deg, rgba(220,170,130,.3), rgba(180,130,100,.4)); }
  .mp-cat-mascara     { background: linear-gradient(145deg, rgba(20,20,50,.65),   rgba(40,30,70,.55)); }
  .mp-cat-lip         { background: linear-gradient(145deg, rgba(180,50,80,.38),  rgba(140,30,60,.45)); }
  .mp-cat-concealer   { background: linear-gradient(145deg, rgba(200,170,150,.32),rgba(180,150,130,.38)); }
  .mp-cat-highlighter { background: linear-gradient(145deg, rgba(230,200,100,.32),rgba(200,160,60,.38)); }
  .mp-cat-powder      { background: linear-gradient(145deg, rgba(200,160,140,.28),rgba(180,140,120,.32)); }
  .mp-cat-primer      { background: linear-gradient(145deg, rgba(120,160,200,.32),rgba(100,140,180,.38)); }
  .mp-cat-eyeliner    { background: linear-gradient(145deg, rgba(15,15,35,.7),    rgba(30,20,50,.6)); }
  .mp-cat-blush       { background: linear-gradient(145deg, rgba(220,130,150,.32),rgba(200,100,130,.38)); }
  .mp-cat-default     { background: linear-gradient(145deg, rgba(100,160,190,.3), rgba(80,140,170,.38)); }

  /* ── BADGES ─────────────────────────────────────────────── */
  .mp-badge-wrap {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .mp-badge {
    display: inline-block;
    font-size: .56rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    line-height: 1.4;
  }

  .mp-badge--limited {
    background: linear-gradient(135deg, #c0392b, var(--mp-pink));
    color: #fff;
    box-shadow: 0 2px 10px rgba(200,50,80,.4);
  }

  .mp-badge--sale {
    background: linear-gradient(135deg, var(--mp-gold-dk), var(--mp-gold));
    color: #1a0e00;
    box-shadow: 0 2px 10px rgba(212,168,67,.35);
  }

  /* ── CARD BODY ──────────────────────────────────────────── */
  .mp-card-body {
    padding: 14px 14px 10px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
  }

  .mp-card-name {
    font-family: 'Playfair Display', serif;
    font-size: .88rem;
    font-weight: 600;
    color: var(--mp-gold-lt);
    line-height: 1.35;
    min-height: 2.7em;
  }

  .mp-pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .mp-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--mp-gold);
    letter-spacing: .02em;
  }

  .mp-compare {
    font-size: .78rem;
    color: var(--mp-muted);
    text-decoration: line-through;
  }

  .mp-disc-tag {
    font-size: .62rem;
    background: rgba(212,168,67,.12);
    color: var(--mp-gold);
    padding: 2px 7px;
    border-radius: 10px;
    font-weight: 600;
    border: 1px solid rgba(212,168,67,.22);
  }

  /* ── SCAN LABEL ─────────────────────────────────────────── */
  .mp-scan-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 14px;
    border: 1.5px solid var(--mp-gold);
    border-radius: var(--mp-radius-sm);
    background: linear-gradient(135deg, rgba(212,168,67,.1), rgba(240,199,106,.06));
    color: var(--mp-gold);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* ── CARD FOOTER ────────────────────────────────────────── */
  .mp-card-foot {
    padding: 10px 14px 12px;
    border-top: 1px solid rgba(255,255,255,.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .mp-store-lbl {
    font-size: .56rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--mp-muted);
  }

  /* ── QR PLACEHOLDER ─────────────────────────────────────── */
  .mp-qr-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }

  .mp-qr {
    width: 44px;
    height: 44px;
    background: #fff;
    padding: 3px;
    border-radius: 3px;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    flex-shrink: 0;
  }

  .mp-qr-cell       { border-radius: .5px; }
  .mp-qr-cell.dark  { background: #111; }
  .mp-qr-cell.light { background: #fff; }

  .mp-qr-store {
    font-size: .5rem;
    color: var(--mp-muted);
    letter-spacing: .08em;
    white-space: nowrap;
  }

  /* ── EMPTY STATE ────────────────────────────────────────── */
  .mp-empty {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 20px;
    color: var(--mp-muted);
    font-size: .9rem;
  }

  /* ── PAGINATION ─────────────────────────────────────────── */
  .mp-pagination {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 0 20px 56px;
    flex-wrap: wrap;
  }

  .mp-page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 12px;
    border: 1px solid var(--mp-card-br);
    border-radius: var(--mp-radius-sm);
    background: var(--mp-card-bg);
    color: var(--mp-muted);
    text-decoration: none;
    font-size: .78rem;
    font-weight: 500;
    transition: border-color .2s, color .2s, background .2s;
    backdrop-filter: blur(var(--mp-blur));
  }

  .mp-page-link:hover,
  .mp-page-link.current {
    border-color: var(--mp-gold);
    color: var(--mp-gold);
    background: rgba(212,168,67,.08);
  }

  /* ── SCROLLBAR ──────────────────────────────────────────── */
  .mp-wrap ::-webkit-scrollbar { width: 5px; }
  .mp-wrap ::-webkit-scrollbar-track { background: var(--mp-bg); }
  .mp-wrap ::-webkit-scrollbar-thumb { background: var(--mp-gold-dk); border-radius: 3px; }

  /* ── MOBILE ─────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .mp-hero { padding: 44px 16px 36px; }
    .mp-stats { gap: 20px; }
    .mp-card-img { height: 160px; }
    .mp-grid-wrap { padding: 0 12px 56px; }
  }
</style>

{%- assign mp_products = collection.products -%}
{%- assign mp_count    = collection.products_count -%}

<div class="mp-wrap" id="mp-collection">

  <!-- Background glow -->
  <div class="mp-bg-glow" aria-hidden="true"></div>

  <!-- Floating particles -->
  <div class="mp-particles" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <div class="mp-hero">
    <div class="mp-hero-eyebrow">Exclusive Collection 2025</div>
    <h1>
      <span class="mp-brand-white">Maybelline</span>
      <span class="mp-x">×</span>
      <span class="mp-brand-col">MISS PRETTY</span>
    </h1>
    <p class="mp-hero-sub">Premium beauty essentials · Authentic · Delivered fast</p>
    <div class="mp-divider"><span>✦</span></div>
    <div class="mp-stats">
      <div><span class="mp-stat-num">{{ mp_count }}</span><span class="mp-stat-lbl">Products</span></div>
      <div><span class="mp-stat-num">100%</span><span class="mp-stat-lbl">Authentic</span></div>
      <div><span class="mp-stat-num">⚡</span><span class="mp-stat-lbl">Fast Delivery</span></div>
      <div><span class="mp-stat-num">★ 4.9</span><span class="mp-stat-lbl">Rated</span></div>
    </div>
  </div>

  <!-- ── SECTION HEADING ────────────────────────────────────── -->
  <div class="mp-count-bar">
    <h2>{{ collection.title }}</h2>
    <p>Scan any product's QR to order instantly via QuickBee.store</p>
  </div>

  <!-- ── SORT BAR ──────────────────────────────────────────── -->
  <div class="mp-sort-bar">
    <span class="mp-sort-label">Sort:</span>
    <select class="mp-sort-select" id="mp-sort" aria-label="Sort products">
      <option value="">Default</option>
      <option value="price-asc">Price: Low → High</option>
      <option value="price-desc">Price: High → Low</option>
      <option value="title-asc">Name: A → Z</option>
    </select>
  </div>

  <!-- ── PRODUCT GRID ───────────────────────────────────────── -->
  {%- if mp_count > 0 -%}
    {%- paginate collection.products by 48 -%}
      <div class="mp-grid-wrap">
        <div class="mp-grid" id="mp-grid">

          {%- for product in collection.products -%}
            {%- assign pp = product.price -%}
            {%- assign cp = product.compare_at_price -%}
            {%- assign disc = 0 -%}
            {%- if cp > pp -%}
              {%- assign diff = cp | minus: pp -%}
              {%- assign disc = diff | times: 100 | divided_by: cp -%}
            {%- endif -%}

            {%- comment -%} Category detection via product type or tags {%- endcomment -%}
            {%- assign mp_type = product.type | downcase -%}
            {%- assign mp_title_lc = product.title | downcase -%}
            {%- if mp_title_lc contains 'foundation' or mp_title_lc contains 'bb cream' or mp_title_lc contains 'glow' or mp_title_lc contains 'dewy' or mp_title_lc contains 'lumi' -%}
              {%- assign mp_cat = 'foundation' -%}
              {%- assign mp_icon = '🌟' -%}
            {%- elsif mp_title_lc contains 'mascara' -%}
              {%- assign mp_cat = 'mascara' -%}
              {%- assign mp_icon = '✨' -%}
            {%- elsif mp_title_lc contains 'lip' or mp_title_lc contains 'lipstick' or mp_title_lc contains 'tint' or mp_title_lc contains 'gloss' or mp_title_lc contains 'crayon' or mp_title_lc contains 'teddy' or mp_title_lc contains 'ink' -%}
              {%- assign mp_cat = 'lip' -%}
              {%- assign mp_icon = '💄' -%}
            {%- elsif mp_title_lc contains 'concealer' -%}
              {%- assign mp_cat = 'concealer' -%}
              {%- assign mp_icon = '🌸' -%}
            {%- elsif mp_title_lc contains 'highlighter' or mp_title_lc contains 'chrome' -%}
              {%- assign mp_cat = 'highlighter' -%}
              {%- assign mp_icon = '✨' -%}
            {%- elsif mp_title_lc contains 'powder' -%}
              {%- assign mp_cat = 'powder' -%}
              {%- assign mp_icon = '🌷' -%}
            {%- elsif mp_title_lc contains 'primer' or mp_title_lc contains 'pore eraser' or mp_title_lc contains 'jelly' -%}
              {%- assign mp_cat = 'primer' -%}
              {%- assign mp_icon = '💎' -%}
            {%- elsif mp_title_lc contains 'eyeliner' -%}
              {%- assign mp_cat = 'eyeliner' -%}
              {%- assign mp_icon = '🖋' -%}
            {%- elsif mp_title_lc contains 'blush' or mp_title_lc contains 'cheek' -%}
              {%- assign mp_cat = 'blush' -%}
              {%- assign mp_icon = '🌹' -%}
            {%- else -%}
              {%- assign mp_cat = 'default' -%}
              {%- assign mp_icon = '💫' -%}
            {%- endif -%}

            <a
              href="{{ product.url }}"
              class="mp-card"
              style="animation-delay: {{ forloop.index0 | times: 0.04 }}s"
              aria-label="{{ product.title | escape }}"
              data-price="{{ pp }}"
              data-title="{{ product.title | escape }}"
            >
              <!-- IMAGE -->
              <div class="mp-card-img mp-cat-{{ mp_cat }}">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="500"
                    height="500"
                  >
                {%- else -%}
                  <div class="mp-card-img-placeholder">
                    <div class="mp-placeholder-icon">{{ mp_icon }}</div>
                    <div class="mp-placeholder-name">{{ product.title | remove: 'Maybelline ' }}</div>
                  </div>
                {%- endif -%}

                <!-- BADGES -->
                <div class="mp-badge-wrap">
                  <span class="mp-badge mp-badge--limited">Limited Offer</span>
                  {%- if disc >= 10 -%}
                    <span class="mp-badge mp-badge--sale">{{ disc }}% OFF</span>
                  {%- endif -%}
                </div>
              </div>

              <!-- BODY -->
              <div class="mp-card-body">
                <div class="mp-card-name">{{ product.title }}</div>

                <div class="mp-pricing">
                  <span class="mp-price">Rs {{ pp | divided_by: 100 }}</span>
                  {%- if cp > pp -%}
                    <span class="mp-compare">Rs {{ cp | divided_by: 100 }}</span>
                    {%- if disc >= 5 -%}
                      <span class="mp-disc-tag">{{ disc }}% OFF</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <div class="mp-scan-label">
                  <span>📲</span> SCAN TO ORDER
                </div>
              </div>

              <!-- FOOTER -->
              <div class="mp-card-foot">
                <span class="mp-store-lbl">Maybelline × Miss Pretty</span>
                <div class="mp-qr-wrap">
                  <div class="mp-qr" data-seed="{{ forloop.index }}"></div>
                  <div class="mp-qr-store">QUICKBEE.STORE</div>
                </div>
              </div>
            </a>

          {%- endfor -%}
        </div>
      </div>

      <!-- ── PAGINATION ───────────────────────────────────── -->
      {%- if paginate.pages > 1 -%}
        <div class="mp-pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="mp-page-link">‹ Prev</a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="mp-page-link">{{ part.title }}</a>
            {%- else -%}
              <span class="mp-page-link current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="mp-page-link">Next ›</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- endpaginate -%}

  {%- else -%}
    <div class="mp-empty">
      <p>No products in this collection yet.</p>
    </div>
  {%- endif -%}

</div><!-- /.mp-wrap -->

<script>
  (function () {
    /* ── QR PLACEHOLDER BUILDER ──────────────────────────── */
    function seededRand(seed) {
      var s = seed;
      return function () {
        s = (s * 1664525 + 1013904223) & 0xffffffff;
        return (s >>> 0) / 0xffffffff;
      };
    }

    document.querySelectorAll('.mp-qr[data-seed]').forEach(function (el) {
      var seed = parseInt(el.dataset.seed, 10) || 1;
      var rand = seededRand(seed * 997 + 13);
      for (var i = 0; i < 49; i++) {
        var row = Math.floor(i / 7);
        var col = i % 7;
        var cell = document.createElement('span');
        cell.className = 'mp-qr-cell';
        var dark = rand() > 0.45;
        // Corner finder squares
        if ((row < 2 && col < 2) || (row < 2 && col > 4) || (row > 4 && col < 2)) {
          dark = (row === 0 || row === 1 || col === 0 || col === 1 ||
                  (row === 1 && col === 1));
        }
        cell.classList.add(dark ? 'dark' : 'light');
        el.appendChild(cell);
      }
    });

    /* ── SORT ────────────────────────────────────────────── */
    var sortSel = document.getElementById('mp-sort');
    var grid    = document.getElementById('mp-grid');
    if (sortSel && grid) {
      sortSel.addEventListener('change', function () {
        var cards = Array.from(grid.querySelectorAll('.mp-card'));
        var val   = sortSel.value;
        cards.sort(function (a, b) {
          if (val === 'price-asc')  return parseInt(a.dataset.price) - parseInt(b.dataset.price);
          if (val === 'price-desc') return parseInt(b.dataset.price) - parseInt(a.dataset.price);
          if (val === 'title-asc')  return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          return 0;
        });
        cards.forEach(function (c) { grid.appendChild(c); });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Miss Pretty Collection",
  "tag": "section",
  "class": "misspretty-collection",
  "settings": [],
  "presets": [
    {
      "name": "Miss Pretty Collection"
    }
  ]
}
{% endschema %}
