{% comment %}
  MISS PRETTY × Maybelline — Collection Section
  Template: collection.misspretty.json
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  .mp-wrap *, .mp-wrap *::before, .mp-wrap *::after {
    box-sizing: border-box; margin: 0; padding: 0;
  }

  .mp-wrap {
    --mp-bg:        #0a0a0f;
    --mp-gold:      #d4a843;
    --mp-gold-lt:   #f0c76a;
    --mp-gold-dk:   #a8832e;
    --mp-pink:      #e8507a;
    --mp-pink-lt:   #f472a0;
    --mp-text:      #f0e8d5;
    --mp-muted:     #8a8090;
    --mp-card-bg:   rgba(255,255,255,0.04);
    --mp-card-br:   rgba(212,168,67,0.18);
    --mp-card-br-h: rgba(212,168,67,0.55);
    --mp-radius:    16px;
    --mp-radius-sm: 8px;
    --mp-blur:      14px;
    font-family: 'Poppins', sans-serif;
    background: var(--mp-bg);
    color: var(--mp-text);
    position: relative;
    overflow: hidden;
  }

  /* BG GLOW */
  .mp-bg-glow {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background:
      radial-gradient(ellipse 80% 50% at 15% 0%,   rgba(232,80,122,0.08)  0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 100%, rgba(212,168,67,0.09)  0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 50% 50%,  rgba(255,140,80,0.04)  0%, transparent 70%);
  }

  /* PARTICLES */
  .mp-particles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 1; }
  .mp-particles span { position: absolute; display: block; border-radius: 50%; animation: mp-float linear infinite; opacity: 0; }
  .mp-particles span:nth-child(1)  { width:4px;height:4px;left:8%;  background:var(--mp-gold);   animation-duration:13s;animation-delay:0s; }
  .mp-particles span:nth-child(2)  { width:3px;height:3px;left:22%; background:var(--mp-pink);   animation-duration:16s;animation-delay:2s; }
  .mp-particles span:nth-child(3)  { width:5px;height:5px;left:37%; background:var(--mp-gold-lt);animation-duration:11s;animation-delay:4s; }
  .mp-particles span:nth-child(4)  { width:2px;height:2px;left:52%; background:var(--mp-pink-lt);animation-duration:19s;animation-delay:1s; }
  .mp-particles span:nth-child(5)  { width:4px;height:4px;left:63%; background:var(--mp-gold);   animation-duration:14s;animation-delay:6s; }
  .mp-particles span:nth-child(6)  { width:3px;height:3px;left:76%; background:var(--mp-pink);   animation-duration:12s;animation-delay:3s; }
  .mp-particles span:nth-child(7)  { width:5px;height:5px;left:88%; background:var(--mp-gold-lt);animation-duration:17s;animation-delay:8s; }
  .mp-particles span:nth-child(8)  { width:2px;height:2px;left:14%; background:rgba(240,199,106,.6);animation-duration:21s;animation-delay:5s; }
  @keyframes mp-float {
    0%   { transform:translateY(105%) scale(0); opacity:0; }
    8%   { opacity:.8; }
    92%  { opacity:.3; }
    100% { transform:translateY(-5%) scale(1.2); opacity:0; }
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .mp-hero {
    position: relative; z-index: 2;
    text-align: center; padding: 64px 20px 48px;
  }
  .mp-hero-eyebrow {
    display: inline-block; font-size: .63rem; letter-spacing: .42em;
    text-transform: uppercase; color: var(--mp-pink);
    border: 1px solid rgba(232,80,122,.3); padding: 5px 16px;
    border-radius: 20px; margin-bottom: 20px; background: rgba(232,80,122,.05);
  }
  .mp-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5.5vw, 4.2rem);
    font-weight: 800; line-height: 1.1; margin-bottom: 14px;
  }
  .mp-brand-col {
    background: linear-gradient(135deg, var(--mp-gold), var(--mp-gold-lt), var(--mp-gold-dk));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .mp-brand-white {
    background: linear-gradient(135deg, #fff, #e0d4c0);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .mp-x { color: var(--mp-pink); font-style: italic; margin: 0 8px; -webkit-text-fill-color: var(--mp-pink); }
  .mp-hero-sub { color: var(--mp-muted); font-size: .9rem; margin-bottom: 32px; }
  .mp-divider {
    display: flex; align-items: center; gap: 14px;
    max-width: 320px; margin: 0 auto 28px;
  }
  .mp-divider::before { content:''; flex:1; height:1px; background:linear-gradient(90deg,transparent,var(--mp-gold-dk)); }
  .mp-divider::after  { content:''; flex:1; height:1px; background:linear-gradient(90deg,var(--mp-gold-dk),transparent); }
  .mp-divider span { color: var(--mp-gold); font-size: 1.1rem; }
  .mp-stats { display:flex; justify-content:center; gap:40px; flex-wrap:wrap; }
  .mp-stat-num { display:block; font-family:'Playfair Display',serif; font-size:1.7rem; font-weight:700; color:var(--mp-gold); }
  .mp-stat-lbl { font-size:.6rem; letter-spacing:.22em; text-transform:uppercase; color:var(--mp-muted); }

  /* ── CATEGORY FILTER BAR ──────────────────────────────────── */
  .mp-filter-section {
    position: relative; z-index: 2;
    padding: 0 20px 10px;
  }
  .mp-filter-title {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    background: linear-gradient(135deg, var(--mp-gold), var(--mp-gold-lt));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 6px;
  }
  .mp-filter-sub {
    text-align: center; color: var(--mp-muted);
    font-size: .8rem; margin-bottom: 28px;
  }
  .mp-filter-bar {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px; max-width: 900px; margin: 0 auto 36px;
  }
  .mp-filter-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 20px;
    background: var(--mp-card-bg);
    border: 1px solid var(--mp-card-br);
    border-radius: 40px;
    color: var(--mp-muted);
    font-family: 'Poppins', sans-serif;
    font-size: .72rem; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(var(--mp-blur));
    -webkit-backdrop-filter: blur(var(--mp-blur));
    transition: all .22s ease;
    white-space: nowrap;
  }
  .mp-filter-btn .mp-filter-icon { font-size: .95rem; }
  .mp-filter-btn .mp-filter-count {
    background: rgba(255,255,255,.07);
    border-radius: 10px; padding: 1px 7px;
    font-size: .6rem; color: var(--mp-muted);
    transition: all .22s;
  }
  .mp-filter-btn:hover {
    border-color: rgba(212,168,67,.4);
    color: var(--mp-gold-lt);
    background: rgba(212,168,67,.06);
  }
  .mp-filter-btn:hover .mp-filter-count { color: var(--mp-gold); }
  .mp-filter-btn.active {
    background: linear-gradient(135deg, rgba(212,168,67,.18), rgba(240,199,106,.1));
    border-color: var(--mp-gold);
    color: var(--mp-gold-lt);
    box-shadow: 0 0 20px rgba(212,168,67,.15), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .mp-filter-btn.active .mp-filter-count {
    background: rgba(212,168,67,.2);
    color: var(--mp-gold);
  }

  /* ── TOOLBAR (count + sort) ───────────────────────────────── */
  .mp-toolbar {
    position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    max-width: 1320px; margin: 0 auto;
    padding: 0 20px 18px; gap: 12px; flex-wrap: wrap;
  }
  .mp-result-count {
    font-size: .78rem; color: var(--mp-muted); letter-spacing: .06em;
  }
  .mp-result-count strong { color: var(--mp-gold-lt); font-weight: 600; }
  .mp-sort-wrap { display:flex; align-items:center; gap:8px; }
  .mp-sort-label { font-size:.72rem; color:var(--mp-muted); letter-spacing:.1em; text-transform:uppercase; }
  .mp-sort-select {
    background: var(--mp-card-bg);
    border: 1px solid var(--mp-card-br);
    color: var(--mp-text);
    font-family: 'Poppins', sans-serif; font-size:.75rem;
    padding: 7px 14px; border-radius: var(--mp-radius-sm);
    cursor: pointer;
    backdrop-filter: blur(var(--mp-blur)); -webkit-backdrop-filter: blur(var(--mp-blur));
    appearance: none; -webkit-appearance: none; outline: none;
    transition: border-color .2s;
  }
  .mp-sort-select:focus { border-color: var(--mp-gold); }

  /* ── PRODUCT GRID ─────────────────────────────────────────── */
  .mp-grid-wrap {
    position: relative; z-index: 2;
    max-width: 1320px; margin: 0 auto; padding: 0 20px 80px;
  }
  .mp-grid {
    display: grid; grid-template-columns: repeat(4,1fr); gap: 20px;
  }
  @media (max-width: 1100px) { .mp-grid { grid-template-columns: repeat(3,1fr); } }
  @media (max-width: 760px)  { .mp-grid { grid-template-columns: repeat(2,1fr); gap:14px; } }
  @media (max-width: 420px)  { .mp-grid { grid-template-columns: 1fr; } }

  /* hidden by filter */
  .mp-card.mp-hidden { display: none; }

  /* ── CARD ─────────────────────────────────────────────────── */
  .mp-card {
    background: var(--mp-card-bg);
    border: 1px solid var(--mp-card-br);
    border-radius: var(--mp-radius);
    overflow: hidden; display: flex; flex-direction: column;
    backdrop-filter: blur(var(--mp-blur)); -webkit-backdrop-filter: blur(var(--mp-blur));
    transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s, border-color .3s;
    animation: mp-card-in .5s ease both;
    text-decoration: none; color: inherit;
  }
  .mp-card:hover {
    transform: scale(1.025) translateY(-4px);
    box-shadow: 0 16px 52px rgba(212,168,67,.2), 0 4px 20px rgba(0,0,0,.45);
    border-color: var(--mp-card-br-h);
  }
  @keyframes mp-card-in {
    from { opacity:0; transform:translateY(22px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* IMAGE */
  .mp-card-img {
    position: relative; height: 220px;
    overflow: hidden; flex-shrink: 0;
  }
  .mp-card-img img {
    width:100%; height:100%; object-fit:cover; object-position:center;
    display:block; transition: transform .45s ease;
  }
  .mp-card:hover .mp-card-img img { transform: scale(1.07); }
  .mp-card-img::after {
    content:''; position:absolute; inset:0; pointer-events:none;
    background: linear-gradient(180deg, transparent 40%, rgba(10,10,15,.9) 100%);
  }

  /* placeholder */
  .mp-card-img-placeholder {
    width:100%; height:100%;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:10px; padding:18px; text-align:center;
  }
  .mp-ph-icon { font-size:2.6rem; }
  .mp-ph-name {
    font-family:'Playfair Display',serif; font-size:.72rem; font-weight:600;
    color:rgba(255,255,255,.82); line-height:1.35; text-shadow:0 1px 4px rgba(0,0,0,.5);
  }

  /* category tints */
  .mp-cat-foundation  { background:linear-gradient(145deg,rgba(220,170,130,.32),rgba(180,130,100,.42)); }
  .mp-cat-mascara     { background:linear-gradient(145deg,rgba(20,20,50,.68),   rgba(40,30,70,.58)); }
  .mp-cat-lip         { background:linear-gradient(145deg,rgba(180,50,80,.4),   rgba(140,30,60,.48)); }
  .mp-cat-concealer   { background:linear-gradient(145deg,rgba(200,170,150,.34),rgba(180,150,130,.4)); }
  .mp-cat-highlighter { background:linear-gradient(145deg,rgba(230,200,100,.34),rgba(200,160,60,.4)); }
  .mp-cat-powder      { background:linear-gradient(145deg,rgba(200,160,140,.3), rgba(180,140,120,.35)); }
  .mp-cat-primer      { background:linear-gradient(145deg,rgba(120,160,200,.34),rgba(100,140,180,.4)); }
  .mp-cat-eyeliner    { background:linear-gradient(145deg,rgba(15,15,35,.72),   rgba(30,20,50,.62)); }
  .mp-cat-blush       { background:linear-gradient(145deg,rgba(220,130,150,.34),rgba(200,100,130,.4)); }
  .mp-cat-default     { background:linear-gradient(145deg,rgba(100,160,190,.32),rgba(80,140,170,.4)); }

  /* BADGES */
  .mp-badge-wrap {
    position:absolute; top:10px; left:10px; z-index:10;
    display:flex; flex-direction:column; gap:5px;
  }
  .mp-badge {
    display:inline-block; font-size:.55rem; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase;
    padding:3px 10px; border-radius:20px; line-height:1.4;
  }
  .mp-badge--limited {
    background:linear-gradient(135deg,#c0392b,var(--mp-pink));
    color:#fff; box-shadow:0 2px 10px rgba(200,50,80,.4);
  }
  .mp-badge--sale {
    background:linear-gradient(135deg,var(--mp-gold-dk),var(--mp-gold));
    color:#1a0e00; box-shadow:0 2px 10px rgba(212,168,67,.35);
  }

  /* category chip on image bottom */
  .mp-cat-chip {
    position:absolute; bottom:10px; right:10px; z-index:10;
    font-size:.55rem; letter-spacing:.12em; text-transform:uppercase;
    padding:3px 10px; border-radius:20px; font-weight:600;
    background:rgba(10,10,15,.7); color:var(--mp-muted);
    border:1px solid rgba(255,255,255,.08);
    backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
  }

  /* CARD BODY */
  .mp-card-body {
    padding:16px 16px 14px;
    display:flex; flex-direction:column; flex:1; gap:10px;
  }
  .mp-card-name {
    font-family:'Playfair Display',serif;
    font-size:.9rem; font-weight:600; color:var(--mp-gold-lt);
    line-height:1.38; min-height:2.76em;
  }
  .mp-pricing {
    display:flex; align-items:center; gap:8px; flex-wrap:wrap;
  }
  .mp-price {
    font-size:1.1rem; font-weight:700;
    color:var(--mp-gold); letter-spacing:.02em;
  }
  .mp-compare {
    font-size:.8rem; color:var(--mp-muted); text-decoration:line-through;
  }
  .mp-disc-tag {
    font-size:.6rem; font-weight:700;
    background:rgba(212,168,67,.12); color:var(--mp-gold);
    padding:2px 8px; border-radius:10px;
    border:1px solid rgba(212,168,67,.24);
  }

  /* ADD TO CART BUTTON */
  .mp-atc {
    display:flex; align-items:center; justify-content:center; gap:8px;
    padding:11px 16px; border:none; border-radius:var(--mp-radius-sm);
    background:linear-gradient(135deg,var(--mp-gold-dk),var(--mp-gold),var(--mp-gold-lt));
    background-size:200% 200%; background-position:0% 50%;
    color:#1a0e00; font-family:'Poppins',sans-serif;
    font-size:.72rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
    cursor:pointer; width:100%; margin-top:auto;
    transition:background-position .35s ease, box-shadow .25s, transform .15s;
    box-shadow:0 4px 18px rgba(212,168,67,.25);
  }
  .mp-atc:hover {
    background-position:100% 50%;
    box-shadow:0 6px 28px rgba(212,168,67,.45);
    transform:translateY(-1px);
  }
  .mp-atc:active { transform:translateY(0); }
  .mp-atc svg { width:14px; height:14px; fill:currentColor; flex-shrink:0; }

  /* EMPTY / NO RESULTS */
  .mp-empty, .mp-no-results {
    position:relative; z-index:2;
    text-align:center; padding:80px 20px;
  }
  .mp-no-results {
    display:none; flex-direction:column; align-items:center; gap:14px;
  }
  .mp-no-results.show { display:flex; }
  .mp-no-results-icon { font-size:3rem; }
  .mp-no-results p { color:var(--mp-muted); font-size:.9rem; }
  .mp-no-results button {
    margin-top:4px; padding:8px 22px;
    background:transparent; border:1px solid var(--mp-card-br);
    border-radius:var(--mp-radius-sm); color:var(--mp-gold);
    font-family:'Poppins',sans-serif; font-size:.72rem; cursor:pointer;
    transition:border-color .2s, background .2s;
  }
  .mp-no-results button:hover { border-color:var(--mp-gold); background:rgba(212,168,67,.08); }

  /* PAGINATION */
  .mp-pagination {
    position:relative; z-index:2;
    display:flex; justify-content:center; gap:8px;
    padding:0 20px 60px; flex-wrap:wrap;
  }
  .mp-page-link {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:40px; height:40px; padding:0 14px;
    border:1px solid var(--mp-card-br); border-radius:var(--mp-radius-sm);
    background:var(--mp-card-bg); color:var(--mp-muted);
    text-decoration:none; font-size:.78rem; font-weight:500;
    transition:all .2s; backdrop-filter:blur(var(--mp-blur));
  }
  .mp-page-link:hover, .mp-page-link.current {
    border-color:var(--mp-gold); color:var(--mp-gold);
    background:rgba(212,168,67,.08);
  }

  /* SCROLLBAR */
  .mp-wrap ::-webkit-scrollbar { width:5px; }
  .mp-wrap ::-webkit-scrollbar-track { background:var(--mp-bg); }
  .mp-wrap ::-webkit-scrollbar-thumb { background:var(--mp-gold-dk); border-radius:3px; }

  /* MOBILE */
  @media (max-width:600px) {
    .mp-hero { padding:44px 16px 36px; }
    .mp-stats { gap:22px; }
    .mp-card-img { height:180px; }
    .mp-grid-wrap { padding:0 12px 60px; }
    .mp-filter-bar { gap:8px; }
    .mp-filter-btn { padding:7px 14px; font-size:.68rem; }
  }
</style>

{%- assign mp_count = collection.products_count -%}

<div class="mp-wrap" id="mp-collection">

  <div class="mp-bg-glow" aria-hidden="true"></div>
  <div class="mp-particles" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <div class="mp-hero">
    <div class="mp-hero-eyebrow">Exclusive Collection 2025</div>
    <h1>
      <span class="mp-brand-white">Maybelline</span>
      <span class="mp-x">×</span>
      <span class="mp-brand-col">MISS PRETTY</span>
    </h1>
    <p class="mp-hero-sub">Premium beauty essentials &nbsp;·&nbsp; 100% Authentic &nbsp;·&nbsp; Delivered fast</p>
    <div class="mp-divider"><span>✦</span></div>
    <div class="mp-stats">
      <div><span class="mp-stat-num">{{ mp_count }}</span><span class="mp-stat-lbl">Products</span></div>
      <div><span class="mp-stat-num">100%</span><span class="mp-stat-lbl">Authentic</span></div>
      <div><span class="mp-stat-num">⚡</span><span class="mp-stat-lbl">Fast Delivery</span></div>
      <div><span class="mp-stat-num">★ 4.9</span><span class="mp-stat-lbl">Rated</span></div>
    </div>
  </div>

  <!-- ── CATEGORY FILTER ───────────────────────────────────── -->
  {%- if mp_count > 0 -%}
  {%- paginate collection.products by 100 -%}

  {%- comment -%} Count per category {%- endcomment -%}
  {%- assign cnt_all = 0 -%}
  {%- assign cnt_lip = 0 -%}
  {%- assign cnt_foundation = 0 -%}
  {%- assign cnt_mascara = 0 -%}
  {%- assign cnt_concealer = 0 -%}
  {%- assign cnt_powder = 0 -%}
  {%- assign cnt_primer = 0 -%}
  {%- assign cnt_highlighter = 0 -%}
  {%- assign cnt_eyeliner = 0 -%}
  {%- assign cnt_blush = 0 -%}

  {%- for product in collection.products -%}
    {%- assign cnt_all = cnt_all | plus: 1 -%}
    {%- assign t = product.title | downcase -%}
    {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}
      {%- assign cnt_foundation = cnt_foundation | plus: 1 -%}
    {%- elsif t contains 'mascara' -%}
      {%- assign cnt_mascara = cnt_mascara | plus: 1 -%}
    {%- elsif t contains 'lip' or t contains 'lipstick' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}
      {%- assign cnt_lip = cnt_lip | plus: 1 -%}
    {%- elsif t contains 'concealer' -%}
      {%- assign cnt_concealer = cnt_concealer | plus: 1 -%}
    {%- elsif t contains 'powder' -%}
      {%- assign cnt_powder = cnt_powder | plus: 1 -%}
    {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}
      {%- assign cnt_primer = cnt_primer | plus: 1 -%}
    {%- elsif t contains 'highlighter' or t contains 'chrome' -%}
      {%- assign cnt_highlighter = cnt_highlighter | plus: 1 -%}
    {%- elsif t contains 'eyeliner' -%}
      {%- assign cnt_eyeliner = cnt_eyeliner | plus: 1 -%}
    {%- elsif t contains 'blush' or t contains 'cheek' -%}
      {%- assign cnt_blush = cnt_blush | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="mp-filter-section">
    <h2 class="mp-filter-title">{{ collection.title }}</h2>
    <p class="mp-filter-sub">Browse by category or explore all {{ mp_count }} products</p>

    <div class="mp-filter-bar" role="group" aria-label="Filter by category">
      <button class="mp-filter-btn active" data-cat="all">
        <span class="mp-filter-icon">✦</span> All
        <span class="mp-filter-count">{{ cnt_all }}</span>
      </button>
      {%- if cnt_lip > 0 -%}
      <button class="mp-filter-btn" data-cat="lip">
        <span class="mp-filter-icon">💄</span> Lips
        <span class="mp-filter-count">{{ cnt_lip }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_foundation > 0 -%}
      <button class="mp-filter-btn" data-cat="foundation">
        <span class="mp-filter-icon">🌟</span> Foundation
        <span class="mp-filter-count">{{ cnt_foundation }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_concealer > 0 -%}
      <button class="mp-filter-btn" data-cat="concealer">
        <span class="mp-filter-icon">🌸</span> Concealer
        <span class="mp-filter-count">{{ cnt_concealer }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_mascara > 0 -%}
      <button class="mp-filter-btn" data-cat="mascara">
        <span class="mp-filter-icon">✨</span> Mascara
        <span class="mp-filter-count">{{ cnt_mascara }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_powder > 0 -%}
      <button class="mp-filter-btn" data-cat="powder">
        <span class="mp-filter-icon">🌷</span> Powder
        <span class="mp-filter-count">{{ cnt_powder }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_primer > 0 -%}
      <button class="mp-filter-btn" data-cat="primer">
        <span class="mp-filter-icon">💎</span> Primer
        <span class="mp-filter-count">{{ cnt_primer }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_highlighter > 0 -%}
      <button class="mp-filter-btn" data-cat="highlighter">
        <span class="mp-filter-icon">✨</span> Highlighter
        <span class="mp-filter-count">{{ cnt_highlighter }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_eyeliner > 0 -%}
      <button class="mp-filter-btn" data-cat="eyeliner">
        <span class="mp-filter-icon">🖋</span> Eyeliner
        <span class="mp-filter-count">{{ cnt_eyeliner }}</span>
      </button>
      {%- endif -%}
      {%- if cnt_blush > 0 -%}
      <button class="mp-filter-btn" data-cat="blush">
        <span class="mp-filter-icon">🌹</span> Blush
        <span class="mp-filter-count">{{ cnt_blush }}</span>
      </button>
      {%- endif -%}
    </div>
  </div>

  <!-- ── TOOLBAR ──────────────────────────────────────────── -->
  <div class="mp-toolbar">
    <div class="mp-result-count">
      Showing <strong id="mp-visible-count">{{ mp_count }}</strong> products
    </div>
    <div class="mp-sort-wrap">
      <span class="mp-sort-label">Sort:</span>
      <select class="mp-sort-select" id="mp-sort" aria-label="Sort products">
        <option value="">Default</option>
        <option value="price-asc">Price: Low → High</option>
        <option value="price-desc">Price: High → Low</option>
        <option value="title-asc">Name: A → Z</option>
        <option value="disc-desc">Biggest Discount</option>
      </select>
    </div>
  </div>

  <!-- ── PRODUCT GRID ─────────────────────────────────────── -->
  <div class="mp-grid-wrap">
    <div class="mp-grid" id="mp-grid">

      {%- for product in collection.products -%}
        {%- assign pp = product.price -%}
        {%- assign cp = product.compare_at_price -%}
        {%- assign disc = 0 -%}
        {%- if cp > pp -%}
          {%- assign diff = cp | minus: pp -%}
          {%- assign disc = diff | times: 100 | divided_by: cp -%}
        {%- endif -%}

        {%- assign t = product.title | downcase -%}
        {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}
          {%- assign mp_cat = 'foundation' -%}{%- assign mp_icon = '🌟' -%}{%- assign mp_cat_label = 'Foundation' -%}
        {%- elsif t contains 'mascara' -%}
          {%- assign mp_cat = 'mascara' -%}{%- assign mp_icon = '✨' -%}{%- assign mp_cat_label = 'Mascara' -%}
        {%- elsif t contains 'lip' or t contains 'lipstick' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}
          {%- assign mp_cat = 'lip' -%}{%- assign mp_icon = '💄' -%}{%- assign mp_cat_label = 'Lips' -%}
        {%- elsif t contains 'concealer' -%}
          {%- assign mp_cat = 'concealer' -%}{%- assign mp_icon = '🌸' -%}{%- assign mp_cat_label = 'Concealer' -%}
        {%- elsif t contains 'powder' -%}
          {%- assign mp_cat = 'powder' -%}{%- assign mp_icon = '🌷' -%}{%- assign mp_cat_label = 'Powder' -%}
        {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}
          {%- assign mp_cat = 'primer' -%}{%- assign mp_icon = '💎' -%}{%- assign mp_cat_label = 'Primer' -%}
        {%- elsif t contains 'highlighter' or t contains 'chrome' -%}
          {%- assign mp_cat = 'highlighter' -%}{%- assign mp_icon = '✨' -%}{%- assign mp_cat_label = 'Highlighter' -%}
        {%- elsif t contains 'eyeliner' -%}
          {%- assign mp_cat = 'eyeliner' -%}{%- assign mp_icon = '🖋' -%}{%- assign mp_cat_label = 'Eyeliner' -%}
        {%- elsif t contains 'blush' or t contains 'cheek' -%}
          {%- assign mp_cat = 'blush' -%}{%- assign mp_icon = '🌹' -%}{%- assign mp_cat_label = 'Blush' -%}
        {%- else -%}
          {%- assign mp_cat = 'default' -%}{%- assign mp_icon = '💫' -%}{%- assign mp_cat_label = 'Makeup' -%}
        {%- endif -%}

        <a
          href="{{ product.url }}"
          class="mp-card"
          data-cat="{{ mp_cat }}"
          data-price="{{ pp }}"
          data-disc="{{ disc }}"
          data-title="{{ product.title | escape }}"
          style="animation-delay:{{ forloop.index0 | times: 0.035 }}s"
          aria-label="{{ product.title | escape }}"
        >
          <!-- IMAGE -->
          <div class="mp-card-img mp-cat-{{ mp_cat }}">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy" width="500" height="500"
              >
            {%- else -%}
              <div class="mp-card-img-placeholder">
                <div class="mp-ph-icon">{{ mp_icon }}</div>
                <div class="mp-ph-name">{{ product.title | remove: 'Maybelline ' }}</div>
              </div>
            {%- endif -%}

            <!-- BADGES -->
            <div class="mp-badge-wrap">
              <span class="mp-badge mp-badge--limited">Limited Offer</span>
              {%- if disc >= 10 -%}
                <span class="mp-badge mp-badge--sale">{{ disc }}% OFF</span>
              {%- endif -%}
            </div>

            <!-- CATEGORY CHIP -->
            <span class="mp-cat-chip">{{ mp_cat_label }}</span>
          </div>

          <!-- BODY -->
          <div class="mp-card-body">
            <div class="mp-card-name">{{ product.title }}</div>

            <div class="mp-pricing">
              <span class="mp-price">Rs {{ pp | divided_by: 100 }}</span>
              {%- if cp > pp -%}
                <span class="mp-compare">Rs {{ cp | divided_by: 100 }}</span>
                {%- if disc >= 5 -%}
                  <span class="mp-disc-tag">{{ disc }}% OFF</span>
                {%- endif -%}
              {%- endif -%}
            </div>

            <button class="mp-atc" data-vid="{{ product.variants.first.id }}" onclick="event.preventDefault(); mpAddToCart(this)">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
              Add to Cart
            </button>
          </div>
        </a>

      {%- endfor -%}
    </div>

    <!-- no results state -->
    <div class="mp-no-results" id="mp-no-results">
      <div class="mp-no-results-icon">🔍</div>
      <p>No products in this category yet.</p>
      <button onclick="mpResetFilter()">Show All Products</button>
    </div>
  </div>

  <!-- ── PAGINATION ──────────────────────────────────────── -->
  {%- if paginate.pages > 1 -%}
    <div class="mp-pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="mp-page-link">‹ Prev</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="mp-page-link">{{ part.title }}</a>
        {%- else -%}
          <span class="mp-page-link current">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="mp-page-link">Next ›</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- endpaginate -%}

  {%- else -%}
    <div class="mp-empty"><p style="color:var(--mp-muted)">No products in this collection yet.</p></div>
  {%- endif -%}

</div>

<script>
(function () {
  var grid        = document.getElementById('mp-grid');
  var sortSel     = document.getElementById('mp-sort');
  var countEl     = document.getElementById('mp-visible-count');
  var noResults   = document.getElementById('mp-no-results');
  var filterBtns  = document.querySelectorAll('.mp-filter-btn');
  var activeCat   = 'all';

  /* ── ADD TO CART ─────────────────────────────── */
  window.mpAddToCart = function (btn) {
    var vid = btn.dataset.vid;
    if (!vid) return;
    var orig = btn.innerHTML;
    btn.innerHTML = 'Adding…';
    btn.style.opacity = '.7';
    btn.disabled = true;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: vid, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.innerHTML = '✓ Added!';
      btn.style.opacity = '1';
      setTimeout(function () {
        btn.innerHTML = orig;
        btn.disabled = false;
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      }, 1600);
    })
    .catch(function () {
      btn.innerHTML = orig;
      btn.style.opacity = '1';
      btn.disabled = false;
    });
  };

  /* ── FILTER ──────────────────────────────────── */
  function applyFilter(cat) {
    activeCat = cat;
    var cards = Array.from(grid.querySelectorAll('.mp-card'));
    var visible = 0;
    cards.forEach(function (c) {
      var show = cat === 'all' || c.dataset.cat === cat;
      c.classList.toggle('mp-hidden', !show);
      if (show) visible++;
    });
    if (countEl) countEl.textContent = visible;
    if (noResults) noResults.classList.toggle('show', visible === 0);
  }

  filterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filterBtns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyFilter(btn.dataset.cat);
    });
  });

  window.mpResetFilter = function () {
    filterBtns.forEach(function (b) { b.classList.remove('active'); });
    var allBtn = document.querySelector('.mp-filter-btn[data-cat="all"]');
    if (allBtn) allBtn.classList.add('active');
    applyFilter('all');
  };

  /* ── SORT ────────────────────────────────────── */
  if (sortSel && grid) {
    sortSel.addEventListener('change', function () {
      var cards = Array.from(grid.querySelectorAll('.mp-card'));
      var val = sortSel.value;
      cards.sort(function (a, b) {
        if (val === 'price-asc')  return +a.dataset.price - +b.dataset.price;
        if (val === 'price-desc') return +b.dataset.price - +a.dataset.price;
        if (val === 'disc-desc')  return +b.dataset.disc  - +a.dataset.disc;
        if (val === 'title-asc')  return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        return 0;
      });
      cards.forEach(function (c) { grid.appendChild(c); });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Miss Pretty Collection",
  "tag": "section",
  "class": "misspretty-collection",
  "settings": [],
  "presets": [{ "name": "Miss Pretty Collection" }]
}
{% endschema %}
