<script>
(function(){
  window.mpATC = function(btn){
    var vid=btn.dataset.vid; if(!vid) return;
    var orig=btn.innerHTML;
    btn.innerHTML='Adding…'; btn.disabled=true; btn.style.opacity='.7';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:vid,quantity:1})})
    .then(function(r){return r.json();})
    .then(function(){
      btn.innerHTML='✓ Added!'; btn.style.opacity='1'; btn.style.background='linear-gradient(135deg,#2d7a3a,#3a9e4a)';
      setTimeout(function(){
        btn.innerHTML=orig; btn.style.background=''; btn.disabled=false;
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      },1600);
    })
    .catch(function(){btn.innerHTML=orig;btn.style.opacity='1';btn.disabled=false;});
  };

  var pills=document.querySelectorAll('.mp-pill');
  var grid=document.getElementById('mp-grid');
  var nores=document.getElementById('mp-nores');
  var vcEl=document.getElementById('mp-vis-count');

  function filter(cat){
    var cards=grid.querySelectorAll('.mp-card'),vis=0;
    cards.forEach(function(c){
      var show=cat==='all'||c.dataset.cat===cat;
      c.classList.toggle('mp-hidden',!show);
      if(show) vis++;
    });
    if(vcEl) vcEl.textContent=vis;
    if(nores) nores.classList.toggle('show',vis===0);
  }

  pills.forEach(function(p){
    p.addEventListener('click',function(){
      pills.forEach(function(x){x.classList.remove('active');});
      p.classList.add('active');
      filter(p.dataset.cat);
    });
  });

  window.mpReset=function(){
    pills.forEach(function(x){x.classList.remove('active');});
    document.querySelector('.mp-pill[data-cat="all"]').classList.add('active');
    filter('all');
  };

  var sortEl=document.getElementById('mp-sort');
  if(sortEl&&grid){
    sortEl.addEventListener('change',function(){
      var cards=Array.from(grid.querySelectorAll('.mp-card'));
      var v=sortEl.value;
      cards.sort(function(a,b){
        if(v==='price-asc') return +a.dataset.price - +b.dataset.price;
        if(v==='price-desc') return +b.dataset.price - +a.dataset.price;
        if(v==='disc-desc') return +b.dataset.disc - +a.dataset.disc;
        if(v==='az') return (a.dataset.title||'').localeCompare(b.dataset.title||'');
        return 0;
      });
      cards.forEach(function(c){grid.appendChild(c);});
    });
  }
})();
</script>

