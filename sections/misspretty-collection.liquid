{% comment %} Miss Pretty × Maybelline — High Conversion, Mobile-First {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ── THEME TOKENS ─────────────────────────────────────── */
.mp{
  /* dark (default) */
  --mp-bg:       #0a0a0f;
  --mp-surface:  #13121a;
  --mp-card:     #17161f;
  --mp-card-br:  rgba(255,255,255,.07);
  --mp-card-br-h:rgba(212,168,67,.55);
  --mp-text:     #f0e8d5;
  --mp-text2:    #b8afc0;
  --mp-muted:    #6e677a;
  --mp-atc-bg:   #f0c76a;
  --mp-atc-txt:  #0a0a0f;
  --mp-pill-bg:  rgba(255,255,255,.06);
  --mp-pill-br:  rgba(255,255,255,.1);
  --mp-divider:  rgba(255,255,255,.06);
  --gold:#d4a843;--gold-lt:#f0c76a;--gold-dk:#a8832e;
  --pink:#e8507a;
  --r:12px;--r-lg:18px;
  font-family:'Poppins',sans-serif;
  background:var(--mp-bg);color:var(--mp-text);
}
/* light-mode override */
html:not([data-theme="dark"]) .mp{
  --mp-bg:       #faf9f7;
  --mp-surface:  #ffffff;
  --mp-card:     #ffffff;
  --mp-card-br:  rgba(0,0,0,.08);
  --mp-card-br-h:rgba(180,140,20,.6);
  --mp-text:     #1a1218;
  --mp-text2:    #5a5060;
  --mp-muted:    #9a92a0;
  --mp-atc-bg:   #1a1218;
  --mp-atc-txt:  #ffffff;
  --mp-pill-bg:  rgba(0,0,0,.04);
  --mp-pill-br:  rgba(0,0,0,.1);
  --mp-divider:  rgba(0,0,0,.06);
}

.mp,.mp*,.mp*::before,.mp*::after{box-sizing:border-box;margin:0;padding:0;}

/* ── CATEGORY CIRCLES ─────────────────────────────────── */
.mp-cats{
  padding:6px 0 0;
  background:var(--mp-surface);
  border-bottom:1px solid var(--mp-divider);
  position:sticky;top:0;z-index:40;
}
.mp-cats-scroll{
  display:flex;gap:6px;overflow-x:auto;
  padding:0 12px 10px;scrollbar-width:none;
}
.mp-cats-scroll::-webkit-scrollbar{display:none;}

.mp-cat-btn{
  display:flex;flex-direction:column;align-items:center;gap:7px;
  flex-shrink:0;cursor:pointer;border:none;background:transparent;
  padding:0;transition:transform .2s;
}
.mp-cat-btn:active{transform:scale(.93);}

.mp-cat-circle{
  width:68px;height:68px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:1.9rem;line-height:1;
  border:2.5px solid var(--mp-pill-br);
  background:var(--mp-pill-bg);
  transition:border-color .22s,box-shadow .22s,background .22s;
  position:relative;overflow:hidden;
}
.mp-cat-btn.active .mp-cat-circle{
  border-color:var(--gold);
  box-shadow:0 0 0 3px rgba(212,168,67,.2);
  background:linear-gradient(145deg,rgba(212,168,67,.15),rgba(240,199,106,.08));
}
/* category specific gradients */
.mp-cat-circle--all      { background:linear-gradient(145deg,rgba(212,168,67,.15),rgba(232,80,122,.12)); }
.mp-cat-circle--lip      { background:linear-gradient(145deg,rgba(200,50,90,.25),rgba(220,100,120,.2)); }
.mp-cat-circle--foundation{ background:linear-gradient(145deg,rgba(220,170,130,.25),rgba(200,150,110,.2)); }
.mp-cat-circle--concealer { background:linear-gradient(145deg,rgba(220,190,160,.2),rgba(200,170,140,.18)); }
.mp-cat-circle--mascara  { background:linear-gradient(145deg,rgba(30,20,60,.5),rgba(60,40,90,.4)); }
.mp-cat-circle--powder   { background:linear-gradient(145deg,rgba(220,170,140,.22),rgba(200,150,120,.18)); }
.mp-cat-circle--primer   { background:linear-gradient(145deg,rgba(100,150,220,.22),rgba(80,130,200,.18)); }
.mp-cat-circle--highlighter{ background:linear-gradient(145deg,rgba(240,210,80,.25),rgba(220,190,60,.2)); }
.mp-cat-circle--eyeliner { background:linear-gradient(145deg,rgba(20,15,40,.6),rgba(40,30,70,.5)); }
.mp-cat-circle--blush    { background:linear-gradient(145deg,rgba(230,140,160,.25),rgba(210,110,140,.2)); }

.mp-cat-lbl{
  font-size:.6rem;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;color:var(--mp-text2);
  transition:color .22s;white-space:nowrap;
}
.mp-cat-btn.active .mp-cat-lbl{color:var(--gold);}

/* active underline dot */
.mp-cat-dot{
  width:4px;height:4px;border-radius:50%;background:var(--gold);
  opacity:0;transform:scale(0);transition:all .22s;
}
.mp-cat-btn.active .mp-cat-dot{opacity:1;transform:scale(1);}

/* ── TOOLBAR ──────────────────────────────────────────── */
.mp-toolbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 14px 10px;background:var(--mp-bg);
  border-bottom:1px solid var(--mp-divider);
}
.mp-count{font-size:.75rem;color:var(--mp-muted);}
.mp-count strong{color:var(--mp-text);font-weight:600;}
.mp-sort{
  font-family:'Poppins',sans-serif;font-size:.72rem;font-weight:500;
  padding:6px 12px;border-radius:20px;cursor:pointer;outline:none;
  appearance:none;-webkit-appearance:none;
  background:var(--mp-pill-bg);border:1px solid var(--mp-pill-br);
  color:var(--mp-text2);transition:border-color .2s;
}
.mp-sort:focus{border-color:var(--gold);}

/* ── PRODUCT GRID ─────────────────────────────────────── */
.mp-grid-wrap{padding:12px 10px 0;background:var(--mp-bg);}
.mp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
@media(min-width:580px){.mp-grid{grid-template-columns:repeat(3,1fr);gap:12px;}}
@media(min-width:900px){.mp-grid{grid-template-columns:repeat(4,1fr);gap:14px;}}
@media(min-width:1280px){.mp-grid{max-width:1320px;margin:0 auto;}}

.mp-card{
  background:var(--mp-card);
  border:1px solid var(--mp-card-br);
  border-radius:var(--r-lg);
  overflow:hidden;display:flex;flex-direction:column;
  text-decoration:none;color:inherit;
  transition:transform .28s cubic-bezier(.34,1.56,.64,1),box-shadow .28s,border-color .22s;
  animation:mp-in .45s ease both;
}
.mp-card:hover{
  transform:translateY(-5px);
  box-shadow:0 14px 44px rgba(0,0,0,.18),0 4px 16px rgba(212,168,67,.12);
  border-color:var(--mp-card-br-h);
}
html:not([data-theme="dark"]) .mp-card:hover{
  box-shadow:0 14px 44px rgba(0,0,0,.1),0 4px 16px rgba(180,140,20,.15);
}
.mp-card.mp-hidden{display:none;}
@keyframes mp-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

/* IMAGE */
.mp-img{
  position:relative;width:100%;aspect-ratio:1/1;
  overflow:hidden;flex-shrink:0;
  background:var(--mp-surface);
}
.mp-img img{
  width:100%;height:100%;object-fit:cover;object-position:center;
  display:block;transition:transform .5s cubic-bezier(.25,.46,.45,.94);
}
.mp-card:hover .mp-img img{transform:scale(1.07);}
.mp-img-fade{
  position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.45) 100%);
}
html:not([data-theme="dark"]) .mp-img-fade{
  background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.18) 100%);
}

/* placeholder */
.mp-ph{
  width:100%;height:100%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;padding:16px;text-align:center;
}
.mp-ph-icon{font-size:2.4rem;}
.mp-ph-name{
  font-size:.65rem;font-weight:600;
  color:rgba(255,255,255,.8);line-height:1.3;
  text-shadow:0 1px 6px rgba(0,0,0,.5);
}
html:not([data-theme="dark"]) .mp-ph-name{color:rgba(0,0,0,.6);text-shadow:none;}

.mp-cat-foundation {background:linear-gradient(145deg,#dca882,#c8906a);}
.mp-cat-mascara    {background:linear-gradient(145deg,#1a1430,#2a2040);}
.mp-cat-lip        {background:linear-gradient(145deg,#9e2040,#c03060);}
.mp-cat-concealer  {background:linear-gradient(145deg,#d4b090,#c09878);}
.mp-cat-highlighter{background:linear-gradient(145deg,#c8a830,#e0c050);}
.mp-cat-powder     {background:linear-gradient(145deg,#c8a088,#b08870);}
.mp-cat-primer     {background:linear-gradient(145deg,#6090c8,#4878b0);}
.mp-cat-eyeliner   {background:linear-gradient(145deg,#0e0a20,#1e1430);}
.mp-cat-blush      {background:linear-gradient(145deg,#c8607a,#b04868);}
.mp-cat-default    {background:linear-gradient(145deg,#5090a8,#387890);}

/* BADGES */
.mp-badges{position:absolute;top:8px;left:8px;z-index:5;display:flex;flex-direction:column;gap:4px;}
.mp-badge{
  display:inline-block;font-size:.52rem;font-weight:800;
  letter-spacing:.12em;text-transform:uppercase;
  padding:3px 9px;border-radius:4px;line-height:1.5;
}
.mp-badge--hot{background:#e8507a;color:#fff;}
.mp-badge--sale{background:var(--gold);color:#1a0e00;}

/* CARD INFO */
.mp-info{padding:11px 12px 6px;display:flex;flex-direction:column;gap:4px;flex:1;}
.mp-name{
  font-size:.8rem;font-weight:600;color:var(--mp-text);line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:2.7em;
}
html:not([data-theme="dark"]) .mp-name{color:#1a1218;}

.mp-prices{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:3px;}
.mp-price{font-size:.98rem;font-weight:700;color:var(--gold);}
html:not([data-theme="dark"]) .mp-price{color:#a8832e;}
.mp-was{font-size:.73rem;color:var(--mp-muted);text-decoration:line-through;}
.mp-save{
  font-size:.58rem;font-weight:700;
  background:rgba(212,168,67,.14);color:var(--gold);
  padding:2px 6px;border-radius:6px;border:1px solid rgba(212,168,67,.25);
}
html:not([data-theme="dark"]) .mp-save{background:rgba(168,131,46,.1);color:#a8832e;border-color:rgba(168,131,46,.3);}

/* ADD TO CART */
.mp-atc-wrap{padding:0 10px 12px;margin-top:auto;}
.mp-atc{
  display:flex;align-items:center;justify-content:center;gap:7px;
  width:100%;padding:12px 10px;border:none;border-radius:8px;
  background:var(--mp-atc-bg);color:var(--mp-atc-txt);
  font-family:'Poppins',sans-serif;font-size:.7rem;font-weight:700;
  letter-spacing:.12em;text-transform:uppercase;cursor:pointer;
  transition:opacity .2s,transform .15s,box-shadow .2s;
  box-shadow:0 4px 16px rgba(0,0,0,.2);
}
.mp-atc:hover{opacity:.9;transform:translateY(-1px);box-shadow:0 6px 22px rgba(0,0,0,.28);}
.mp-atc:active{transform:translateY(0);}
.mp-atc svg{width:14px;height:14px;flex-shrink:0;}

/* ── NO RESULTS ──────────────────────────────────────── */
.mp-nores{display:none;flex-direction:column;align-items:center;gap:12px;padding:60px 20px;text-align:center;}
.mp-nores.show{display:flex;}
.mp-nores-icon{font-size:3rem;}
.mp-nores p{color:var(--mp-muted);font-size:.88rem;}
.mp-nores-btn{
  padding:9px 24px;background:transparent;border:1px solid var(--mp-pill-br);
  border-radius:20px;color:var(--gold);font-family:'Poppins',sans-serif;
  font-size:.72rem;cursor:pointer;transition:all .2s;
}
.mp-nores-btn:hover{border-color:var(--gold);background:rgba(212,168,67,.08);}

/* ── PAGINATION ──────────────────────────────────────── */
.mp-pages{display:flex;justify-content:center;gap:7px;padding:24px 12px 18px;flex-wrap:wrap;}
.mp-page{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:38px;height:38px;padding:0 12px;
  border:1px solid var(--mp-pill-br);border-radius:8px;
  background:var(--mp-pill-bg);color:var(--mp-muted);
  text-decoration:none;font-size:.78rem;font-weight:500;transition:all .2s;
}
.mp-page:hover,.mp-page.cur{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.08);}

/* ── BRAND FOOTER ────────────────────────────────────── */
.mp-footer{
  position:relative;overflow:hidden;
  margin:20px 12px 16px;border-radius:var(--r-lg);
  padding:32px 20px 28px;text-align:center;
  background:linear-gradient(135deg,#0f0b18,#180d20,#0d0f1a);
  border:1px solid rgba(212,168,67,.2);
}
html:not([data-theme="dark"]) .mp-footer{
  background:linear-gradient(135deg,#1a0e28,#200e30,#150a20);
}
.mp-footer::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(ellipse 70% 70% at 15% 50%,rgba(232,80,122,.13) 0%,transparent 65%),
    radial-gradient(ellipse 60% 70% at 85% 50%,rgba(212,168,67,.13) 0%,transparent 65%);
}
.mp-footer-tag{
  display:inline-block;font-size:.58rem;font-weight:700;letter-spacing:.38em;
  text-transform:uppercase;color:var(--pink);
  border:1px solid rgba(232,80,122,.3);padding:4px 14px;border-radius:20px;
  margin-bottom:14px;background:rgba(232,80,122,.05);
}
.mp-footer-title{
  font-family:'Playfair Display',serif;
  font-size:clamp(1.6rem,6vw,2.6rem);font-weight:800;
  line-height:1.1;margin-bottom:10px;position:relative;z-index:1;
}
.mp-footer-may{
  background:linear-gradient(135deg,#fff,#e0d4c0);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.mp-footer-x{color:var(--pink);font-style:italic;-webkit-text-fill-color:var(--pink);margin:0 6px;}
.mp-footer-mp{
  background:linear-gradient(135deg,var(--gold),var(--gold-lt));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.mp-footer-sub{font-size:.78rem;color:#8a8090;margin-bottom:22px;position:relative;z-index:1;}
.mp-footer-stats{
  display:flex;justify-content:center;gap:28px;flex-wrap:wrap;
  position:relative;z-index:1;margin-bottom:22px;
}
.mp-footer-stat-n{display:block;font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--gold);}
.mp-footer-stat-l{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:#6e677a;}
.mp-footer-cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:13px 30px;border-radius:30px;text-decoration:none;
  background:linear-gradient(135deg,var(--gold-dk),var(--gold),var(--gold-lt));
  color:#1a0e00;font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  box-shadow:0 4px 20px rgba(212,168,67,.35);position:relative;z-index:1;
  transition:box-shadow .2s,transform .15s;
}
.mp-footer-cta:hover{box-shadow:0 6px 32px rgba(212,168,67,.55);transform:translateY(-1px);}
.mp-footer-cta svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;}
</style>

{%- assign mp_count = collection.products_count -%}

{%- comment -%}Count per category{%- endcomment -%}
{%- assign c_lip=0 -%}{%- assign c_fnd=0 -%}{%- assign c_mas=0 -%}
{%- assign c_con=0 -%}{%- assign c_pwd=0 -%}{%- assign c_prm=0 -%}
{%- assign c_hi=0 -%}{%- assign c_eye=0 -%}{%- assign c_bl=0 -%}

{%- for product in collection.products -%}
  {%- assign t = product.title | downcase -%}
  {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}{%- assign c_fnd=c_fnd|plus:1 -%}
  {%- elsif t contains 'mascara' -%}{%- assign c_mas=c_mas|plus:1 -%}
  {%- elsif t contains 'lip' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}{%- assign c_lip=c_lip|plus:1 -%}
  {%- elsif t contains 'concealer' -%}{%- assign c_con=c_con|plus:1 -%}
  {%- elsif t contains 'powder' -%}{%- assign c_pwd=c_pwd|plus:1 -%}
  {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}{%- assign c_prm=c_prm|plus:1 -%}
  {%- elsif t contains 'highlighter' or t contains 'chrome' -%}{%- assign c_hi=c_hi|plus:1 -%}
  {%- elsif t contains 'eyeliner' -%}{%- assign c_eye=c_eye|plus:1 -%}
  {%- elsif t contains 'blush' or t contains 'cheek' -%}{%- assign c_bl=c_bl|plus:1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="mp" id="mp-root">

  <!-- ── CATEGORY CIRCLES (sticky) ───────────────────── -->
  <div class="mp-cats">
    <div class="mp-cats-scroll" id="mp-cats">

      <button class="mp-cat-btn active" data-cat="all">
        <div class="mp-cat-circle mp-cat-circle--all">✦</div>
        <span class="mp-cat-lbl">All</span>
        <div class="mp-cat-dot"></div>
      </button>

      {%- if c_lip > 0 -%}
      <button class="mp-cat-btn" data-cat="lip">
        <div class="mp-cat-circle mp-cat-circle--lip">💄</div>
        <span class="mp-cat-lbl">Lips</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_fnd > 0 -%}
      <button class="mp-cat-btn" data-cat="foundation">
        <div class="mp-cat-circle mp-cat-circle--foundation">🌟</div>
        <span class="mp-cat-lbl">Foundation</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_con > 0 -%}
      <button class="mp-cat-btn" data-cat="concealer">
        <div class="mp-cat-circle mp-cat-circle--concealer">🌸</div>
        <span class="mp-cat-lbl">Concealer</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_mas > 0 -%}
      <button class="mp-cat-btn" data-cat="mascara">
        <div class="mp-cat-circle mp-cat-circle--mascara">✨</div>
        <span class="mp-cat-lbl">Mascara</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_pwd > 0 -%}
      <button class="mp-cat-btn" data-cat="powder">
        <div class="mp-cat-circle mp-cat-circle--powder">🌷</div>
        <span class="mp-cat-lbl">Powder</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_prm > 0 -%}
      <button class="mp-cat-btn" data-cat="primer">
        <div class="mp-cat-circle mp-cat-circle--primer">💎</div>
        <span class="mp-cat-lbl">Primer</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_hi > 0 -%}
      <button class="mp-cat-btn" data-cat="highlighter">
        <div class="mp-cat-circle mp-cat-circle--highlighter">⭐</div>
        <span class="mp-cat-lbl">Highlight</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_eye > 0 -%}
      <button class="mp-cat-btn" data-cat="eyeliner">
        <div class="mp-cat-circle mp-cat-circle--eyeliner">🖤</div>
        <span class="mp-cat-lbl">Eyeliner</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

      {%- if c_bl > 0 -%}
      <button class="mp-cat-btn" data-cat="blush">
        <div class="mp-cat-circle mp-cat-circle--blush">🌹</div>
        <span class="mp-cat-lbl">Blush</span>
        <div class="mp-cat-dot"></div>
      </button>
      {%- endif -%}

    </div>
  </div>

  {%- if mp_count > 0 -%}

  <!-- TOOLBAR -->
  <div class="mp-toolbar">
    <div class="mp-count"><strong id="mp-vis">{{ mp_count }}</strong> products</div>
    <select class="mp-sort" id="mp-sort" aria-label="Sort">
      <option value="">Default</option>
      <option value="price-asc">Price: Low → High</option>
      <option value="price-desc">Price: High → Low</option>
      <option value="disc-desc">Best Deal</option>
      <option value="az">A → Z</option>
    </select>
  </div>

  <!-- PRODUCTS -->
  {%- paginate collection.products by 100 -%}
  <div class="mp-grid-wrap">
    <div class="mp-grid" id="mp-grid">

      {%- for product in collection.products -%}
        {%- assign pp = product.price -%}
        {%- assign cp = product.compare_at_price -%}
        {%- assign disc = 0 -%}
        {%- if cp > pp -%}{%- assign diff = cp | minus: pp -%}{%- assign disc = diff | times: 100 | divided_by: cp -%}{%- endif -%}
        {%- assign t = product.title | downcase -%}

        {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}
          {%- assign cat='foundation' -%}{%- assign icon='🌟' -%}
        {%- elsif t contains 'mascara' -%}
          {%- assign cat='mascara' -%}{%- assign icon='✨' -%}
        {%- elsif t contains 'lip' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}
          {%- assign cat='lip' -%}{%- assign icon='💄' -%}
        {%- elsif t contains 'concealer' -%}
          {%- assign cat='concealer' -%}{%- assign icon='🌸' -%}
        {%- elsif t contains 'powder' -%}
          {%- assign cat='powder' -%}{%- assign icon='🌷' -%}
        {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}
          {%- assign cat='primer' -%}{%- assign icon='💎' -%}
        {%- elsif t contains 'highlighter' or t contains 'chrome' -%}
          {%- assign cat='highlighter' -%}{%- assign icon='⭐' -%}
        {%- elsif t contains 'eyeliner' -%}
          {%- assign cat='eyeliner' -%}{%- assign icon='🖤' -%}
        {%- elsif t contains 'blush' or t contains 'cheek' -%}
          {%- assign cat='blush' -%}{%- assign icon='🌹' -%}
        {%- else -%}
          {%- assign cat='default' -%}{%- assign icon='💫' -%}
        {%- endif -%}

        <a href="{{ product.url }}" class="mp-card"
          data-cat="{{ cat }}"
          data-price="{{ pp }}"
          data-disc="{{ disc }}"
          data-title="{{ product.title | escape }}"
          style="animation-delay:{{ forloop.index0 | times: 0.03 }}s"
        >
          <!-- IMAGE -->
          <div class="mp-img mp-cat-{{ cat }}">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                width="500" height="500"
              >
            {%- else -%}
              <div class="mp-ph">
                <div class="mp-ph-icon">{{ icon }}</div>
                <div class="mp-ph-name">{{ product.title | remove: 'Maybelline ' | truncate: 36 }}</div>
              </div>
            {%- endif -%}
            <div class="mp-img-fade"></div>
            <div class="mp-badges">
              {%- if disc >= 15 -%}
                <span class="mp-badge mp-badge--hot">🔥 Hot Deal</span>
              {%- elsif disc >= 5 -%}
                <span class="mp-badge mp-badge--sale">{{ disc }}% OFF</span>
              {%- else -%}
                <span class="mp-badge mp-badge--hot">New</span>
              {%- endif -%}
            </div>
          </div>

          <!-- INFO -->
          <div class="mp-info">
            <div class="mp-name">{{ product.title }}</div>
            <div class="mp-prices">
              <span class="mp-price">Rs {{ pp | divided_by: 100 }}</span>
              {%- if cp > pp -%}
                <span class="mp-was">Rs {{ cp | divided_by: 100 }}</span>
                {%- if disc >= 5 -%}<span class="mp-save">{{ disc }}% OFF</span>{%- endif -%}
              {%- endif -%}
            </div>
          </div>

          <!-- ADD TO CART -->
          <div class="mp-atc-wrap">
            <button class="mp-atc" data-vid="{{ product.variants.first.id }}" onclick="event.preventDefault();mpATC(this)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              Add to Cart
            </button>
          </div>
        </a>
      {%- endfor -%}

    </div>

    <div class="mp-nores" id="mp-nores">
      <div class="mp-nores-icon">🔍</div>
      <p>No products in this category yet.</p>
      <button class="mp-nores-btn" onclick="mpReset()">Show All Products</button>
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="mp-pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="mp-page">‹</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}" class="mp-page">{{ part.title }}</a>
        {%- else -%}<span class="mp-page cur">{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="mp-page">›</a>{%- endif -%}
    </div>
  {%- endif -%}
  {%- endpaginate -%}

  {%- else -%}
    <p style="text-align:center;padding:60px 20px;color:var(--mp-muted)">No products yet.</p>
  {%- endif -%}

  <!-- BRAND FOOTER -->
  <div class="mp-footer">
    <div class="mp-footer-tag">Exclusive Collection 2025</div>
    <div class="mp-footer-title">
      <span class="mp-footer-may">Maybelline</span><span class="mp-footer-x">×</span><span class="mp-footer-mp">Miss Pretty</span>
    </div>
    <div class="mp-footer-sub">Premium beauty · 100% authentic · Delivered fast</div>
    <div class="mp-footer-stats">
      <div><span class="mp-footer-stat-n">{{ mp_count }}</span><span class="mp-footer-stat-l">Products</span></div>
      <div><span class="mp-footer-stat-n">100%</span><span class="mp-footer-stat-l">Authentic</span></div>
      <div><span class="mp-footer-stat-n">⚡</span><span class="mp-footer-stat-l">Fast Delivery</span></div>
      <div><span class="mp-footer-stat-n">★4.9</span><span class="mp-footer-stat-l">Rated</span></div>
    </div>
    <a href="/pages/miss-pretty" class="mp-footer-cta">
      About Miss Pretty
      <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

</div>

<script>
(function(){
  /* ADD TO CART */
  window.mpATC = function(btn){
    var vid=btn.dataset.vid; if(!vid) return;
    var orig=btn.innerHTML;
    btn.innerHTML='Adding…';btn.disabled=true;btn.style.opacity='.65';
    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:parseInt(vid),quantity:1})
    })
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.id){
        btn.innerHTML='✓ Added to Cart';btn.style.opacity='1';btn.style.background='#2d7a3a';btn.style.color='#fff';
        setTimeout(function(){
          btn.innerHTML=orig;btn.style.background='';btn.style.color='';btn.disabled=false;
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          // try to open cart drawer if theme supports it
          var cartIcon=document.querySelector('[data-cart-count],[data-cart-toggle]');
          if(cartIcon) cartIcon.click();
        },1800);
      }
    })
    .catch(function(){btn.innerHTML=orig;btn.style.opacity='1';btn.disabled=false;});
  };

  /* FILTER */
  var cats=document.querySelectorAll('.mp-cat-btn');
  var grid=document.getElementById('mp-grid');
  var nores=document.getElementById('mp-nores');
  var visEl=document.getElementById('mp-vis');
  var activeCat='all';

  function doFilter(cat){
    activeCat=cat;
    var cards=grid.querySelectorAll('.mp-card'),n=0;
    cards.forEach(function(c){
      var show=cat==='all'||c.dataset.cat===cat;
      c.classList.toggle('mp-hidden',!show);
      if(show)n++;
    });
    if(visEl)visEl.textContent=n;
    if(nores)nores.classList.toggle('show',n===0);
  }

  cats.forEach(function(btn){
    btn.addEventListener('click',function(){
      cats.forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      doFilter(btn.dataset.cat);
    });
  });

  window.mpReset=function(){
    cats.forEach(function(b){b.classList.remove('active');});
    var all=document.querySelector('.mp-cat-btn[data-cat="all"]');
    if(all)all.classList.add('active');
    doFilter('all');
  };

  /* SORT */
  var sortEl=document.getElementById('mp-sort');
  if(sortEl&&grid){
    sortEl.addEventListener('change',function(){
      var items=Array.from(grid.querySelectorAll('.mp-card'));
      var v=sortEl.value;
      items.sort(function(a,b){
        if(v==='price-asc')  return +a.dataset.price - +b.dataset.price;
        if(v==='price-desc') return +b.dataset.price - +a.dataset.price;
        if(v==='disc-desc')  return +b.dataset.disc  - +a.dataset.disc;
        if(v==='az')         return (a.dataset.title||'').localeCompare(b.dataset.title||'');
        return 0;
      });
      items.forEach(function(c){grid.appendChild(c);});
    });
  }
})();
</script>

