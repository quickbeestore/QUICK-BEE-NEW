{% comment %} MISS PRETTY × Maybelline — Mobile-First, Products First {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
.mp,.mp *,.mp *::before,.mp *::after{box-sizing:border-box;margin:0;padding:0;}
.mp{
  --gold:#d4a843;--gold-lt:#f0c76a;--gold-dk:#a8832e;
  --pink:#e8507a;--bg:#0a0a0f;--card:rgba(255,255,255,.05);
  --br:rgba(212,168,67,.18);--br-h:rgba(212,168,67,.6);
  --text:#f0e8d5;--muted:#8a8090;
  --r:14px;--r-sm:8px;
  font-family:'Poppins',sans-serif;
  background:var(--bg);color:var(--text);
  position:relative;
}

/* STICKY TOPBAR */
.mp-topbar{
  position:sticky;top:0;z-index:50;
  background:rgba(10,10,15,.94);
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border-bottom:1px solid var(--br);
  padding:10px 12px;
}
.mp-topbar-inner{display:flex;align-items:center;gap:10px;max-width:1320px;margin:0 auto;}
.mp-topbar-brand{
  font-family:'Playfair Display',serif;font-size:.82rem;font-weight:800;
  background:linear-gradient(135deg,var(--gold),var(--gold-lt));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  white-space:nowrap;flex-shrink:0;
}
.mp-topbar-x{color:var(--pink);font-style:italic;-webkit-text-fill-color:var(--pink);margin:0 3px;}
.mp-pills-wrap{flex:1;overflow-x:auto;display:flex;gap:7px;scrollbar-width:none;-ms-overflow-style:none;padding-bottom:1px;}
.mp-pills-wrap::-webkit-scrollbar{display:none;}
.mp-pill{
  display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:20px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);
  color:var(--muted);font-size:.65rem;font-weight:600;letter-spacing:.05em;
  white-space:nowrap;cursor:pointer;flex-shrink:0;transition:all .18s;
}
.mp-pill.active{background:linear-gradient(135deg,rgba(212,168,67,.2),rgba(240,199,106,.1));border-color:var(--gold);color:var(--gold-lt);}
.mp-pill-ct{font-size:.58rem;background:rgba(255,255,255,.07);border-radius:8px;padding:0 5px;color:var(--muted);}
.mp-pill.active .mp-pill-ct{background:rgba(212,168,67,.2);color:var(--gold);}

/* SORT ROW */
.mp-sort-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 12px 0;gap:8px;max-width:1320px;margin:0 auto;width:100%;
}
.mp-count{font-size:.72rem;color:var(--muted);}
.mp-count strong{color:var(--gold-lt);font-weight:600;}
.mp-sort{
  background:rgba(255,255,255,.05);border:1px solid var(--br);color:var(--text);
  font-family:'Poppins',sans-serif;font-size:.7rem;padding:5px 10px;
  border-radius:var(--r-sm);cursor:pointer;outline:none;appearance:none;-webkit-appearance:none;
  transition:border-color .2s;
}
.mp-sort:focus{border-color:var(--gold);}

/* GRID */
.mp-grid-wrap{padding:10px 10px 0;max-width:1320px;margin:0 auto;width:100%;}
.mp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
@media(min-width:600px){.mp-grid{grid-template-columns:repeat(3,1fr);gap:14px;}}
@media(min-width:1024px){.mp-grid{grid-template-columns:repeat(4,1fr);gap:16px;}}

.mp-card{
  background:var(--card);border:1px solid var(--br);border-radius:var(--r);
  overflow:hidden;display:flex;flex-direction:column;
  text-decoration:none;color:inherit;position:relative;
  transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s,border-color .25s;
  animation:mp-in .4s ease both;
}
.mp-card:hover{transform:translateY(-4px) scale(1.01);box-shadow:0 12px 40px rgba(212,168,67,.2);border-color:var(--br-h);}
.mp-card.mp-hidden{display:none;}
@keyframes mp-in{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

/* IMAGE */
.mp-img{position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;flex-shrink:0;}
.mp-img img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .45s ease;}
.mp-card:hover .mp-img img{transform:scale(1.08);}
.mp-img-overlay{
  position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,transparent 45%,rgba(10,10,15,.85) 100%);
}

/* placeholder tints */
.mp-ph{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:14px;text-align:center;}
.mp-ph-icon{font-size:2.2rem;}
.mp-ph-name{font-size:.65rem;font-weight:600;color:rgba(255,255,255,.82);line-height:1.3;text-shadow:0 1px 4px rgba(0,0,0,.5);}
.mp-cat-foundation{background:linear-gradient(145deg,rgba(220,170,130,.32),rgba(180,130,100,.44));}
.mp-cat-mascara{background:linear-gradient(145deg,rgba(20,20,50,.72),rgba(40,30,70,.62));}
.mp-cat-lip{background:linear-gradient(145deg,rgba(180,50,80,.44),rgba(140,30,60,.52));}
.mp-cat-concealer{background:linear-gradient(145deg,rgba(200,170,150,.35),rgba(180,150,130,.42));}
.mp-cat-highlighter{background:linear-gradient(145deg,rgba(230,200,100,.36),rgba(200,160,60,.42));}
.mp-cat-powder{background:linear-gradient(145deg,rgba(200,160,140,.32),rgba(180,140,120,.38));}
.mp-cat-primer{background:linear-gradient(145deg,rgba(120,160,200,.36),rgba(100,140,180,.42));}
.mp-cat-eyeliner{background:linear-gradient(145deg,rgba(15,15,35,.74),rgba(30,20,50,.64));}
.mp-cat-blush{background:linear-gradient(145deg,rgba(220,130,150,.36),rgba(200,100,130,.42));}
.mp-cat-default{background:linear-gradient(145deg,rgba(100,160,190,.34),rgba(80,140,170,.42));}

/* BADGES */
.mp-badges{position:absolute;top:7px;left:7px;z-index:5;display:flex;flex-direction:column;gap:4px;}
.mp-badge{font-size:.5rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:20px;line-height:1.5;}
.mp-badge--hot{background:linear-gradient(135deg,#c0392b,var(--pink));color:#fff;box-shadow:0 2px 8px rgba(200,50,80,.4);}
.mp-badge--sale{background:linear-gradient(135deg,var(--gold-dk),var(--gold));color:#1a0e00;box-shadow:0 2px 8px rgba(212,168,67,.35);}

/* category chip bottom-right of image */
.mp-cat-chip{
  position:absolute;bottom:8px;right:8px;z-index:5;
  font-size:.5rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;
  padding:2px 8px;border-radius:20px;
  background:rgba(10,10,15,.75);color:var(--muted);
  border:1px solid rgba(255,255,255,.1);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
}

/* CARD BODY */
.mp-body{padding:10px 10px 4px;display:flex;flex-direction:column;flex:1;gap:5px;}
.mp-name{
  font-family:'Playfair Display',serif;
  font-size:.82rem;font-weight:700;color:var(--gold-lt);line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:2.6em;
}
.mp-pricing{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:2px;}
.mp-price{font-size:1rem;font-weight:700;color:var(--gold);letter-spacing:.01em;}
.mp-compare{font-size:.72rem;color:var(--muted);text-decoration:line-through;}
.mp-off{
  font-size:.55rem;font-weight:700;
  background:rgba(212,168,67,.12);color:var(--gold);
  padding:1px 6px;border-radius:8px;border:1px solid rgba(212,168,67,.22);
}

/* ADD TO CART */
.mp-atc{
  display:flex;align-items:center;justify-content:center;gap:6px;
  margin:8px 0 10px;padding:11px;border:none;border-radius:var(--r-sm);
  background:linear-gradient(135deg,var(--gold-dk),var(--gold) 50%,var(--gold-lt));
  background-size:200% 200%;background-position:0% 50%;
  color:#1a0e00;font-family:'Poppins',sans-serif;
  font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  cursor:pointer;width:100%;
  box-shadow:0 3px 14px rgba(212,168,67,.28);
  transition:background-position .3s,box-shadow .2s,transform .15s;
}
.mp-atc:hover{background-position:100% 50%;box-shadow:0 5px 22px rgba(212,168,67,.48);transform:translateY(-1px);}
.mp-atc:active{transform:translateY(0);}
.mp-atc svg{width:13px;height:13px;fill:currentColor;flex-shrink:0;}

/* NO RESULTS */
.mp-nores{display:none;flex-direction:column;align-items:center;gap:10px;padding:48px 20px;text-align:center;}
.mp-nores.show{display:flex;}
.mp-nores p{color:var(--muted);font-size:.85rem;}
.mp-nores button{padding:7px 20px;background:transparent;border:1px solid var(--br);border-radius:var(--r-sm);color:var(--gold);font-family:'Poppins',sans-serif;font-size:.72rem;cursor:pointer;transition:all .2s;}
.mp-nores button:hover{border-color:var(--gold);background:rgba(212,168,67,.08);}

/* PAGINATION */
.mp-pages{display:flex;justify-content:center;gap:7px;padding:20px 12px 16px;flex-wrap:wrap;}
.mp-page{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;padding:0 10px;border:1px solid var(--br);border-radius:var(--r-sm);background:var(--card);color:var(--muted);text-decoration:none;font-size:.75rem;font-weight:500;transition:all .2s;}
.mp-page:hover,.mp-page.cur{border-color:var(--gold);color:var(--gold);background:rgba(212,168,67,.08);}

/* BRAND FOOTER — bottom where it belongs */
.mp-brand-footer{
  position:relative;overflow:hidden;margin:20px 10px 14px;border-radius:var(--r);
  background:linear-gradient(135deg,#0f0b18,#180d1f,#0d0f1a);
  border:1px solid rgba(212,168,67,.25);padding:28px 20px 24px;text-align:center;
}
.mp-brand-footer::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(ellipse 70% 60% at 20% 50%,rgba(232,80,122,.1) 0%,transparent 60%),
    radial-gradient(ellipse 60% 60% at 80% 50%,rgba(212,168,67,.1) 0%,transparent 60%);
}
.mp-bf-eyebrow{font-size:.58rem;font-weight:700;letter-spacing:.38em;text-transform:uppercase;color:var(--pink);margin-bottom:10px;}
.mp-bf-title{font-family:'Playfair Display',serif;font-size:clamp(1.5rem,5vw,2.4rem);font-weight:800;line-height:1.1;margin-bottom:10px;position:relative;z-index:1;}
.mp-bf-may{background:linear-gradient(135deg,#fff,#e0d4c0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.mp-bf-x{color:var(--pink);font-style:italic;-webkit-text-fill-color:var(--pink);margin:0 6px;}
.mp-bf-mp{background:linear-gradient(135deg,var(--gold),var(--gold-lt));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.mp-bf-sub{font-size:.75rem;color:var(--muted);margin-bottom:18px;position:relative;z-index:1;}
.mp-bf-stats{display:flex;justify-content:center;gap:24px;flex-wrap:wrap;position:relative;z-index:1;margin-bottom:20px;}
.mp-bf-stat-num{display:block;font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--gold);}
.mp-bf-stat-lbl{font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);}
.mp-bf-cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 28px;border-radius:30px;text-decoration:none;
  background:linear-gradient(135deg,var(--gold-dk),var(--gold),var(--gold-lt));
  color:#1a0e00;font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  box-shadow:0 4px 20px rgba(212,168,67,.35);position:relative;z-index:1;
  transition:box-shadow .2s,transform .15s;
}
.mp-bf-cta:hover{box-shadow:0 6px 30px rgba(212,168,67,.55);transform:translateY(-1px);}
.mp-bf-cta svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;}
</style>

{%- assign mp_count = collection.products_count -%}

{%- comment -%} Count per category — outside paginate {%- endcomment -%}
{%- assign cnt_lip=0 -%}{%- assign cnt_foundation=0 -%}{%- assign cnt_mascara=0 -%}
{%- assign cnt_concealer=0 -%}{%- assign cnt_powder=0 -%}{%- assign cnt_primer=0 -%}
{%- assign cnt_highlighter=0 -%}{%- assign cnt_eyeliner=0 -%}{%- assign cnt_blush=0 -%}
{%- for product in collection.products -%}
  {%- assign t = product.title | downcase -%}
  {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}{%- assign cnt_foundation=cnt_foundation|plus:1 -%}
  {%- elsif t contains 'mascara' -%}{%- assign cnt_mascara=cnt_mascara|plus:1 -%}
  {%- elsif t contains 'lip' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}{%- assign cnt_lip=cnt_lip|plus:1 -%}
  {%- elsif t contains 'concealer' -%}{%- assign cnt_concealer=cnt_concealer|plus:1 -%}
  {%- elsif t contains 'powder' -%}{%- assign cnt_powder=cnt_powder|plus:1 -%}
  {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}{%- assign cnt_primer=cnt_primer|plus:1 -%}
  {%- elsif t contains 'highlighter' or t contains 'chrome' -%}{%- assign cnt_highlighter=cnt_highlighter|plus:1 -%}
  {%- elsif t contains 'eyeliner' -%}{%- assign cnt_eyeliner=cnt_eyeliner|plus:1 -%}
  {%- elsif t contains 'blush' or t contains 'cheek' -%}{%- assign cnt_blush=cnt_blush|plus:1 -%}
  {%- endif -%}
{%- endfor -%}

<div class="mp">

  <!-- STICKY TOPBAR -->
  <div class="mp-topbar">
    <div class="mp-topbar-inner">
      <div class="mp-topbar-brand">Miss Pretty<span class="mp-topbar-x">×</span>Maybelline</div>
      <div class="mp-pills-wrap" id="mp-pills">
        <button class="mp-pill active" data-cat="all">All <span class="mp-pill-ct">{{ mp_count }}</span></button>
        {%- if cnt_lip > 0 -%}<button class="mp-pill" data-cat="lip">💄 Lips <span class="mp-pill-ct">{{ cnt_lip }}</span></button>{%- endif -%}
        {%- if cnt_foundation > 0 -%}<button class="mp-pill" data-cat="foundation">🌟 Foundation <span class="mp-pill-ct">{{ cnt_foundation }}</span></button>{%- endif -%}
        {%- if cnt_concealer > 0 -%}<button class="mp-pill" data-cat="concealer">🌸 Concealer <span class="mp-pill-ct">{{ cnt_concealer }}</span></button>{%- endif -%}
        {%- if cnt_mascara > 0 -%}<button class="mp-pill" data-cat="mascara">✨ Mascara <span class="mp-pill-ct">{{ cnt_mascara }}</span></button>{%- endif -%}
        {%- if cnt_powder > 0 -%}<button class="mp-pill" data-cat="powder">🌷 Powder <span class="mp-pill-ct">{{ cnt_powder }}</span></button>{%- endif -%}
        {%- if cnt_primer > 0 -%}<button class="mp-pill" data-cat="primer">💎 Primer <span class="mp-pill-ct">{{ cnt_primer }}</span></button>{%- endif -%}
        {%- if cnt_highlighter > 0 -%}<button class="mp-pill" data-cat="highlighter">✨ Highlight <span class="mp-pill-ct">{{ cnt_highlighter }}</span></button>{%- endif -%}
        {%- if cnt_eyeliner > 0 -%}<button class="mp-pill" data-cat="eyeliner">🖋 Eyeliner <span class="mp-pill-ct">{{ cnt_eyeliner }}</span></button>{%- endif -%}
        {%- if cnt_blush > 0 -%}<button class="mp-pill" data-cat="blush">🌹 Blush <span class="mp-pill-ct">{{ cnt_blush }}</span></button>{%- endif -%}
      </div>
    </div>
  </div>

  {%- if mp_count > 0 -%}

  <!-- SORT ROW -->
  <div class="mp-sort-row">
    <div class="mp-count">Showing <strong id="mp-vis-count">{{ mp_count }}</strong> products</div>
    <select class="mp-sort" id="mp-sort" aria-label="Sort products">
      <option value="">Default</option>
      <option value="price-asc">Price ↑</option>
      <option value="price-desc">Price ↓</option>
      <option value="disc-desc">Best Deal</option>
      <option value="az">A → Z</option>
    </select>
  </div>

  <!-- PRODUCTS FIRST — above the fold -->
  {%- paginate collection.products by 100 -%}
  <div class="mp-grid-wrap">
    <div class="mp-grid" id="mp-grid">

      {%- for product in collection.products -%}
        {%- assign pp = product.price -%}
        {%- assign cp = product.compare_at_price -%}
        {%- assign disc = 0 -%}
        {%- if cp > pp -%}{%- assign diff = cp | minus: pp -%}{%- assign disc = diff | times: 100 | divided_by: cp -%}{%- endif -%}

        {%- assign t = product.title | downcase -%}
        {%- if t contains 'foundation' or t contains 'bb cream' or t contains 'dewy' or t contains 'lumi' or t contains 'glow' -%}
          {%- assign cat='foundation' -%}{%- assign icon='🌟' -%}{%- assign cat_lbl='Foundation' -%}
        {%- elsif t contains 'mascara' -%}
          {%- assign cat='mascara' -%}{%- assign icon='✨' -%}{%- assign cat_lbl='Mascara' -%}
        {%- elsif t contains 'lip' or t contains 'tint' or t contains 'gloss' or t contains 'crayon' or t contains 'teddy' or t contains 'vinyl ink' or t contains 'matte ink' or t contains 'serum' -%}
          {%- assign cat='lip' -%}{%- assign icon='💄' -%}{%- assign cat_lbl='Lips' -%}
        {%- elsif t contains 'concealer' -%}
          {%- assign cat='concealer' -%}{%- assign icon='🌸' -%}{%- assign cat_lbl='Concealer' -%}
        {%- elsif t contains 'powder' -%}
          {%- assign cat='powder' -%}{%- assign icon='🌷' -%}{%- assign cat_lbl='Powder' -%}
        {%- elsif t contains 'primer' or t contains 'pore eraser' or t contains 'jelly' -%}
          {%- assign cat='primer' -%}{%- assign icon='💎' -%}{%- assign cat_lbl='Primer' -%}
        {%- elsif t contains 'highlighter' or t contains 'chrome' -%}
          {%- assign cat='highlighter' -%}{%- assign icon='✨' -%}{%- assign cat_lbl='Highlighter' -%}
        {%- elsif t contains 'eyeliner' -%}
          {%- assign cat='eyeliner' -%}{%- assign icon='🖋' -%}{%- assign cat_lbl='Eyeliner' -%}
        {%- elsif t contains 'blush' or t contains 'cheek' -%}
          {%- assign cat='blush' -%}{%- assign icon='🌹' -%}{%- assign cat_lbl='Blush' -%}
        {%- else -%}
          {%- assign cat='default' -%}{%- assign icon='💫' -%}{%- assign cat_lbl='Makeup' -%}
        {%- endif -%}

        <a href="{{ product.url }}" class="mp-card"
          data-cat="{{ cat }}"
          data-price="{{ pp }}"
          data-disc="{{ disc }}"
          data-title="{{ product.title | escape }}"
          style="animation-delay:{{ forloop.index0 | times: 0.03 }}s"
        >
          <div class="mp-img mp-cat-{{ cat }}">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                width="400" height="400"
              >
            {%- else -%}
              <div class="mp-ph">
                <div class="mp-ph-icon">{{ icon }}</div>
                <div class="mp-ph-name">{{ product.title | remove: 'Maybelline ' | truncate: 38 }}</div>
              </div>
            {%- endif -%}
            <div class="mp-img-overlay"></div>
            <div class="mp-badges">
              <span class="mp-badge mp-badge--hot">Hot</span>
              {%- if disc >= 10 -%}<span class="mp-badge mp-badge--sale">{{ disc }}% OFF</span>{%- endif -%}
            </div>
            <span class="mp-cat-chip">{{ cat_lbl }}</span>
          </div>

          <div class="mp-body">
            <div class="mp-name">{{ product.title }}</div>
            <div class="mp-pricing">
              <span class="mp-price">Rs {{ pp | divided_by: 100 }}</span>
              {%- if cp > pp -%}
                <span class="mp-compare">Rs {{ cp | divided_by: 100 }}</span>
                {%- if disc >= 5 -%}<span class="mp-off">{{ disc }}% OFF</span>{%- endif -%}
              {%- endif -%}
            </div>
            <button class="mp-atc" data-vid="{{ product.variants.first.id }}" onclick="event.preventDefault();mpATC(this)">
              <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
              Add to Cart
            </button>
          </div>
        </a>
      {%- endfor -%}

    </div>

    <div class="mp-nores" id="mp-nores">
      <div style="font-size:2.5rem">🔍</div>
      <p>No products in this category.</p>
      <button onclick="mpReset()">Show All</button>
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
    <div class="mp-pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="mp-page">‹</a>{%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}<a href="{{ part.url }}" class="mp-page">{{ part.title }}</a>
        {%- else -%}<span class="mp-page cur">{{ part.title }}</span>{%- endif -%}
      {%- endfor -%}
