{% comment %}QuickBee — Simple Add to Home Screen button{% endcomment %}

<div class="qb-aths-wrap" id="qb-aths-wrap">
  <button class="qb-aths-btn" id="qb-aths-btn" type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="5" y="2" width="14" height="20" rx="3" stroke="currentColor" stroke-width="2"/>
      <path d="M12 8v8M9 13l3 3 3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    {{ section.settings.button_label }}
  </button>
</div>

<style>
  .qb-aths-wrap {
    display: flex;
    justify-content: center;
    padding: 20px 16px 8px;
  }

  .qb-aths-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: transparent;
    border: 1.5px solid rgba(255, 184, 0, 0.4);
    border-radius: 50px;
    color: var(--color-foreground);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    font-family: var(--font-body--family, sans-serif);
    opacity: 0.75;
  }

  .qb-aths-btn:hover {
    border-color: #FFB800;
    color: #FFB800;
    background: rgba(255, 184, 0, 0.06);
    opacity: 1;
  }

  .qb-aths-btn svg {
    flex-shrink: 0;
  }
</style>

<script>
(function () {
  var isInStandaloneMode =
    window.navigator.standalone === true ||
    window.matchMedia('(display-mode: standalone)').matches;

  var wrap = document.getElementById('qb-aths-wrap');
  var btn  = document.getElementById('qb-aths-btn');
  var deferredPrompt = null;
  var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !window.MSStream;

  /* Hide if already installed */
  if (isInStandaloneMode && wrap) { wrap.style.display = 'none'; return; }

  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault();
    deferredPrompt = e;
  });

  window.addEventListener('appinstalled', function () {
    if (wrap) wrap.style.display = 'none';
  });

  if (!btn) return;

  btn.addEventListener('click', function () {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(function () { deferredPrompt = null; });
    } else if (isIOS) {
      alert('Tap the Share button 📤 then "Add to Home Screen" to install QuickBee.');
    } else {
      btn.textContent = 'Open in browser menu → Add to Home Screen';
      btn.disabled = true;
    }
  });
})();
</script>

{% schema %}
{
  "name": "QB Install Button",
  "tag": "section",
  "class": "qb-install-prompt-section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Add QuickBee to Home Screen"
    }
  ],
  "presets": [{ "name": "QB Install Button" }]
}
{% endschema %}
