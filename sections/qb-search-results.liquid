<div class="qbsr-toast" id="qbsrToast"></div>

<script>
(function(){
  /* ── Delivery time sync ── */
  function syncTime(){
    var r=(window.QB_DELIVERY_TIME&&window.QB_DELIVERY_TIME.range)||'20 mins';
    document.querySelectorAll('.qbsr-time-sync').forEach(function(b){b.textContent='⚡ '+r;});
  }
  document.readyState==='loading'?document.addEventListener('DOMContentLoaded',syncTime):syncTime();
  window.addEventListener('locationSelected',function(){setTimeout(syncTime,50);});

  /* ── Toast ── */
  function toast(msg,err){
    var t=document.getElementById('qbsrToast');
    if(!t)return;
    t.textContent=msg;
    t.className='qbsr-toast show'+(err?' error':'');
    clearTimeout(t._t);
    t._t=setTimeout(function(){t.classList.remove('show');},2600);
  }

  /* ── Add to cart ── */
  document.addEventListener('click',function(e){
    var btn=e.target.closest('.qbsr-add-btn');
    if(!btn||btn.classList.contains('loading')||btn.classList.contains('success'))return;
    var vid=btn.getAttribute('data-variant');
    var name=btn.getAttribute('data-name')||'Item';
    if(!vid||vid==='null'||vid===''){toast('Out of stock',true);return;}
    btn.classList.add('loading');
    btn.innerHTML='<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({id:parseInt(vid,10),quantity:1})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.id){
        btn.classList.remove('loading');btn.classList.add('success');btn.innerHTML='✓ Added';
        toast('✅ '+name+' added!');
        document.dispatchEvent(new CustomEvent('cart:updated'));
        fetch('/cart.js').then(function(r){return r.json();}).then(function(c){var el=document.getElementById('cart-count');if(el)el.textContent=c.item_count;});
        setTimeout(function(){btn.classList.remove('success');btn.innerHTML='<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> ADD';},2200);
      } else { throw new Error(d.description||'Failed'); }
    })
    .catch(function(){
      btn.classList.remove('loading');btn.classList.add('error');btn.innerHTML='✗ Error';
      toast('Could not add item',true);
      setTimeout(function(){btn.classList.remove('error');btn.innerHTML='<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> ADD';},2000);
    });
  });
})();
</script>

