{%- liquid
  assign p = product
  assign ptype = p.type | downcase
  assign first_v = p.variants.first

  if ptype contains 'massage'
    assign sp_icon = '💆' | append: ''
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Massage Therapy'
    assign sp_bg = 'linear-gradient(160deg,#080e09,#0c150d)'
  elsif ptype contains 'facial'
    assign sp_icon = '✨'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Facial Treatment'
    assign sp_bg = 'linear-gradient(160deg,#0a0808,#130e0c)'
  elsif ptype contains 'nail'
    assign sp_icon = '💅'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Nail Care'
    assign sp_bg = 'linear-gradient(160deg,#09090e,#0d0c13)'
  elsif ptype contains 'threading' or ptype contains 'hair'
    assign sp_icon = '✂️'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Hair & Beauty'
    assign sp_bg = 'linear-gradient(160deg,#080e09,#0c150d)'
  elsif ptype contains 'vip'
    assign sp_icon = '👑'
    assign sp_color = '#E8C97A'
    assign sp_tag = 'VIP Experience'
    assign sp_bg = 'linear-gradient(160deg,#0e0c05,#16120a)'
  elsif ptype contains 'spa'
    assign sp_icon = '🛁'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Spa Package'
    assign sp_bg = 'linear-gradient(160deg,#050e0e,#08141a)'
  elsif ptype contains 'scrub' or ptype contains 'body'
    assign sp_icon = '🧖'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Body Treatment'
    assign sp_bg = 'linear-gradient(160deg,#080e09,#0c150d)'
  else
    assign sp_icon = '🪷'
    assign sp_color = '#C9A84C'
    assign sp_tag = 'Wellness'
    assign sp_bg = 'linear-gradient(160deg,#080e09,#0c150d)'
  endif
-%}

<style>
*, *::before, *::after { box-sizing: border-box; }
.sp-root {
  --g: #C9A84C;
  --g2: #E8C97A;
  --gd: rgba(201,168,76,.12);
  --gb: rgba(201,168,76,.25);
  --green: #00c86a;
  --grd: rgba(0,200,106,.1);
  --grb: rgba(0,200,106,.28);
  --t: #f0ede8;
  --t2: rgba(240,237,232,.52);
  --t3: rgba(240,237,232,.26);
  --bd: rgba(201,168,76,.15);
  --card: rgba(255,255,255,.03);
  --card2: rgba(255,255,255,.055);
  --sh: 0 8px 40px rgba(0,0,0,.55);
  background: #07100a;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: var(--t);
  padding-bottom: 110px;
}
html:not([data-theme="dark"]) .sp-root {
  --g: #8a6b10;
  --g2: #a07c18;
  --gd: rgba(138,107,16,.1);
  --gb: rgba(138,107,16,.3);
  --green: #16a34a;
  --grd: rgba(22,163,74,.08);
  --grb: rgba(22,163,74,.25);
  --t: #13100a;
  --t2: rgba(19,16,10,.5);
  --t3: rgba(19,16,10,.28);
  --bd: rgba(138,107,16,.15);
  --card: rgba(0,0,0,.028);
  --card2: rgba(0,0,0,.05);
  --sh: 0 4px 24px rgba(0,0,0,.08);
  background: #f5f0e4;
}

/* ── HERO ── */
.sp-hero {
  position: relative;
  overflow: hidden;
  padding: 0 0 32px;
  text-align: center;
}
.sp-hero-bg {
  position: absolute; inset: 0;
  background: {{ sp_bg }};
  z-index: 0;
}
html:not([data-theme="dark"]) .sp-hero-bg { background: linear-gradient(160deg,#fff,#f5f0e4); }
.sp-hero-bg::after {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(201,168,76,.07) 1px, transparent 1px);
  background-size: 28px 28px;
}
.sp-hero-glow {
  position: absolute;
  top: -100px; left: 50%; transform: translateX(-50%);
  width: 500px; height: 400px;
  background: radial-gradient(ellipse, rgba(201,168,76,.12) 0%, transparent 70%);
  pointer-events: none; z-index: 1;
}
.sp-hero-inner {
  position: relative; z-index: 2;
  padding: 40px 20px 0;
}
.sp-hero-vendor {
  font-size: 10px; font-weight: 900; letter-spacing: .22em;
  text-transform: uppercase; color: var(--g); opacity: .8;
  margin-bottom: 20px;
}
.sp-hero-badge {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--grd); border: 1px solid var(--grb);
  color: var(--green); font-size: 10px; font-weight: 900;
  letter-spacing: .1em; text-transform: uppercase;
  padding: 6px 14px; border-radius: 50px; margin-bottom: 20px;
}
.sp-live-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: spPulse 1.5s ease infinite; }
@keyframes spPulse { 0%,100%{opacity:1} 50%{opacity:.2} }
.sp-hero-icon {
  width: 88px; height: 88px; border-radius: 26px;
  background: var(--gd); border: 1.5px solid var(--gb);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 42px; margin-bottom: 22px;
  box-shadow: 0 0 60px rgba(201,168,76,.2), 0 12px 40px rgba(0,0,0,.4);
}
.sp-hero-type {
  display: inline-block; font-size: 11px; font-weight: 800;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--g); background: var(--gd); border: 1px solid var(--gb);
  padding: 4px 14px; border-radius: 50px; margin-bottom: 16px;
}
.sp-hero-title {
  font-size: clamp(24px, 6vw, 38px); font-weight: 900;
  letter-spacing: -.6px; line-height: 1.12;
  color: var(--t); margin: 0 0 20px;
}
.sp-hero-divider {
  width: 48px; height: 2px; margin: 0 auto 20px;
  background: linear-gradient(90deg, transparent, var(--g), transparent);
  border-radius: 2px;
}
.sp-hero-desc {
  font-size: 14.5px; color: var(--t2); line-height: 1.75;
  max-width: 500px; margin: 0 auto 24px;
  text-align: left;
}
.sp-hero-pills {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
  margin-bottom: 28px;
}
.sp-hero-pill {
  display: inline-flex; align-items: center; gap: 5px;
  background: var(--gd); border: 1px solid var(--gb);
  color: var(--g); font-size: 11.5px; font-weight: 700;
  padding: 7px 14px; border-radius: 50px;
}
.sp-hero-price-banner {
  display: inline-flex; align-items: baseline; gap: 6px;
  background: linear-gradient(135deg, rgba(201,168,76,.15), rgba(201,168,76,.06));
  border: 1.5px solid var(--gb); border-radius: 18px;
  padding: 14px 28px;
}
.sp-hero-price-from { font-size: 11px; font-weight: 700; color: var(--t3); text-transform: uppercase; letter-spacing: .08em; }
.sp-hero-price-val { font-size: 32px; font-weight: 900; color: var(--t); letter-spacing: -1px; }
.sp-hero-price-cur { font-size: 13px; font-weight: 600; color: var(--t2); }

/* ── MARQUEE ── */
.sp-marquee { overflow: hidden; border-top: 1px solid var(--bd); border-bottom: 1px solid var(--bd); padding: 10px 0; background: rgba(201,168,76,.03); margin-top: 28px; }
.sp-marquee-track { display: flex; width: max-content; animation: spMq 24s linear infinite; }
.sp-marquee-track:hover { animation-play-state: paused; }
@keyframes spMq { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.sp-mq-item { white-space: nowrap; font-size: 10.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--g); opacity: .5; padding: 0 18px; }
.sp-mq-dot { color: var(--g); opacity: .25; }

/* ── BODY ── */
.sp-body { max-width: 620px; margin: 0 auto; padding: 20px 14px 0; display: flex; flex-direction: column; gap: 14px; }
.sp-section { background: var(--card); border: 1px solid var(--bd); border-radius: 24px; overflow: hidden; }
.sp-section-hdr {
  padding: 18px 20px 16px; border-bottom: 1px solid var(--bd);
  display: flex; align-items: center; gap: 10px;
}
.sp-section-hdr-icon { font-size: 17px; }
.sp-section-hdr-label { font-size: 13.5px; font-weight: 800; color: var(--t); }
.sp-section-hdr-sub { font-size: 11px; color: var(--t3); margin-top: 1px; }

/* ── VARIANTS ── */
.sp-variants-wrap { padding: 18px 20px 20px; }
.sp-variants-lbl { font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; color: var(--t3); margin-bottom: 13px; }
.sp-variants-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
@media(min-width:420px){ .sp-variants-grid { grid-template-columns: 1fr 1fr; } }
@media(min-width:600px){ .sp-variants-grid { grid-template-columns: repeat(3,1fr); } }
.sp-var {
  position: relative; background: rgba(255,255,255,.03); border: 1.5px solid var(--bd);
  border-radius: 16px; padding: 15px 15px 13px; cursor: pointer;
  font-family: inherit; text-align: left; transition: all .2s;
  -webkit-tap-highlight-color: transparent;
}
html:not([data-theme="dark"]) .sp-var { background: rgba(0,0,0,.025); }
.sp-var.sel {
  border-color: var(--g);
  background: var(--gd);
  box-shadow: 0 0 0 3px rgba(201,168,76,.18), 0 6px 24px rgba(201,168,76,.1);
}
.sp-var:active { transform: scale(.97); }
.sp-var-name { display: block; font-size: 13px; font-weight: 800; color: var(--t); line-height: 1.35; margin-bottom: 8px; }
.sp-var.sel .sp-var-name { color: var(--g); }
.sp-var-price { display: block; font-size: 16px; font-weight: 900; color: var(--t); }
.sp-var.sel .sp-var-price { color: var(--g); }
.sp-var-compare { display: block; font-size: 11px; color: var(--t3); text-decoration: line-through; margin-top: 3px; }
.sp-var-save { display: inline-block; font-size: 9.5px; font-weight: 800; background: rgba(0,200,80,.1); color: #00c850; padding: 2px 8px; border-radius: 8px; margin-top: 4px; }
.sp-var-check {
  position: absolute; top: 10px; right: 10px;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--g); display: none; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(201,168,76,.4);
}
.sp-var.sel .sp-var-check { display: flex; }
.sp-var-check svg { width: 11px; height: 11px; stroke: #000; stroke-width: 3; fill: none; }

/* ── DATE ── */
.sp-dates-wrap { padding: 16px 20px 20px; }
.sp-dates-lbl { font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; color: var(--t3); margin-bottom: 12px; }
.sp-dates-scroll { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
.sp-dates-scroll::-webkit-scrollbar { display: none; }
.sp-date-chip {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 2px;
  background: rgba(255,255,255,.03); border: 1.5px solid var(--bd);
  border-radius: 15px; padding: 11px 14px; cursor: pointer;
  font-family: inherit; transition: all .18s; min-width: 58px;
  -webkit-tap-highlight-color: transparent;
}
html:not([data-theme="dark"]) .sp-date-chip { background: rgba(0,0,0,.025); }
.sp-date-chip.sel { border-color: var(--g); background: var(--gd); box-shadow: 0 0 0 2.5px rgba(201,168,76,.2); }
.sp-date-day { font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: .07em; color: var(--t3); }
.sp-date-num { font-size: 19px; font-weight: 900; color: var(--t); line-height: 1.1; }
.sp-date-mon { font-size: 9px; font-weight: 700; text-transform: uppercase; color: var(--t3); }
.sp-date-chip.sel .sp-date-day, .sp-date-chip.sel .sp-date-num, .sp-date-chip.sel .sp-date-mon { color: var(--g); }

/* ── TIMES ── */
.sp-times-wrap { padding: 0 20px 20px; border-top: 1px solid var(--bd); }
.sp-times-lbl { font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; color: var(--t3); padding-top: 16px; margin-bottom: 12px; }
.sp-times-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
@media(min-width:420px) { .sp-times-grid { grid-template-columns: repeat(4,1fr); } }
.sp-time-btn {
  background: rgba(255,255,255,.03); border: 1.5px solid var(--bd);
  border-radius: 13px; padding: 11px 6px; cursor: pointer;
  font-family: inherit; font-size: 13px; font-weight: 800; color: var(--t2);
  transition: all .18s; text-align: center; -webkit-tap-highlight-color: transparent;
}
html:not([data-theme="dark"]) .sp-time-btn { background: rgba(0,0,0,.025); }
.sp-time-btn.sel { border-color: var(--g); background: var(--gd); color: var(--g); box-shadow: 0 0 0 2.5px rgba(201,168,76,.18); }
.sp-time-btn:active { transform: scale(.95); }

/* ── FORM ── */
.sp-form-inner { padding: 16px 20px 20px; }
.sp-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.sp-fgrp { display: flex; flex-direction: column; gap: 6px; }
.sp-fgrp.full { grid-column: 1/-1; }
.sp-flbl { font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; color: var(--t3); }
.sp-finp {
  background: rgba(255,255,255,.05); border: 1.5px solid var(--bd);
  border-radius: 13px; padding: 12px 14px;
  font-size: 14px; font-weight: 500; color: var(--t);
  font-family: inherit; outline: none; width: 100%;
  transition: border-color .18s, background .18s;
}
html:not([data-theme="dark"]) .sp-finp { background: rgba(0,0,0,.04); }
.sp-finp:focus { border-color: rgba(201,168,76,.5); background: rgba(201,168,76,.05); }
.sp-finp::placeholder { color: var(--t3); }
.sp-finp.err { border-color: #f87171; animation: spShake .36s; }
@keyframes spShake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }
textarea.sp-finp { resize: none; line-height: 1.6; }

/* ── PRICE + CTA ── */
.sp-order-wrap { padding: 22px 20px 6px; }
.sp-order-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.sp-order-lbl { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--t3); margin-bottom: 6px; }
.sp-order-price { font-size: 38px; font-weight: 900; letter-spacing: -1.5px; color: var(--t); line-height: 1; }
.sp-order-price small { font-size: 15px; font-weight: 600; color: var(--t2); letter-spacing: 0; }
.sp-order-compare { font-size: 13px; text-decoration: line-through; color: var(--t3); margin-top: 4px; }
.sp-order-save { display: inline-block; font-size: 11px; font-weight: 800; background: rgba(0,200,80,.1); color: #00c850; padding: 3px 10px; border-radius: 8px; margin-top: 6px; }
.sp-order-right { text-align: right; flex-shrink: 0; }
.sp-order-note { font-size: 11px; font-weight: 700; color: var(--t3); line-height: 1.6; }
.sp-order-note strong { color: var(--g); display: block; font-size: 12px; }
.sp-cta-btn {
  width: 100%; padding: 19px; margin-bottom: 16px;
  border: none; border-radius: 18px; cursor: pointer;
  font-family: inherit; font-size: 17px; font-weight: 900; letter-spacing: .01em;
  background: linear-gradient(135deg, #C9A84C 0%, #E8C97A 50%, #C9A84C 100%);
  background-size: 200% 100%; color: #0a0800;
  box-shadow: 0 8px 36px rgba(201,168,76,.45);
  transition: all .2s; position: relative; overflow: hidden;
  -webkit-tap-highlight-color: transparent;
  animation: spBtnSlide 3s ease infinite;
}
@keyframes spBtnSlide { 0%{background-position:0% 0} 50%{background-position:100% 0} 100%{background-position:0% 0} }
.sp-cta-btn::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.3) 50%, transparent 65%);
  background-size: 250% 100%; animation: spShimmer 3s linear infinite;
}
@keyframes spShimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.sp-cta-btn:active { transform: scale(.98); box-shadow: 0 4px 16px rgba(201,168,76,.3); }
.sp-cta-btn:disabled { opacity: .55; cursor: not-allowed; animation: none; }
.sp-cta-inner { display: flex; align-items: center; justify-content: center; gap: 10px; position: relative; z-index: 1; }

/* ── HOW IT WORKS ── */
.sp-steps { padding: 8px 20px 20px; }
.sp-step { display: flex; align-items: flex-start; gap: 15px; padding: 14px 0; border-bottom: 1px solid var(--bd); }
.sp-step:last-child { border-bottom: none; }
.sp-step-num {
  width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
  background: var(--gd); border: 1.5px solid var(--gb);
  color: var(--g); font-size: 14px; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
}
.sp-step-title { font-size: 14px; font-weight: 800; color: var(--t); margin-bottom: 3px; }
.sp-step-desc { font-size: 12.5px; color: var(--t2); line-height: 1.6; }

/* ── TRUST ── */
.sp-trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 16px; }
.sp-trust-item {
  background: var(--card2); border: 1px solid var(--bd); border-radius: 16px;
  padding: 14px 12px; display: flex; align-items: center; gap: 11px;
}
.sp-trust-ico { font-size: 24px; flex-shrink: 0; }
.sp-trust-title { font-size: 12.5px; font-weight: 800; color: var(--t); }
.sp-trust-sub { font-size: 10.5px; color: var(--t2); margin-top: 2px; }

/* ── FAQ ── */
.sp-faq-item { border-bottom: 1px solid var(--bd); }
.sp-faq-item:last-child { border-bottom: none; }
.sp-faq-btn {
  width: 100%; text-align: left; background: none; border: none;
  font-family: inherit; padding: 15px 20px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  font-size: 13.5px; font-weight: 700; color: var(--t); cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.sp-faq-arrow { font-size: 16px; color: var(--t3); transition: transform .22s; flex-shrink: 0; }
.sp-faq-item.open .sp-faq-arrow { transform: rotate(180deg); color: var(--g); }
.sp-faq-ans { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
.sp-faq-item.open .sp-faq-ans { max-height: 240px; }
.sp-faq-ans-inner { padding: 0 20px 16px; font-size: 13px; color: var(--t2); line-height: 1.7; }

/* ── TOAST ── */
.sp-toast {
  position: fixed; bottom: calc(86px + env(safe-area-inset-bottom)); left: 50%;
  transform: translateX(-50%) translateY(14px);
  background: #111; color: #fff; border: 1px solid rgba(255,255,255,.1);
  border-radius: 50px; padding: 12px 24px;
  font-size: 13.5px; font-weight: 700; white-space: nowrap;
  box-shadow: 0 8px 32px rgba(0,0,0,.55);
  z-index: 99999; opacity: 0; pointer-events: none;
  transition: all .3s cubic-bezier(.175,.885,.32,1.275);
}
.sp-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<div class="sp-root">

  <!-- ═══ HERO ═══ -->
  <div class="sp-hero">
    <div class="sp-hero-bg"></div>
    <div class="sp-hero-glow"></div>
    <div class="sp-hero-inner">
      <div class="sp-hero-vendor">{{ p.vendor }}</div>
      <div class="sp-hero-icon">{{ sp_icon }}</div><br>
      <span class="sp-hero-badge"><span class="sp-live-dot"></span> Available Now · Thamel</span>
      <div class="sp-hero-type">{{ sp_tag }}</div>
      <h1 class="sp-hero-title">{{ p.title }}</h1>
      <div class="sp-hero-divider"></div>

      {%- if p.description != blank -%}
        <div class="sp-hero-desc">{{ p.description | strip_html }}</div>
      {%- endif -%}

      <div class="sp-hero-pills">
        <span class="sp-hero-pill">📍 Thamel, Kathmandu</span>
        <span class="sp-hero-pill">🪷 Thai Certified</span>
        {%- if p.variants.size > 1 -%}
          <span class="sp-hero-pill">⏱ {{ p.variants.size }} options</span>
        {%- endif -%}
        <span class="sp-hero-pill">🔒 Private Rooms</span>
      </div>

      <div class="sp-hero-price-banner">
        <span class="sp-hero-price-from">{%- if p.price_varies -%}From{%- else -%}Price{%- endif -%}</span>
        <span class="sp-hero-price-val">{{ p.price_min | money_without_currency }}</span>
        <span class="sp-hero-price-cur">NPR</span>
      </div>
    </div>

    <!-- Marquee inside hero bottom -->
    <div class="sp-marquee" style="margin-top:28px">
      <div class="sp-marquee-track">
        {%- assign mq = "Thai Massage · Reflexology · Body Scrub · Facial · Nail Care · Steam Sauna · Jacuzzi · Aromatherapy · Hot Stone · VIP Package · Waxing · Threading" | split: "·" -%}
        {%- for _r in (1..3) -%}{%- for mi in mq -%}<span class="sp-mq-item">{{ mi | strip }}</span><span class="sp-mq-dot"> · </span>{%- endfor -%}{%- endfor -%}
      </div>
    </div>
  </div>

  <div class="sp-body">

    <!-- ═══ VARIANTS ═══ -->
    {%- if p.variants.size > 1 -%}
    <div class="sp-section">
      <div class="sp-section-hdr">
        <span class="sp-section-hdr-icon">⏱</span>
        <div>
          <div class="sp-section-hdr-label">Choose Your Package</div>
          <div class="sp-section-hdr-sub">Select duration or treatment option</div>
        </div>
      </div>
      <div class="sp-variants-wrap">
        <div class="sp-variants-lbl">{{ p.variants.size }} options available</div>
        <div class="sp-variants-grid" id="spVarGrid">
          {%- for v in p.variants -%}
            {%- assign vsave = 0 -%}
            {%- if v.compare_at_price > v.price -%}
              {%- assign vdiff = v.compare_at_price | minus: v.price -%}
              {%- assign vsave = vdiff | times: 100 | divided_by: v.compare_at_price -%}
            {%- endif -%}
            <button type="button"
              class="sp-var{% if forloop.first %} sel{% endif %}"
              data-vid="{{ v.id }}"
              data-price="{{ v.price | money_without_currency }}"
              data-compare="{%- if v.compare_at_price > v.price -%}{{ v.compare_at_price | money_without_currency }}{%- endif -%}"
              data-save="{{ vsave }}"
              {% unless v.available %}disabled style="opacity:.4"{% endunless %}>
              <span class="sp-var-name">{{ v.title }}</span>
              <span class="sp-var-price">Rs {{ v.price | money_without_currency }}</span>
              {%- if v.compare_at_price > v.price -%}
                <span class="sp-var-compare">Rs {{ v.compare_at_price | money_without_currency }}</span>
                <span class="sp-var-save">Save {{ vsave }}%</span>
              {%- endif -%}
              <span class="sp-var-check"><svg viewBox="0 0 12 12"><polyline points="2,6 5,9 10,3"/></svg></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
    {%- endif -%}

    <!-- ═══ DATE + TIME ═══ -->
    <div class="sp-section">
      <div class="sp-section-hdr">
        <span class="sp-section-hdr-icon">📅</span>
        <div>
          <div class="sp-section-hdr-label">Pick Date & Time</div>
          <div class="sp-section-hdr-sub">Book up to 14 days in advance</div>
        </div>
      </div>
      <div class="sp-dates-wrap">
        <div class="sp-dates-lbl">Select date</div>
        <div class="sp-dates-scroll" id="spDateScroll"></div>
      </div>
      <div class="sp-times-wrap">
        <div class="sp-times-lbl">Select time slot</div>
        <div class="sp-times-grid" id="spTimesGrid">
          {%- assign time_slots = "10:00,11:00,12:00,13:00,14:00,15:00,16:00,17:00,18:00,19:00,20:00" | split: "," -%}
          {%- for slot in time_slots -%}
            <button type="button" class="sp-time-btn{% if forloop.first %} sel{% endif %}" data-slot="{{ slot }}">{{ slot }}</button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- ═══ DETAILS ═══ -->
    <div class="sp-section">
      <div class="sp-section-hdr">
        <span class="sp-section-hdr-icon">👤</span>
        <div>
          <div class="sp-section-hdr-label">Your Details</div>
          <div class="sp-section-hdr-sub">We'll confirm via WhatsApp within 30 min</div>
        </div>
      </div>
      <div class="sp-form-inner">
        <div class="sp-form-grid">
          <div class="sp-fgrp">
            <label class="sp-flbl" for="spName">Full Name *</label>
            <input type="text" id="spName" class="sp-finp" placeholder="e.g. Aarav Sharma" autocomplete="name">
          </div>
          <div class="sp-fgrp">
            <label class="sp-flbl" for="spPhone">Phone / WhatsApp *</label>
            <input type="tel" id="spPhone" class="sp-finp" placeholder="e.g. 9801234567" autocomplete="tel">
          </div>
          <div class="sp-fgrp full">
            <label class="sp-flbl" for="spNotes">Special Requests <span style="font-weight:500;opacity:.6">(optional)</span></label>
            <textarea id="spNotes" class="sp-finp" rows="3" placeholder="Allergies, preferences, celebration details…"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ ORDER SUMMARY + CTA ═══ -->
    <div class="sp-section">
      <div class="sp-order-wrap">
        <div class="sp-order-row">
          <div>
            <div class="sp-order-lbl">Total to Pay</div>
            <div class="sp-order-price">Rs <span id="spPriceDisplay">{{ first_v.price | money_without_currency }}</span><small> NPR</small></div>
            <div id="spCompareWrap" style="display:none">
              <div id="spCompareDisplay" class="sp-order-compare"></div>
              <span id="spSaveDisplay" class="sp-order-save"></span>
            </div>
          </div>
          <div class="sp-order-right">
            <div class="sp-order-note">Payment<strong>✓ At Spa or Online</strong></div>
          </div>
        </div>
        <form id="spForm">
          <input type="hidden" name="id" id="spVariantId" value="{{ first_v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Treatment]" value="{{ p.title | escape }}">
          <input type="hidden" name="properties[Vendor]" value="{{ p.vendor | escape }}">
          <input type="hidden" name="properties[Booking Date]" id="spFDate" value="">
          <input type="hidden" name="properties[Time Slot]" id="spFSlot" value="">
          <input type="hidden" name="properties[Guest Name]" id="spFName" value="">
          <input type="hidden" name="properties[Phone / WhatsApp]" id="spFPhone" value="">
          <input type="hidden" name="properties[Special Requests]" id="spFNotes" value="">
          <button type="submit" class="sp-cta-btn" id="spBookBtn">
            <span class="sp-cta-inner">
              <span>🪷</span>
              <span id="spBtnTxt">Book Session →</span>
            </span>
          </button>
        </form>
      </div>
    </div>

    <!-- ═══ HOW IT WORKS ═══ -->
    <div class="sp-section">
      <div class="sp-section-hdr"><span class="sp-section-hdr-icon">📖</span><div><div class="sp-section-hdr-label">How It Works</div></div></div>
      <div class="sp-steps">
        <div class="sp-step"><div class="sp-step-num">1</div><div><div class="sp-step-title">Pick your treatment & duration</div><div class="sp-step-desc">Choose the package that suits you, select your date and preferred time slot.</div></div></div>
        <div class="sp-step"><div class="sp-step-num">2</div><div><div class="sp-step-title">Enter your details & book</div><div class="sp-step-desc">Fill in your name and WhatsApp number. We'll confirm your booking within 30 minutes.</div></div></div>
        <div class="sp-step"><div class="sp-step-num">3</div><div><div class="sp-step-title">Arrive at Thamel & relax</div><div class="sp-step-desc">Come to our Thamel location at your booked time. Your therapist will be ready and waiting.</div></div></div>
        <div class="sp-step"><div class="sp-step-num">4</div><div><div class="sp-step-title">Pay & unwind completely</div><div class="sp-step-desc">Pay at the spa or online checkout. No hidden fees — the price you see is what you pay.</div></div></div>
      </div>
    </div>

    <!-- ═══ TRUST ═══ -->
    <div class="sp-section">
      <div class="sp-trust-grid">
        <div class="sp-trust-item"><span class="sp-trust-ico">🧘</span><div><div class="sp-trust-title">Thai Certified</div><div class="sp-trust-sub">Trained in Thailand</div></div></div>
        <div class="sp-trust-item"><span class="sp-trust-ico">🌿</span><div><div class="sp-trust-title">Natural Products</div><div class="sp-trust-sub">Premium herbs & oils</div></div></div>
        <div class="sp-trust-item"><span class="sp-trust-ico">🔒</span><div><div class="sp-trust-title">Private Rooms</div><div class="sp-trust-sub">Fully confidential</div></div></div>
        <div class="sp-trust-item"><span class="sp-trust-ico">⭐</span><div><div class="sp-trust-title">4.9 Rated</div><div class="sp-trust-sub">Verified reviews</div></div></div>
      </div>
    </div>

    <!-- ═══ FAQ ═══ -->
    <div class="sp-section">
      <div class="sp-section-hdr"><span class="sp-section-hdr-icon">❓</span><div><div class="sp-section-hdr-label">Frequently Asked</div></div></div>
      <div id="spFaq">
        <div class="sp-faq-item"><button class="sp-faq-btn" type="button">Where exactly is the spa? <span class="sp-faq-arrow">⌄</span></button><div class="sp-faq-ans"><div class="sp-faq-ans-inner">Both Thamel Thai Spa and Thamel Therapy Spa are located in Thamel, Kathmandu. The exact address and map will be sent via WhatsApp upon booking confirmation.</div></div></div>
        <div class="sp-faq-item"><button class="sp-faq-btn" type="button">Can I reschedule or cancel my booking? <span class="sp-faq-arrow">⌄</span></button><div class="sp-faq-ans"><div class="sp-faq-ans-inner">Yes, free rescheduling up to 2 hours before your session. Contact us on WhatsApp and we'll sort it out with no extra charge.</div></div></div>
        <div class="sp-faq-item"><button class="sp-faq-btn" type="button">What should I bring or wear? <span class="sp-faq-arrow">⌄</span></button><div class="sp-faq-ans"><div class="sp-faq-ans-inner">Just yourself. We provide towels, robes and all treatment products. Wear comfortable clothing for your arrival — we'll handle the rest.</div></div></div>
        <div class="sp-faq-item"><button class="sp-faq-btn" type="button">Is treatment safe during pregnancy? <span class="sp-faq-arrow">⌄</span></button><div class="sp-faq-ans"><div class="sp-faq-ans-inner">We offer specially designed prenatal treatments using certified safe techniques. Please mention your pregnancy when booking so we can prepare accordingly.</div></div></div>
        <div class="sp-faq-item"><button class="sp-faq-btn" type="button">Do you offer couple packages? <span class="sp-faq-arrow">⌄</span></button><div class="sp-faq-ans"><div class="sp-faq-ans-inner">Yes! Private couple spa experiences with dedicated rooms, steam sauna, jacuzzi and simultaneous treatments are available. Browse the <a href="/collections/thamel-thai-spa" style="color:var(--g)">Thamel Thai Spa</a> collection.</div></div></div>
      </div>
    </div>

  </div>
</div>

<div class="sp-toast" id="spToast"></div>

<script>
(function(){
'use strict';
var DAYS=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
var MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
var selDate=null, selSlot='10:00';

var varId=document.getElementById('spVariantId');
var priceEl=document.getElementById('spPriceDisplay');
var cmpWrap=document.getElementById('spCompareWrap');
var cmpEl=document.getElementById('spCompareDisplay');
var saveEl=document.getElementById('spSaveDisplay');
var dateScroll=document.getElementById('spDateScroll');
var timesGrid=document.getElementById('spTimesGrid');
var nameInp=document.getElementById('spName');
var phoneInp=document.getElementById('spPhone');
var notesInp=document.getElementById('spNotes');
var fDate=document.getElementById('spFDate');
var fSlot=document.getElementById('spFSlot');
var fName=document.getElementById('spFName');
var fPhone=document.getElementById('spFPhone');
var fNotes=document.getElementById('spFNotes');
var bookBtn=document.getElementById('spBookBtn');
var btnTxt=document.getElementById('spBtnTxt');
var toast=document.getElementById('spToast');
var form=document.getElementById('spForm');

/* Build date chips */
(function(){
  var today=new Date();
  for(var i=1;i<=14;i++){
    var d=new Date(today); d.setDate(today.getDate()+i);
    var c=document.createElement('button');
    c.type='button'; c.className='sp-date-chip'+(i===1?' sel':'');
    c.setAttribute('data-date',d.toDateString());
    c.innerHTML='<span class="sp-date-day">'+DAYS[d.getDay()]+'</span><span class="sp-date-num">'+d.getDate()+'</span><span class="sp-date-mon">'+MONTHS[d.getMonth()]+'</span>';
    if(i===1){selDate=d.toDateString();if(fDate)fDate.value=selDate;}
    c.addEventListener('click',function(){
      dateScroll.querySelectorAll('.sp-date-chip').forEach(function(x){x.classList.remove('sel');});
      this.classList.add('sel');
      selDate=this.getAttribute('data-date');
      if(fDate)fDate.value=selDate;
    });
    dateScroll.appendChild(c);
  }
})();

/* Init time slot */
if(fSlot) fSlot.value=selSlot;
if(timesGrid){
  timesGrid.querySelectorAll('.sp-time-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      timesGrid.querySelectorAll('.sp-time-btn').forEach(function(b){b.classList.remove('sel');});
      this.classList.add('sel');
      selSlot=this.getAttribute('data-slot');
      if(fSlot)fSlot.value=selSlot;
    });
  });
}

/* Variant selection */
function setPrice(pr,cmp,save){
  if(priceEl) priceEl.textContent=pr;
  if(cmp){
    if(cmpEl) cmpEl.textContent='Was Rs '+cmp;
    if(saveEl) saveEl.textContent='Save '+save+'%';
    if(cmpWrap) cmpWrap.style.display='block';
  } else {
    if(cmpWrap) cmpWrap.style.display='none';
  }
}
document.querySelectorAll('.sp-var').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.sp-var').forEach(function(b){b.classList.remove('sel');});
    this.classList.add('sel');
    if(varId) varId.value=this.getAttribute('data-vid');
    setPrice(this.getAttribute('data-price'),this.getAttribute('data-compare'),this.getAttribute('data-save'));
  });
});
var initVar=document.querySelector('.sp-var.sel');
if(initVar) setPrice(initVar.getAttribute('data-price'),initVar.getAttribute('data-compare'),initVar.getAttribute('data-save'));

/* Toast */
var toastT;
function showToast(msg,ok){
  if(!toast)return;
  toast.textContent=msg;
  toast.style.background=ok?'#0e2212':'#111';
  toast.style.borderColor=ok?'rgba(0,200,80,.3)':'rgba(255,255,255,.1)';
  toast.classList.add('show');
  clearTimeout(toastT);
  toastT=setTimeout(function(){toast.classList.remove('show');},3000);
}

/* Form submit */
if(form){
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var name=nameInp?nameInp.value.trim():'';
    var phone=phoneInp?phoneInp.value.trim():'';
    var ok=true;
    if(!name){if(nameInp){nameInp.classList.add('err');setTimeout(function(){nameInp.classList.remove('err');},500);}ok=false;}
    if(!phone){if(phoneInp){phoneInp.classList.add('err');setTimeout(function(){phoneInp.classList.remove('err');},500);}ok=false;}
    if(!ok){showToast('Please enter your name & phone number');return;}
    if(!varId||!varId.value){showToast('Please select a package');return;}
    if(fName)fName.value=name;
    if(fPhone)fPhone.value=phone;
    if(fNotes)fNotes.value=notesInp?notesInp.value.trim():'';
    bookBtn.disabled=true;
    btnTxt.textContent='Booking…';
    fetch('/cart/add.js',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        id:parseInt(varId.value,10),quantity:1,
        properties:{
          'Treatment':'{{ p.title | escape }}',
          'Spa':'{{ p.vendor | escape }}',
          'Booking Date':selDate||'',
          'Time Slot':selSlot||'',
          'Guest Name':name,
          'Phone / WhatsApp':phone,
          'Special Requests':notesInp?notesInp.value.trim():''
        }
      })
    })
    .then(function(r){return r.json();})
    .then(function(d){
      bookBtn.disabled=false;
      if(d.status||d.message){
        showToast('⚠️ '+(d.description||d.message||'Something went wrong'));
        btnTxt.textContent='Book Session →';
      } else {
        btnTxt.textContent='✓ Booked!';
        showToast('🪷 Session booked! Heading to cart…',true);
        document.dispatchEvent(new CustomEvent('qb:cart:update',{detail:{count:1}}));
        setTimeout(function(){window.location.href='/cart';},1000);
      }
    })
    .catch(function(){
      bookBtn.disabled=false;
      btnTxt.textContent='Book Session →';
      showToast('⚠️ Connection error — please try again');
    });
  });
}

/* FAQ */
document.querySelectorAll('.sp-faq-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    var item=btn.closest('.sp-faq-item');
    var wasOpen=item.classList.contains('open');
    document.querySelectorAll('.sp-faq-item').forEach(function(i){i.classList.remove('open');});
    if(!wasOpen)item.classList.add('open');
  });
});
})();
</script>

{% schema %}
{
  "name": "QB Spa Product",
  "settings": []
}
{% endschema %}
